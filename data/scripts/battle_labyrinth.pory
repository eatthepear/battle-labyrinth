		dynmultipush("Deino - Lv. 40", SPECIES_DEINO)
		dynmultipush("Pawniard - Lv. 42", SPECIES_PAWNIARD)
		dynmultipush("Bisharp - Lv. 54", SPECIES_BISHARP)
		dynmultipush("Zweilous - Lv. 54", SPECIES_ZWEILOUS)
		dynmultipush("Pikachu - Map", SPECIES_PIKACHU)
		dynmultipush("Exeggcute - Map", SPECIES_EXEGGCUTE)
		dynmultipush("Cubone - Map", SPECIES_CUBONE)
		dynmultipush("Koffing - Map", SPECIES_KOFFING)
		dynmultipush("Mime Jr. - Map", SPECIES_MIME_JR)
		dynmultipush("Dewott - Map", SPECIES_DEWOTT)
		dynmultipush("Petilil - Map", SPECIES_PETILIL)
		dynmultipush("Goomy - Map", SPECIES_GOOMY)
		dynmultipush("Back", 0)
		dynmultistack(0, 0, FALSE, 6, FALSE, 1, DYN_MULTICHOICE_CB_NONE)
		switch (var(VAR_RESULT)) {
			default:
				bufferspeciesname(0, VAR_RESULT)
				msgbox(format("{STR_VAR_1} now evolves using a level up evolution at a new level."))
			case SPECIES_EEVEE:
				msgbox(format("Eevee evolves into Espeon using a Sun Stone, Umbreon using a Moon Stone, and Sylveon using a Shiny Stone."))
			case SPECIES_GIMMIGHOUL:
				msgbox(format("Gimmighoul evolves into Gholdengo using a Dusk Stone."))
			case SPECIES_MILCERY:
				msgbox(format("Milcery evolves into Alcremie using a Shiny Stone."))
			case SPECIES_COMBEE:
				msgbox(format("Combee now evolves into Vespiquen regardless of gender and evolves at a new level."))
			case SPECIES_KIRLIA:
				msgbox(format("Kirlia now evolves into Gallade regardless of gender."))
			case SPECIES_SNORUNT:
				msgbox(format("Snorunt now evolves into Froslass regardless of gender."))
			case SPECIES_SALANDIT:
				msgbox(format("Salandit now evolves into Salazzle regardless of gender."))
			case SPECIES_RUFFLET:
				bufferspeciesname(0, VAR_RESULT)
				msgbox(format("{STR_VAR_1} now evolves using a level up evolution at a new level, and can evolve into its regional variant in Quiet Field."))
			case SPECIES_PIKACHU:
			case SPECIES_EXEGGCUTE:
			case SPECIES_CUBONE:
				bufferspeciesname(0, VAR_RESULT)
				msgbox(format("{STR_VAR_1} and can evolve into its regional variant in Breezy Meadow."))
			case SPECIES_KOFFING:
			case SPECIES_MIME_JR:
				bufferspeciesname(0, VAR_RESULT)
				msgbox(format("{STR_VAR_1} and can evolve into its regional variant in Sanctuary."))
			case SPECIES_DEWOTT:
			case SPECIES_PETILIL:
			case SPECIES_GOOMY:
				bufferspeciesname(0, VAR_RESULT)
				msgbox(format("{STR_VAR_1} and can evolve into its regional variant in Quiet Field."))
			case 0:
			case MULTI_B_PRESSED:
				return
		}
	}
}

script EventScript_Notebook_Battle {
	while {
		message(format("Battle Changes open.\nAnything not listed is vanilla."))
		waitmessage
		dynmultipush("Accuracy", 0)
		dynmultipush("Experience", 1)
		dynmultipush("Abilities", 3)
		dynmultipush("Pay Day", 7)
		dynmultipush("Back", 8)
		dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
		switch (var(VAR_RESULT)) {
			case 0:
				helpwindow(HELP_CHANGES_ACCURACY)
				msgbox(format("The next page notes all the moves that are exceptions to the accuracy changes.\pWould you like to read it?"), MSGBOX_YESNO)
				if (var(VAR_RESULT) == YES) {
					helpwindow(HELP_CHANGES_ACCURACY_EXCEPTIONS)
				}
			case 1:
				helpwindow(HELP_CHANGES_EXPERIENCE)
			case 3:
				helpwindow(HELP_CHANGES_ABILITIES)
			case 7:
				msgbox(format("Pay Day does not earn money during wild battles, except on Easy difficulty."))
			case 8:
			case MULTI_B_PRESSED:
				return
		}
	}
}

script EventScript_Notebook_Items {
	while {
		message(format("Item Changes open.\nAnything not listed is vanilla."))
		waitmessage
		dynmultipush("Endless Rare Candy", ITEM_ENDLESS_CANDY)
		dynmultipush("Infinite Repel", ITEM_INFINITE_REPEL)
		dynmultipush("Hex Orb", ITEM_HEXORB)
		dynmultipush("TMs", ITEM_TM_RETURN)
		dynmultipush("HMs", ITEM_HM_SURF)
		dynmultipush("Honey", ITEM_HONEY)
		dynmultipush("Ability Snack", ITEM_ABILITY_SNACK)
		dynmultipush("Mints", ITEM_SERIOUS_MINT)
		dynmultipush("Bike", ITEM_BICYCLE)
		dynmultipush("Item Prices", ITEM_AMULET_COIN)
		if (flag(FLAG_UNLIMITED_BOX_LINK) == FALSE) {
			dynmultipush("{PKMN} Box Link", ITEM_POKEMON_BOX_LINK)
		}
		dynmultipush("Back", 1)
		dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_ITEM)
		switch (var(VAR_RESULT)) {
			case ITEM_RARE_CANDY:
				helpwindow(HELP_ENDLESS_CANDY)
			case ITEM_INFINITE_REPEL:
				helpwindow(HELP_INFINITE_REPEL)
			case ITEM_TM_RETURN:
				msgbox(format("TMs are infinite use, but do not restore PP if you are in a new {COLOR GREEN}Zone{COLOR DARK_GRAY}."))
			case ITEM_HM_SURF:
				helpwindow(HELP_CHANGES_HIDDEN_MACHINES)
			case ITEM_HONEY:
				helpwindow(HELP_CHANGES_HONEY_SWEET_SCENT)
			case ITEM_ABILITY_SNACK:
				msgbox(format("The {COLOR GREEN}Ability Snack{COLOR DARK_GRAY} costs ¥80 and functions the same as an Ability Capsule."))
			case ITEM_SERIOUS_MINT:
				msgbox(format("Mints change natures permanently."))
			case ITEM_AMULET_COIN:
				helpwindow(HELP_CHANGES_ITEM_PRICE)
			case ITEM_HEXORB:
				msgbox(format("The {COLOR GREEN}Hexorb{COLOR DARK_GRAY} Key Item lets you pre-status Pokémon."))
			case ITEM_BICYCLE:
				helpwindow(HELP_BICYCLE)
			case ITEM_POKEMON_BOX_LINK:
				helpwindow(HELP_CHANGES_BOX_LINK)
			case 1:
			case MULTI_B_PRESSED:
				return
		}
	}
}

script EventScript_Notebook_Other {
	while {
		message(format("Other Changes open.\nAnything not listed is vanilla."))
		waitmessage
		dynmultipush("Wild Species", 0)
		dynmultipush("Trainers", 1)
		dynmultipush("DexNav", 2)
		dynmultipush("Honey Tree", 3)
		dynmultipush("Move Tutors", 6)
		dynmultipush("Back", 8)
		dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
		switch (var(VAR_RESULT)) {
			case 0:
				msgbox(format("Wild encounters each have an equal likelihood of being encountered."))
			case 1:
				msgbox(format("Many trainers have a pool of possible Pokémon they can have."))
			case 2:
				helpwindow(HELP_CHANGES_DEXNAV)
			case 3:
				helpwindow(HELP_CHANGES_HONEY_SWEET_SCENT)
			case 6:
				msgbox(format("Move Tutors can be found scattered in a few Zones.\pOnce encountered, {COLOR GREEN}Lelouch's Services Stand{COLOR DARK_GRAY} can handle teaching your Pokémon those moves."))
			case 8:
			case MULTI_B_PRESSED:
				return
		}
	}
}

script EventScript_Notebook_Tips {
	while {
		message(format("Select which tip you'd like to read."))
		setvar(VAR_TEMP_0, HELP_SIGNS_START)
		while (var(VAR_TEMP_0) <= HELP_SIGNS_END) {
			special(BufferHelpWindowName)
			dynmultipush("{STR_VAR_1}", VAR_TEMP_0)
			addvar(VAR_TEMP_0, 1)
		}
		dynmultipush("Back", 0)
		waitmessage
		dynmultistack(0, 0, FALSE, 6, FALSE, HELP_SIGNS_START, DYN_MULTICHOICE_CB_NONE)
		switch (var(VAR_RESULT)) {
			case HELP_SIGN_NOTES:
				call(EventScript_Sign_Notes)
			case HELP_SIGN_COMPLETING_A_ZONE:
				call(EventScript_Sign_CompletingAZone)
			case HELP_SIGN_RUNNING_SHOES:
				call(EventScript_Sign_RunningShoes)
			case HELP_SIGN_ZONE_INFO:
				call(EventScript_Sign_ZoneInfo)
			case HELP_CHANGES_SURVEIL:
				call(EventScript_Sign_Surveil)
			case HELP_SIGN_DOWSING_MACHINE:
				call(EventScript_Sign_DowsingMachine)
			case HELP_SIGN_LEADER:
				call(EventScript_Sign_Leader)
			case HELP_SIGN_OPTIONAL_BOSSES:
				call(EventScript_Sign_OptionalBosses)
			case HELP_SIGN_POKEMON_CHANGES:
				call(EventScript_Sign_PokemonChanges)
			case HELP_SIGN_POKEDEX_INFO:
				call(EventScript_Sign_PokedexInfo)
			case HELP_SIGN_BAG_TIPS:
				call(EventScript_Sign_BagTips)
			case HELP_SIGN_CHANGE_MUSIC:
				call(EventScript_Sign_ChangeMusic)
			case HELP_SIGN_STATS_IV_EV:
				call(EventScript_Sign_StatsIVEV)
			case HELP_SIGN_LEVEL_CAP:
				call(EventScript_Sign_LevelCap)
			case HELP_SIGN_BATTLE_CHANGES:
				call(EventScript_Sign_BattleChanges)
			case HELP_SIGN_SELECT_SWITCH:
				call(EventScript_Sign_SelectSwitch)
			case HELP_SIGN_SANCTUARY_AREAS:
				call(EventScript_Sign_SanctuaryAreas)
			case HELP_SIGN_GAUNTLET:
				call(EventScript_Sign_Gauntlet)
			case HELP_SIGN_RESTORE_HELD_ITEMS:
				call(EventScript_Sign_RestoreHeldItems)
			case HELP_SIGN_TAG_SURVEIL:
				call(EventScript_Sign_TagSurveil)
			case 0:
			case MULTI_B_PRESSED:
				setvar(VAR_TEMP_0, 0)
				return
		}
	}
}

script EventScript_Sign_Notes {
	helpwindow(HELP_SIGN_NOTES)
}

script EventScript_Sign_CompletingAZone {
	if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
		helpwindow(HELP_SIGN_COMPLETING_A_ZONE_BRUTAL)
	} else {
		helpwindow(HELP_SIGN_COMPLETING_A_ZONE)
	}
}

