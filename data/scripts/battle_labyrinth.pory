text gText_Nuzlocke_GiftPossible {
	format("On {COLOR GREEN}Nuzlocke{COLOR DARK_GRAY} mode, you will randomly receive one of the possible Pokémon. Would you like to see the list of possible Pokémon?")
}

text gText_Nuzlocke_ReadyReceive {
	format("Are you ready to receive a Pokémon?")
}

script EventScript_NuzlockeVerifyBuy {
	if (flag(FLAG_SETTINGS_NUZLOCKE) == true) {
		msgbox(format("On Nuzlocke mode, you will randomly receive one of the possible Pokémon.\pIs this ok?"), MSGBOX_YESNO)
		if (var(VAR_RESULT) == NO) {
			hidemoneybox
			release
			end
		}
	}
	return
}

script EventScript_NuzlockeVerifyGift {
	if (flag(FLAG_SETTINGS_NUZLOCKE) == true) {
		msgbox(format("On Nuzlocke mode, you will randomly receive one of the possible Pokémon.\pIs this ok?"), MSGBOX_YESNO)
		if (var(VAR_RESULT) == NO) {
			release
			end
		}
	}
	return
}

script EventScript_ChoosePartyMonToSend {
	while {
		msgbox(format("Choose a party Pokémon to send to the PC."))
		special(ChoosePartyMon)
		faceplayer
		if (var(VAR_0x8004) != PARTY_NOTHING_CHOSEN) {
			specialvar(VAR_TEMP_3, ScriptGetPartyMonSpecies)
			bufferspeciesname(2, VAR_TEMP_3)
			copyvar(VAR_TEMP_3, VAR_0x8004) // used in SendChosenMonToPC
			msgbox(format("Are you sure you want to send your {STR_VAR_3} to the PC?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				special(SendChosenMonToPC)
				return
			}
		}
	}
}

script EventScript_PorygonExit {
    lock
	faceplayer
	if (flag(FLAG_IS_REVISITING_ZONE)) {
		msgbox(format("Return to the {COLOR GREEN}Sanctuary{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
		if (var(VAR_RESULT) == NO) {
			release
			end
		}
		closemessage
		playmoncry(SPECIES_PORYGON, 0)
		waitmoncry
		warp(MAP_ZONE_SANCTUARY, 255, 48, 12)
		waitstate
		release
		end
	}
	msgbox(format("Proceed to the {COLOR GREEN}Sanctuary{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		closemessage
		playmoncry(SPECIES_PORYGON, 0)
		waitmoncry
		setvar(VAR_GENERIC, 1)
		warp(MAP_ZONE_SANCTUARY, 255, 48, 12)
		waitstate
	}
    release
    end
}

script EventScript_ShakeTree {
	lockall
	if (checkitem(ITEM_HONEY) == FALSE) {
		msgbox(format("There is a sweet scent in the air…"))
		releaseall
		end
	}
	msgbox(format("There is a sweet scent in the air…\pSlather the bark with Honey?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		releaseall
		end
	}
	removeitem(ITEM_HONEY)
	msgbox(format("{PLAYER} slathered the bark with Honey…"), MSGBOX_DEFAULT)
	closemessage
	delay(32)
	setvar(VAR_0x8004, 1)
	setvar(VAR_0x8005, 1)
	setvar(VAR_0x8006, 8)
	setvar(VAR_0x8007, 5)
	special(ShakeCamera)
	playse(SE_M_BIND)
	waitstate
	waitse
	special(HeadbuttWildEncounter)
	waitstate
	if (flag(FLAG_SETTINGS_NUZLOCKE)) {
		call(EventScript_MultipleHoneyEncountersNuzlocke)
	}
	releaseall
	end
}

script EventScript_MultipleHoneyEncountersNuzlocke {
	while {
		callnative(GotEncounterFromCurrentArea)
		if (flag(FLAG_TEMP_1)) {
			return
		}
		msgbox(format("It looks like there's still some Honey on the tree.\pWait for another Pokémon?"), MSGBOX_YESNO)
		if (var(VAR_RESULT) == NO) {
			return
		}
		closemessage
		delay(32)
		setvar(VAR_0x8004, 1)
		setvar(VAR_0x8005, 1)
		setvar(VAR_0x8006, 8)
		setvar(VAR_0x8007, 5)
		special(ShakeCamera)
		playse(SE_M_BIND)
		waitstate
		waitse
		special(HeadbuttWildEncounter)
		waitstate
	}
}

script EventScript_HandleFlashlight {
	if ((checkitem(ITEM_HM_FLASH) == TRUE) && flag(FLAG_BADGE03_GET)) {
		setflashlevel(2)
	} else {
		setflashlevel(6)
	}
	return
}

script EventScript_AccessPokemonBoxLink_PBL {
	if (flag(FLAG_IN_NEW_ZONE)) {
		if (flag(FLAG_ZONE_PC_USED)) {
			msgbox(format("The {COLOR GREEN}{PKMN} Box Link{COLOR DARK_GRAY} can't be used again until the {COLOR GREEN}Sanctuary{COLOR DARK_GRAY}."))
			releaseall
			end
		}
		msgbox(format("Use the {COLOR GREEN}{PKMN} Box Link{COLOR DARK_GRAY}? You won't have access again until the {COLOR GREEN}Sanctuary{COLOR DARK_GRAY}."), MSGBOX_YESNO)
		if (var(VAR_RESULT) == NO) {
			releaseall
			end
		}
		setflag(FLAG_ZONE_PC_USED)
	}
	return
}

script EventScript_Collector {
	lock
	release
	end
}

script EventScript_Notebook {
	playbgm(MUS_HG_FOLLOW_ME_1, FALSE)
	while {
		special(BufferCurrentLevelCap)
		message("Notebook open. Level Cap: {STR_VAR_1}\nWhat would you like to read?")
		waitmessage
		dynmultipush("Current Zone", 0)
		dynmultipush("Changes from Vanilla", 1)
		dynmultipush("Difficulty Info", 2)
		dynmultipush("Trainer Tips", 3)
		dynmultipush("Close Notebook", 4)
		dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
		switch (var(VAR_RESULT)) {
			case 0:
				call(EventScript_Notebook_ZoneInfo)
			case 1:
				call(EventScript_Notebook_ChangesFromVanilla)
			case 2:
				call(EventScript_Difficulty_Info)
			case 3:
				call(EventScript_Notebook_TrainerTips)
			case 4:
			case MULTI_B_PRESSED:
				fadedefaultbgm
				releaseall
				end
		}
	}
}

script EventScript_Notebook_ZoneInfo {
	call(EventScript_BufferCurrentZoneName)
	msgbox(format("{PLAYER} flipped to the page about {COLOR GREEN}{STR_VAR_1}{COLOR DARK_GRAY}…"))
	msgbox(gText_Notebook_ReadOn, MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		return
	}
	switch (var(VAR_ZONE)) {
		case 1:
			msgbox(format("{COLOR GREEN}Zone 1{COLOR DARK_GRAY} is a simple route through a forested area."))
		case 2:
			msgbox(format("{COLOR GREEN}Zone 2{COLOR DARK_GRAY} is a ranch with lots of open area."))
		case 3:
			msgbox(format("{COLOR GREEN}Zone 3{COLOR DARK_GRAY} is a set of small forested islands with clear water."))
		case 4:
			msgbox(format("{COLOR GREEN}Zone 4{COLOR DARK_GRAY} is a tightly nestled woodland."))
		case 5:
			msgbox(format("{COLOR GREEN}Zone 5{COLOR DARK_GRAY} is a temperate forest with a Psychic Gym."))
		case 6:
			msgbox(format("{COLOR GREEN}Zone 6{COLOR DARK_GRAY} is an island surrounded by ocean."))
		case 7:
		case 8:
			msgbox(format("{COLOR GREEN}Zone 7{COLOR DARK_GRAY} is the exterior mountainside of two large mountains, while {COLOR GREEN}Zone 8{COLOR DARK_GRAY} is the interior of those mountains."))
		case 9:
			msgbox(format("{COLOR GREEN}Zone 9{COLOR DARK_GRAY} is a dense jungle village."))
		case 10:
			msgbox(format("{COLOR GREEN}Zone 10{COLOR DARK_GRAY} is a desert valley."))
		case 11:
			msgbox(Sanctuary_Text_Colress_EndofDemo)
			return
		case 12:
		case 13:
		case 14:
		case 15:
		case 16:
		case 17:
		case 18:
		case 19:
		case 20:
		case 21:
		case 22:
		case 23:
		case 24:
		case 25:
		case 26:
		case 27:
		case 28:
		case 29:
		case 30:
		case 31:
		case 32:
		case 33:
		case 34:
		case 35:
		case 36:
		case 37:
		case 38:
		case 39:
		case 40:
		case 41:
		case 42:
		case 43:
		case 44:
		case 45:
			msgbox(format("{COLOR GREEN}Zone {COLOR DARK_GRAY} is "))
	}
	msgbox(format("The next page shows the number of opponents in {COLOR GREEN}{STR_VAR_1}{COLOR DARK_GRAY}."))
	msgbox(gText_Notebook_ReadOn, MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		return
	}
	specialvar(VAR_TEMP_0, GetNumTrainersRemaining)
	call(EventScript_OpponentsRemainingMessage)
	call(EventScript_BufferCurrentZoneName)
	msgbox(format("The next page talks about a great challenge in {COLOR GREEN}{STR_VAR_1}{COLOR DARK_GRAY}."))
	msgbox(gText_Notebook_ReadOn, MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		return
	}
	switch (var(VAR_ZONE)) {
		case 1:
			helpwindow(HELP_NOTEBOOK_BOSS_1)
		case 2:
			if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
				helpwindow(HELP_NOTEBOOK_BOSS_2_BRUTAL)
			} else {
				helpwindow(HELP_NOTEBOOK_BOSS_2)
			}
		case 3:
			if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
				helpwindow(HELP_NOTEBOOK_BOSS_3_BRUTAL)
			} else {
				helpwindow(HELP_NOTEBOOK_BOSS_3)
			}
			msgbox(gText_Notebook_OptionalReadOn, MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				helpwindow(HELP_NOTEBOOK_OPTIONAL_1)
			}
		case 4:
			if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
				helpwindow(HELP_NOTEBOOK_BOSS_4_BRUTAL)
			} else {
				helpwindow(HELP_NOTEBOOK_BOSS_4)
			}
		case 5:
			if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
				helpwindow(HELP_NOTEBOOK_BOSS_5_BRUTAL)
			} else {
				helpwindow(HELP_NOTEBOOK_BOSS_5)
			}
			msgbox(gText_Notebook_OptionalReadOn, MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				helpwindow(HELP_NOTEBOOK_OPTIONAL_2)
			}
		case 6:
			msgbox(format("There are three trainers you must defeat in a row.\pThe first uses a Finneon, a Barboach, and a Goldeen.\pThe second uses a Pyukumuku.\pThe third uses a Wiglett, a Mantyke, and a Corsola."))
			if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
				msgbox(format("On Brutal difficulty, all three fights take place in permanent rain."))
			}
		case 7:
		case 8:
			msgbox(format("The first {COLOR GREEN}Boss{COLOR DARK_GRAY} has Pokémon that take advantage of held Sitrus Berries in different ways. Their Drifloon has Acrobatics and Unburden, their Dedenne has Cheek Pouch, and their Klawf can sometimes get multiple Anger Shell boosts because it has Sitrus Berry."))
			if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
				msgbox(format("On {COLOR GREEN}Brutal{COLOR DARK_GRAY} difficulty, they also have a Appletun that maximizes the effectiveness of the Sitrus Berry with its Ripen ability."))
			}
			msgbox(format("The second {COLOR GREEN}Boss{COLOR DARK_GRAY} is a villainous team admin. They use a Stunfisk, a Beautifly, and a Purugly."))
			if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
				msgbox(format("On {COLOR GREEN}Brutal{COLOR DARK_GRAY} difficulty, they also have a Bruxish."))
			}
		case 9:
			msgbox(format("There are four trainers you must defeat in a row.\pThe first uses a Squawkabilly.\pThe second uses a Carnivine.\pThe third uses a Seel and a Wailmer.\pThe fourth uses a Morpeko."))
			msgbox(format("You can optionally battle a fifth trainer in a row to get a Rare Candy. This trainer uses a Sawk and a Throh."))
			if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
				msgbox(format("On {COLOR GREEN}Brutal{COLOR DARK_GRAY} difficulty, the fifth trainer is mandatory."))
			}
		case 10:
			msgbox(format("The {COLOR GREEN}Boss{COLOR DARK_GRAY} is a Steel Gym Leader.\pTheir Tinkatuff can set up Stealth Rock, while their Togedemaru can chip away against its foes with Iron Barbs and Rocky Helmet.\pTheir Sliggoo-Hisui is also very tanky, and their ace Steelix has great coverage moves."))
			if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
				msgbox(format("On {COLOR GREEN}Brutal{COLOR DARK_GRAY} difficulty, they also have a Prinplup, and their Steelix can Mega evolve."))
			}
		case 11:
		case 12:
		case 13:
		case 14:
		case 15:
		case 16:
		case 17:
		case 18:
		case 19:
		case 20:
		case 21:
		case 22:
		case 23:
		case 24:
		case 25:
		case 26:
		case 27:
		case 28:
		case 29:
		case 30:
		case 31:
		case 32:
		case 33:
		case 34:
		case 35:
		case 36:
		case 37:
		case 38:
		case 39:
		case 40:
		case 41:
		case 42:
		case 43:
		case 44:
		case 45:
			msgbox(format("{COLOR BLUE}{COLOR DARK_GRAY} the Boss "))
			if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
				msgbox(format("On Brutal difficulty, __ also has "))
			}
	}
}

text gText_Notebook_ReadOn {
	format("Read on?")
}

text gText_Notebook_OptionalReadOn {
	format("There is another page about an optional challenge.\pRead on?")
}

script EventScript_Notebook_ChangesFromVanilla {
	while {
		message(format("Changes from Vanilla open.\nAnything not listed is vanilla."))
		waitmessage
		dynmultipush("Pokémon", 0)
		dynmultipush("Battle", 1)
		dynmultipush("Items", 2)
		dynmultipush("Other", 3)
		dynmultipush("Back", 4)
		dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
		switch (var(VAR_RESULT)) {
			case 0:
				call(EventScript_Notebook_Pokemon)
			case 1:
				call(EventScript_Notebook_Battle)
			case 2:
				call(EventScript_Notebook_Items)
			case 3:
				call(EventScript_Notebook_Other)
			case 4:
			case MULTI_B_PRESSED:
				return
		}
	}
}

script EventScript_Notebook_Pokemon {
	while {
		message(format("Pokémon Changes open.\nAnything not listed is vanilla."))
		waitmessage
		dynmultipush("Abilities", 1)
		dynmultipush("Evolutions", 2)
		dynmultipush("Learnsets", 3)
		dynmultipush("Friendship", 4)
		dynmultipush("Back", 5)
		dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
		switch (var(VAR_RESULT)) {
			case 1:
				msgbox(format("Many Pokémon have their Hidden Ability swapped with a regular ability. All Pokémon still only have abilities that they do in vanilla."))
				msgbox(format("The next page notes Pokémon with ability changes. Would you like to read it?"), MSGBOX_YESNO)
				if (var(VAR_RESULT) == YES) {
					call(EventScript_Notebook_Abilities)
				}
			case 2:
				msgbox(format("Many Pokémon have evolution methods that are another option from their default or directly replace the default.\pThis includes Day/Night evolutions, Friendship evolutions, gender based evolutions, weak Pokémon evolutions, and hard to achieve evolutions.\pYou can see how to evolve a Pokémon in the Pokédex."))
				msgbox(format("The next page notes Pokémon with major evolution changes. Would you like to read it?"), MSGBOX_YESNO)
				if (var(VAR_RESULT) == YES) {
					call(EventScript_Notebook_Evolutions)
				}
			case 3:
				msgbox(format("All Pokémon have tailored level-up learnsets, though they still learn the same set of moves that they do in vanilla.\pYou can see what moves Pokémon learn in the Pokédex."))
			case 4:
				msgbox(format("Friendship is always considered maxed out.\pAll friendship evolutions have been changed to level up, so in practice this only affects moves like Return."))
			case 5:
			case MULTI_B_PRESSED:
				return
		}
	}
}

script EventScript_Notebook_Abilities {
	while {
		message(format("Which Pokémon's ability changes would you like to read?"))
		waitmessage
		dynmultipush("Tyranitar", SPECIES_TYRANITAR)
		dynmultipush("Wingull", SPECIES_WINGULL)
		dynmultipush("Pelipper", SPECIES_PELIPPER)
		dynmultipush("Torkoal", SPECIES_TORKOAL)
		dynmultipush("Hippopotas", SPECIES_HIPPOPOTAS)
		dynmultipush("Hippowdon", SPECIES_HIPPOWDON)
		dynmultipush("Snover", SPECIES_SNOVER)
		dynmultipush("Abomasnow", SPECIES_ABOMASNOW)
		dynmultipush("Vanillite", SPECIES_VANILLITE)
		dynmultipush("Vanillish", SPECIES_VANILLISH)
		dynmultipush("Vanilluxe", SPECIES_VANILLUXE)
		dynmultipush("Back", 0)
		dynmultistack(0, 0, FALSE, 6, FALSE, 1, DYN_MULTICHOICE_CB_NONE)
		switch (var(VAR_RESULT)) {
			case SPECIES_TYRANITAR:
				msgbox(format("Tyranitar now gets Unnerve as a regular ability instead of Sand Stream, which is now its Hidden Ability."))
			case SPECIES_WINGULL:
				msgbox(format("Wingull now gets Rain Dish as a regular ability instead of Hydration, which is now its Hidden Ability."))
			case SPECIES_PELIPPER:
				msgbox(format("Pelipper now gets Rain Dish as a regular ability instead of Drizzle, which is now its Hidden Ability."))
			case SPECIES_TORKOAL:
				msgbox(format("Torkoal now gets Shell Armor as a regular ability instead of Drought, which is now its Hidden Ability."))
			case SPECIES_HIPPOPOTAS:
			case SPECIES_HIPPOWDON:
				msgbox(format("Hippopotas and Hippowdon now get Sand Force as a regular ability instead of Sand Stream, which is now their Hidden Ability."))
			case SPECIES_SNOVER:
			case SPECIES_ABOMASNOW:
				msgbox(format("Snover and Abomasnow now get Soundproof as a regular ability instead of Snow Warning, which is now their Hidden Ability."))
			case SPECIES_VANILLITE:
			case SPECIES_VANILLISH:
				msgbox(format("Vanillite and Vanillish now get Weak Armor as a regular ability instead of Snow Cloak, which is now their Hidden Ability."))
			case SPECIES_VANILLUXE:
				msgbox(format("Vanilluxe now gets Weak Armor as a regular ability instead of Snow Warning, which is now its Hidden Ability."))
			case 0:
			case MULTI_B_PRESSED:
				return
		}
	}
}

