script EventScript_Difficulty_Info {
	while {
		setspeaker(SP_NAME_NONE)
		message(format("Which difficulty would you like to know about?"))
		waitmessage
		switch (var(VAR_DIFFICULTY)) {
			case DIFFICULTY_EASY:
				dynmultipush("{COLOR GREEN}Easy", 0)
				dynmultipush("Normal", 1)
				dynmultipush("Hard", 2)
				dynmultipush("Brutal", 3)
			case DIFFICULTY_NORMAL:
				dynmultipush("Easy", 0)
				dynmultipush("{COLOR GREEN}Normal", 1)
				dynmultipush("Hard", 2)
				dynmultipush("Brutal", 3)
			case DIFFICULTY_HARD:
				dynmultipush("Easy", 0)
				dynmultipush("Normal", 1)
				dynmultipush("{COLOR GREEN}Hard", 2)
				dynmultipush("Brutal", 3)
			case DIFFICULTY_BRUTAL:
				dynmultipush("Easy", 0)
				dynmultipush("Normal", 1)
				dynmultipush("Hard", 2)
				dynmultipush("{COLOR GREEN}Brutal", 3)
		}
		if (flag(FLAG_SETTINGS_NUZLOCKE)) {
			dynmultipush("Nuzlocke", 5)
		}
		dynmultipush("Back", 4)
		dynmultistack(0, 0, FALSE, 5, FALSE, VAR_DIFFICULTY, DYN_MULTICHOICE_CB_NONE)
		switch (var(VAR_RESULT)) {
			case 0:
				helpwindow(HELP_DIFFICULTY_EASY)
			case 1:
				helpwindow(HELP_DIFFICULTY_NORMAL)
			case 2:
				helpwindow(HELP_DIFFICULTY_HARD)
			case 3:
				helpwindow(HELP_DIFFICULTY_BRUTAL)
			case 5:
				helpwindow(HELP_NUZLOCKE)
			case 4:
			case MULTI_B_PRESSED:
				return
		}
	}
}

script EventScript_TimeCrystal {
	message(format("What time of day would you like to change to?"))
	waitmessage
	dynmultipush("Day", 0)
	dynmultipush("Night", 1)
	dynmultipush("Exit", 2)
	dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
	switch (var(VAR_RESULT)) {
		case 0:
			special(SetTimeToDay)
		case 1:
			special(SetTimeToNight)
	}
	releaseall
	end
}

script Debug_CheatStart_PBL_SelectZone {
	message(format("Which Zone would you like to start in?"))
	waitmessage
	setvar(VAR_TEMP_0, 1)
	while (var(VAR_TEMP_0) != 36) {
		call(EventScript_BufferZoneName)
		dynmultipush("{STR_VAR_1}", VAR_TEMP_0)
		addvar(VAR_TEMP_0, 1)
	}
	dynmultipush("Cancel", 0)
	dynmultistack(0, 0, FALSE, 6, FALSE, 1, DYN_MULTICHOICE_CB_NONE)
	switch (var(VAR_RESULT)) {
		case 0:
		case MULTI_B_PRESSED:
			releaseall
			end
		default:
			copyvar(VAR_ZONE, VAR_RESULT)
			copyvar(VAR_LEVEL_CAP, VAR_ZONE)
	}
}

