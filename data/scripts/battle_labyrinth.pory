script EventScript_Sign_Backtracking {
	msgbox(format("Trainer Tips\pSome Zones require backtracking in order to obtain all their items and rewards.\pYou can speak to the man in the Pokémon Center to access a past Zone for ¥1000."), MSGBOX_SIGN)
	subquestmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_SIGNS, SUB_QUEST_19)
