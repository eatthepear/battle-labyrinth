script Debug_CheatStart_PBL_GiveItems {
	additem(ITEM_QUICK_CLAW)
	additem(ITEM_TM_FALSE_SWIPE)
	additem(ITEM_ORAN_BERRY, 5)

	if (var(VAR_ZONE) == 2) {
		return
	}
	additem(ITEM_SILK_SCARF)
	additem(ITEM_TM_BUG_BITE)
	additem(ITEM_TM_HIDDEN_POWER)
