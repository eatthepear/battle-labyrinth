text gText_Nuzlocke_ReadyReceive {
	format("On {COLOR GREEN}Nuzlocke{COLOR DARK_GRAY} mode, you will randomly receive one of the possible Pokémon.\pAre you ready to receive a Pokémon?")
}

script EventScript_ChoosePartyMonToSend {
	while {
		setspeaker(SP_NAME_NONE)
		msgbox(format("Choose a party Pokémon to send to the PC."))
		special(ChoosePartyMon)
		faceplayer
		if (var(VAR_0x8004) != PARTY_NOTHING_CHOSEN) {
			specialvar(VAR_TEMP_3, ScriptGetPartyMonSpecies)
			bufferspeciesname(2, VAR_TEMP_3)
			copyvar(VAR_TEMP_3, VAR_0x8004) // used in SendChosenMonToPC
			msgbox(format("Are you sure you want to send your {STR_VAR_3} to the PC?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				special(SendChosenMonToPC)
				return
			}
		}
	}
}

script EventScript_PorygonExit {
    lock
	faceplayer
	if (flag(FLAG_IS_REVISITING_ZONE)) {
		msgbox(format("Return to the {COLOR GREEN}Sanctuary{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
		if (var(VAR_RESULT) == NO) {
			release
			end
		}
		closemessage
		playmoncry(SPECIES_PORYGON, 0)
		waitmoncry
		warp(MAP_ZONE_SANCTUARY, 255, 48, 12)
		waitstate
		release
		end
	}
	msgbox(format("Proceed to the {COLOR GREEN}Sanctuary{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		closemessage
		playmoncry(SPECIES_PORYGON, 0)
		waitmoncry
		setvar(VAR_GENERIC, 1)
		warp(MAP_ZONE_SANCTUARY, 255, 48, 12)
		waitstate
	}
    release
    end
}

script EventScript_HoneyTree {
	lockall
	if (checkitem(ITEM_HONEY) == FALSE) {
		msgbox(format("There is a sweet scent in the air…"))
		releaseall
		end
	}
	msgbox(format("There is a sweet scent in the air…\pSlather the bark with Honey?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		releaseall
		end
	}
	removeitem(ITEM_HONEY)
	msgbox(format("{PLAYER} slathered the bark with Honey…"), MSGBOX_DEFAULT)
	closemessage
	delay(32)
	setvar(VAR_0x8004, 1)
	setvar(VAR_0x8005, 1)
	setvar(VAR_0x8006, 8)
	setvar(VAR_0x8007, 5)
	special(ShakeCamera)
	playse(SE_M_BIND)
	waitstate
	waitse
	special(HoneyWildEncounter)
	waitstate
	if (flag(FLAG_SETTINGS_NUZLOCKE)) {
		call(EventScript_MultipleHoneyEncountersNuzlocke)
	}
	releaseall
	end
}

script EventScript_MultipleHoneyEncountersNuzlocke {
	while {
		specialvar(VAR_RESULT, EncounterObtainedInCurrentArea)
		if (var(VAR_RESULT) == YES) {
			return
		}
		msgbox(format("It looks like there's still some Honey on the tree.\pWait for another Pokémon?"), MSGBOX_YESNO)
		if (var(VAR_RESULT) == NO) {
			return
		}
		closemessage
		delay(32)
		setvar(VAR_0x8004, 1)
		setvar(VAR_0x8005, 1)
		setvar(VAR_0x8006, 8)
		setvar(VAR_0x8007, 5)
		special(ShakeCamera)
		playse(SE_M_BIND)
		waitstate
		waitse
		special(HoneyWildEncounter)
		waitstate
	}
}

script EventScript_AccessPokemonBoxLink_PBL {
	if (flag(FLAG_IN_NEW_ZONE) && (flag(FLAG_UNLIMITED_BOX_LINK) == FALSE)) {
		if (flag(FLAG_ZONE_PC_USED)) {
			msgbox(format("The {COLOR GREEN}{PKMN} Box Link{COLOR DARK_GRAY} can't be used again until the {COLOR GREEN}Sanctuary{COLOR DARK_GRAY}."))
			releaseall
			end
		}
		msgbox(format("Use the {COLOR GREEN}{PKMN} Box Link{COLOR DARK_GRAY}? You won't have access again until the {COLOR GREEN}Sanctuary{COLOR DARK_GRAY}."), MSGBOX_YESNO)
		if (var(VAR_RESULT) == NO) {
			releaseall
			end
		}
		setflag(FLAG_ZONE_PC_USED)
	}
	return
}

script EventScript_Notebook {
	playbgm(MUS_HG_FOLLOW_ME_1, FALSE)
	while {
		special(BufferCurrentLevelCap)
		message("Notes open. Current Level Cap: {STR_VAR_1}\nWhat would you like to read?")
		waitmessage
		dynmultipush("Zone Info", 0)
		dynmultipush("Changes from Vanilla", 1)
		dynmultipush("Difficulty Info", 2)
		dynmultipush("Tips", 3)
		dynmultipush("Exit", 4)
		dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
		switch (var(VAR_RESULT)) {
			case 0:
				call(EventScript_Notebook_ZoneInfo)
			case 1:
				call(EventScript_Notebook_ChangesFromVanilla)
			case 2:
				call(EventScript_Difficulty_Info)
				setspeaker(SP_NAME_NONE)
				msgbox(format("You can change any difficulty settings in the Options menu."))
			case 3:
				call(EventScript_Notebook_Tips)
			case 4:
			case MULTI_B_PRESSED:
				fadedefaultbgm
				releaseall
				end
		}
	}
}

script EventScript_Notebook_ZoneInfo {
	message(format("Choose which Zone you would like to read about."))
	waitmessage
	dynmultipush("Current Zone", 0)
	setvar(VAR_TEMP_0, 1)
	while (var(VAR_TEMP_0) != 35) {
		call(EventScript_BufferZoneName)
		dynmultipush("{STR_VAR_1}", VAR_TEMP_0)
		addvar(VAR_TEMP_0, 1)
	}
	dynmultipush("Cancel", 36)
	dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
	switch (var(VAR_RESULT)) {
		case 0:
			copyvar(VAR_TEMP_0, VAR_ZONE)
		case 36:
		case MULTI_B_PRESSED:
			return
		default:
			copyvar(VAR_TEMP_0, VAR_RESULT)
	}
	call(EventScript_BufferZoneName)
	msgbox(format("{PLAYER} flipped to the page about {COLOR GREEN}{STR_VAR_1}{COLOR DARK_GRAY}… Read on?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		return
	}
	switch (var(VAR_TEMP_0)) {
		case 1:
			msgbox(format("{COLOR GREEN}Zone 1{COLOR DARK_GRAY} is a simple route through a forested area."))
		case 2:
			msgbox(format("{COLOR GREEN}Zone 2{COLOR DARK_GRAY} is a ranch with lots of open area."))
		case 3:
			msgbox(format("{COLOR GREEN}Zone 3{COLOR DARK_GRAY} is a set of small forested islands with clear water."))
		case 4:
			msgbox(format("{COLOR GREEN}Zone 4{COLOR DARK_GRAY} is a tightly nestled woodland with a strange enchantment over it."))
		case 5:
			msgbox(format("{COLOR GREEN}Zone 5{COLOR DARK_GRAY} is a temperate forest with a Psychic Gym."))
		case 6:
			msgbox(format("{COLOR GREEN}Zone 6{COLOR DARK_GRAY} is an island surrounded by ocean."))
		case 7:
		case 8:
			msgbox(format("{COLOR GREEN}Zone 7{COLOR DARK_GRAY} is the exterior mountainside of two large mountains, while {COLOR GREEN}Zone 8{COLOR DARK_GRAY} is the interior of those mountains."))
		case 9:
			msgbox(format("{COLOR GREEN}Zone 9{COLOR DARK_GRAY} is a dense jungle village."))
		case 10:
			msgbox(format("{COLOR GREEN}Zone 10{COLOR DARK_GRAY} is a desert valley plagued by an endless {COLOR GREEN}Sandstorm{COLOR DARK_GRAY}."))
		case 11:
			msgbox(format("{COLOR GREEN}Zone 11{COLOR DARK_GRAY} is a forest maze filled with fog that causes {COLOR GREEN}Misty Terrain{COLOR DARK_GRAY}."))
		case 12:
			msgbox(format("{COLOR GREEN}Zone 12{COLOR DARK_GRAY} is a grassland split by a river."))
		case 13:
		case 14:
			msgbox(format("{COLOR GREEN}Zone 13{COLOR DARK_GRAY} is the exterior fields and building above {COLOR GREEN}Zone 14{COLOR DARK_GRAY}'s underground mine."))
		case 15:
			msgbox(format("{COLOR GREEN}Zone 15{COLOR DARK_GRAY} is a cave covered in ice."))
		case 16:
		case 17:
		case 18:
		case 19:
		case 20:
		case 21:
		case 22:
		case 23:
		case 24:
		case 25:
		case 26:
		case 27:
		case 28:
		case 29:
		case 30:
		case 31:
		case 32:
		case 33:
		case 34:
		case 35:
			msgbox(format("ZONE DESCRIPTION FILLER"))
	}
	msgbox(format("The next page shows the level cap in {COLOR GREEN}{STR_VAR_1}{COLOR DARK_GRAY}.\lRead on?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		return
	}
	special(BufferLevelCap)
	msgbox("{COLOR GREEN}{STR_VAR_1}{COLOR DARK_GRAY}\nLevel Cap: {COLOR GREEN}{STR_VAR_2}{COLOR DARK_GRAY}")
	msgbox(format("The next page shows the number of opponents in {COLOR GREEN}{STR_VAR_1}{COLOR DARK_GRAY}.\lRead on?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		return
	}
	specialvar(VAR_TEMP_1, GetNumTrainersRemaining)
	buffernumberstring(0, VAR_TEMP_1)
	switch(var(VAR_TEMP_1)) {
		case 0:
			msgbox(format("There are no opponents remaining in the area."))
		case 1:
			msgbox(format("There is {COLOR GREEN}1{COLOR DARK_GRAY} opponent remaining in the area."))
		default:
			msgbox(format("There are {COLOR GREEN}{STR_VAR_1}{COLOR DARK_GRAY} opponents remaining in the area."))
	}
	call(EventScript_BufferZoneName)
	msgbox(format("The next page talks about a great challenge in {COLOR GREEN}{STR_VAR_1}{COLOR DARK_GRAY}.\lRead on?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		return
	}
	switch (var(VAR_TEMP_0)) {
		case 1:
			switch (var(VAR_STARTER_MON)) {
				case 0:
					if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
						helpwindow(HELP_NOTEBOOK_BOSS_1_GRASS_STARTER_BRUTAL)
					} else {
						helpwindow(HELP_NOTEBOOK_BOSS_1_GRASS_STARTER)
					}
				case 1:
					if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
						helpwindow(HELP_NOTEBOOK_BOSS_1_FIRE_STARTER_BRUTAL)
					} else {
						helpwindow(HELP_NOTEBOOK_BOSS_1_FIRE_STARTER)
					}
				case 2:
					if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
						helpwindow(HELP_NOTEBOOK_BOSS_1_WATER_STARTER_BRUTAL)
					} else {
						helpwindow(HELP_NOTEBOOK_BOSS_1_WATER_STARTER)
					}
			}
		case 2:
			if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
				helpwindow(HELP_NOTEBOOK_BOSS_2_BRUTAL)
			} else {
				helpwindow(HELP_NOTEBOOK_BOSS_2)
			}
			msgbox(gText_Notebook_OptionalReadOn, MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				helpwindow(HELP_NOTEBOOK_OPTIONAL_2)
			}
		case 3:
			if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
