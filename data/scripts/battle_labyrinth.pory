text gText_YouDontHaveEnoughMoney {
	format("You don't have enough money.")
}

script EventScript_OpponentsRemainingMessage {
	buffernumberstring(0, VAR_TEMP_0)
	switch(var(VAR_TEMP_0)) {
		case 0:
			msgbox(format("There are no opponents remaining in the area."))
		case 1:
			msgbox(format("There is {COLOR GREEN}1{COLOR DARK_GRAY} opponent remaining in the area."))
		default:
			msgbox(format("There are {COLOR GREEN}{STR_VAR_1}{COLOR DARK_GRAY} opponents remaining in the area."))
	}
}

script EventScript_HealPreBoss {
	if (var(VAR_DIFFICULTY) != DIFFICULTY_BRUTAL) {
		if (flag(FLAG_BOSS_PROMPT_HEAL)) {
			setspeaker(SP_NAME_NONE)
			msgbox(format("Heal your party to full?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == NO) {
				closemessage
				return
			}
			msgbox(format("Your party has been healed!"), MSGBOX_AUTOCLOSE)
		}
		special(HealPlayerParty)
	}
}

// Legacy
script EventScript_BrutalExitNotSatisfied {
	releaseall
}

script EventScript_Max {
	lock
	faceplayer
	playbgm(MUS_DP_POKE_MART, FALSE)
	call(EventScript_Shop_Max)
	fadedefaultbgm
	release
}

script EventScript_Shop_Max {
	setspeaker("Max")
	message(format("Hi {PLAYER}! Long time no see!\pWelcome to my TM shop!"))
	waitmessage
	switch(var(VAR_ZONE)) {
		case 2:
			pokemart(Zone2A_Shop_TMShop)
		case 6:
			pokemart(Zone6A_Shop_TMShop)
		case 10:
			pokemart(Zone10A_Shop_TMShop)
		case 13:
			pokemart(Zone13A_Shop_TMShop)
		case 18:
			pokemart(Zone18A_Shop_TMShop)
		case 22:
			pokemart(Zone22A_Shop_TMShop)
		case 24:
			pokemart(Zone24A_Shop_TMShop)
		case 29:
			pokemart(Zone29A_Shop_TMShop)
		case 35:
			pokemart(Sanctuary_Shop_TMShop)
	}
	setspeaker("Max")
	msgbox(format("Goodbye!"), MSGBOX_AUTOCLOSE)
}

mart Zone2A_Shop_TMShop {
	ITEM_TM_HIDDEN_POWER
}

mart Zone6A_Shop_TMShop {
