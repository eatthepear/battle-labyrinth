script Debug_CheatStart_PBL_GiveMonsMonotype {
	message(format("Give mons for monotype?"))
	waitmessage
	dynmultipush("Cancel", 0)
	dynmultipush("Water", 1)
	dynmultistack(0, 0, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
	switch (var(VAR_RESULT)) {
		case 1:
			givemon(SPECIES_SQUIRTLE, 5)
			givemon(SPECIES_PSYDUCK, 5)
			givemon(SPECIES_POLIWAG, 5)
			givemon(SPECIES_TENTACOOL, 5)
