script EventScript_GameIntro_SetStartingVariablesAndFlags {
	setflag(FLAG_SYS_B_DASH)
	setflag(FLAG_SYS_POKEMON_GET)
	setflag(FLAG_SYS_PC_LANETTE)
	setflag(FLAG_AUTORUN_TOGGLE)
	setvar(VAR_FARM_STOCK, 10)
	setflag(FLAG_SYS_POKEDEX_GET)
	setflag(FLAG_SYS_EXP_SHARE)
	special(SetUnlockedPokedexFlags)
	setflag(FLAG_SYS_NATIONAL_DEX)
	special(EnableNationalPokedex)
	initclock(10, 0)
	callnative(InitTimeBasedEvents)
	setrespawn(HEAL_LOCATION_PBL)
	setflag(FLAG_SYS_DEXNAV_GET)
}

text gText_YouDontHaveEnoughMoney {
	format("You don't have enough money.")
}

script EventScript_HealPreBoss {
	if (var(VAR_DIFFICULTY) != DIFFICULTY_BRUTAL) {
		if (flag(FLAG_BOSS_PROMPT_HEAL)) {
			setspeaker(SP_NAME_NONE)
			msgbox(format("Heal your party to full?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == NO) {
				closemessage
				return
			}
			msgbox(format("Your party has been healed!"))
			closemessage
		}
		special(HealPlayerParty)
	}
}

script EventScript_PuzzleHint {
	specialvar(VAR_TEMP_1, CheckWhichPuzzle)
	if (var(VAR_TEMP_1) == PBL_PUZZLE_COUNT) {
		return
	}
	switch (var(VAR_TEMP_1)) {
		case PBL_PUZZLE_ZONE_4:
			msgbox(format("Get a hint for Zone 4?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("The hint is: U, L, U, L, U"))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_5_GYM:
			msgbox(format("Get a hint for Zone 5 Gym?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("The hint is: make sure your path to the next rooms are unblocked first, then move the statues to unblock yourself from where you are."))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_10_FIND_ITEMS:
			msgbox(format("Get a hint for Zone 10 finding shards?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("The hint is: all five shards are in corners of the map.\pUse the Dowsing Machine to help!"))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_15:
			msgbox(format("Get a hint for Zone 15?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("The hint is: a Plusle is in the top right ice puzzle, and the other two are in the bottom right big ice puzzle.\pAnother hint is: even though an ice puzzle might seem really complicated, it might be actually not many choices in the end. Sometimes when you slide, you will only have one direction to go (other than the direction you came from)."))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_17:
			msgbox(format("Get a hint for Zone 17?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("The hint is: the stone at the top of the mountain suggests celebrating days of births and deaths.\pSo for the current year, there's a particular order of these dates."))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_22:
			msgbox(format("Get a hint for Zone 22?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("The hint is: you need to push the Kimono Girl from the right side.\pYou can look at the puzzle and work your way backwards!"))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_25:
			msgbox(format("Get a hint for Zone 25?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("The hint is: to skip over the broken ground, you need to use the bike and turn quickly.\pRegister the bike for faster tries!"))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_30:
			msgbox(format("Get a hint for Zone 30?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("The hint is: the overall route through Rainbow Rocket Co. is linear, with some side paths.\pYou will deal with Team Magma first, then Team Aqua, then Team Galactic, then finally Team Rainbow Rocket."))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_34B:
			msgbox(format("Get a hint for Zone 34?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("The hint is: R Y B Y R"))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_34C:
			msgbox(format("Get a hint for Zone 34?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("The hint is: O Y R B O B R"))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_34F:
		case PBL_PUZZLE_ZONE_34G:
			msgbox(format("Get a hint for Zone 34?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("The hint is: 1st room go left first, then up. 2nd room go right first, then up."))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_34J:
		case PBL_PUZZLE_ZONE_34K:
			msgbox(format("Get a hint for Zone 34?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("The hint is: TODO"))
			} else {
				closemessage
				return
			}
	}
	release
	end
}

script EventScript_PuzzleSkip {
	specialvar(VAR_TEMP_1, CheckWhichPuzzle)
	if (var(VAR_TEMP_1) == PBL_PUZZLE_COUNT) {
		return
	}
	switch (var(VAR_TEMP_1)) {
		case PBL_PUZZLE_ZONE_4:
			msgbox(format("Skip the puzzle in Zone 4?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("TODO SKIP"))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_5_GYM:
			msgbox(format("Skip the puzzle in Zone 5 Gym?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("After some looking around, {PLAYER} found a super secret and mysterious hallway!"))
				warp(MAP_ZONE5B, 11)
				waitstate
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_10_FIND_ITEMS:
			msgbox(format("Skip finding the shards in Zone 10?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				fadescreenswapbuffers(FADE_TO_BLACK)
				if (flag(FLAG_HIDDEN_ITEM_ZONE10A_BLUE_SHARD_1) == FALSE) {
					additem(ITEM_BLUE_SHARD)
					setflag(FLAG_HIDDEN_ITEM_ZONE10A_BLUE_SHARD_1)
				}
				if (flag(FLAG_HIDDEN_ITEM_ZONE10A_BLUE_SHARD_2) == FALSE) {
					additem(ITEM_BLUE_SHARD)
					setflag(FLAG_HIDDEN_ITEM_ZONE10A_BLUE_SHARD_2)
				}
				if (flag(FLAG_HIDDEN_ITEM_ZONE10A_BLUE_SHARD_3) == FALSE) {
					additem(ITEM_BLUE_SHARD)
					setflag(FLAG_HIDDEN_ITEM_ZONE10A_BLUE_SHARD_3)
				}
				if (flag(FLAG_HIDDEN_ITEM_ZONE10A_BLUE_SHARD_4) == FALSE) {
					additem(ITEM_BLUE_SHARD)
					setflag(FLAG_HIDDEN_ITEM_ZONE10A_BLUE_SHARD_4)
				}
				if (flag(FLAG_HIDDEN_ITEM_ZONE10A_BLUE_SHARD_5) == FALSE) {
					additem(ITEM_BLUE_SHARD)
					setflag(FLAG_HIDDEN_ITEM_ZONE10A_BLUE_SHARD_5)
				}
				fadescreenswapbuffers(FADE_FROM_BLACK)
				msgbox(format("After searching for a while, {PLAYER} found all the shards!"))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_15:
			msgbox(format("Get a hint for Zone 15?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("TODO SKIP"))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_17:
			msgbox(format("Skip the puzzle in Zone 17?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				setvar(VAR_ZONE_17_STATE, 21)
				msgbox(format("{PLAYER} paid respects to all the graves."))
				call(Zone17A_EventScript_SolvedPuzzle)
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_22:
			msgbox(format("Get a hint for Zone 22?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("TODO SKIP"))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_25:
			msgbox(format("Get a hint for Zone 25?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("TODO SKIP"))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_30:
			msgbox(format("Get a hint for Zone 30?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("TODO SKIP"))
			} else {
				closemessage
				return
			}
		case PBL_PUZZLE_ZONE_34B:
			msgbox(format("Skip this room's puzzle?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				fadescreenswapbuffers(FADE_TO_BLACK)
				setvar(VAR_TEMP_5, 0)
				delay(10)
				fadescreenswapbuffers(FADE_FROM_BLACK)
				setmetatile(13, 6, METATILE_RocketCastle_Warp, 0)
				playse(SE_EXP_MAX)
				special(DrawWholeMapView)
				waitse
				msgbox(format("After some trial and error, {PLAYER} figured out the puzzle!"))
				setflag(FLAG_ZONE34B_PUZZLE_COMPLETED)
			}
		case PBL_PUZZLE_ZONE_34C:
			msgbox(format("Skip this room's puzzle?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				fadescreenswapbuffers(FADE_TO_BLACK)
				setvar(VAR_TEMP_5, 0)
				delay(10)
				fadescreenswapbuffers(FADE_FROM_BLACK)
				setmetatile(13, 6, METATILE_RocketCastle_Warp, 0)
				playse(SE_EXP_MAX)
				special(DrawWholeMapView)
				waitse
				msgbox(format("After some trial and error, {PLAYER} figured out the puzzle!"))
				setflag(FLAG_ZONE34C_PUZZLE_COMPLETED)
			}
		case PBL_PUZZLE_ZONE_34F:
		case PBL_PUZZLE_ZONE_34G:
		case PBL_PUZZLE_ZONE_34J:
		case PBL_PUZZLE_ZONE_34K:
			msgbox(format("Get a hint for Zone 34?"), MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				msgbox(format("TODO SKIP"))
			} else {
				closemessage
				return
			}
	}
	release
	end
}

script EventScript_Max {
	lock
	faceplayer
	if (var(VAR_ZONE) != 35) {
		playbgm(MUS_DP_POKE_MART, FALSE)
	}
	call(EventScript_Shop_Max)
	fadedefaultbgm
	release
}

script EventScript_Shop_Max {
	setspeaker("Max")
	message(format("Hi {PLAYER}! Long time no see!\pWelcome to my TM shop!"))
	waitmessage
	switch(var(VAR_ZONE)) {
		case 2:
			if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
				pokemart(Zone2A_Shop_TMShop_Brutal)
			} else {
				pokemart(Zone2A_Shop_TMShop)
			}
		case 6:
			pokemart(Zone6A_Shop_TMShop)
		case 10:
			pokemart(Zone10A_Shop_TMShop)
		case 13:
			pokemart(Zone13A_Shop_TMShop)
		case 15:
			pokemart(Zone15A_Shop_TMShop)
		case 18:
			pokemart(Zone18A_Shop_TMShop)
		case 22:
			pokemart(Zone22A_Shop_TMShop)
		case 24:
			pokemart(Zone24A_Shop_TMShop)
		case 29:
			pokemart(Zone29A_Shop_TMShop)
		case 31:
			pokemart(Zone31A_Shop_TMShop)
		case 33:
			pokemart(Zone33_Shop_TMShop)
		case 35:
			if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
				pokemart(Sanctuary_Shop_TMShop_Brutal)
			} else {
				pokemart(Sanctuary_Shop_TMShop)
			}
	}
	setspeaker("Max")
	msgbox(format("Goodbye!"))
	closemessage
}

mart Zone2A_Shop_TMShop_Brutal {
	ITEM_TM_HIDDEN_POWER
}

