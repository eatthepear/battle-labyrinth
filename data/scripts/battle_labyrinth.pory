script Debug_CheatStart_PBL_GiveMons {
	msgbox(format("Give random encounters?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		call(Debug_CheatStart_PBL_GiveMonsMonotype)
		return
	}
	// FLAG_TEMP_1 = TRUE means secondary encounter, FLAG_TEMP_2 + TRUE means Night encounter

	random(5)
	if (var(VAR_RESULT) == 1) {
		setflag(FLAG_TEMP_1)
	} else {
		random(2)
		if (var(VAR_RESULT) == 1) {
			setflag(FLAG_TEMP_2)
		}
	}
	setvar(VAR_TEMP_0, 0) // wild define gWildMonHeaders in src/data/wild_encounters.h
	setvar(VAR_TEMP_1, 3) // level
	callnative(DebugCheatStartGenerateMon)
	givemon(VAR_TEMP_0, VAR_TEMP_1, ITEM_NONE)
	random(5)
	if (var(VAR_RESULT) == 1) {
		setflag(FLAG_TEMP_1)
	} else {
		random(2)
		if (var(VAR_RESULT) == 1) {
			setflag(FLAG_TEMP_2)
		}
	}
	setvar(VAR_TEMP_0, 1) // wild define gWildMonHeaders in src/data/wild_encounters.h
	setvar(VAR_TEMP_1, 4) // level
	callnative(DebugCheatStartGenerateMon)
	givemon(VAR_TEMP_0, VAR_TEMP_1, ITEM_NONE)
	random(5)
	if (var(VAR_RESULT) == 1) {
		setflag(FLAG_TEMP_1)
	} else {
		random(2)
		if (var(VAR_RESULT) == 1) {
			setflag(FLAG_TEMP_2)
		}
	}
	setvar(VAR_TEMP_0, 2) // wild define gWildMonHeaders in src/data/wild_encounters.h
	setvar(VAR_TEMP_1, 3) // level
	callnative(DebugCheatStartGenerateMon)
	givemon(VAR_TEMP_0, VAR_TEMP_1, ITEM_NONE)
	random(5)
	if (var(VAR_RESULT) == 1) {
		setflag(FLAG_TEMP_1)
	} else {
		random(2)
		if (var(VAR_RESULT) == 1) {
			setflag(FLAG_TEMP_2)
		}
	}
	setvar(VAR_TEMP_0, 3) // wild define gWildMonHeaders in src/data/wild_encounters.h
	setvar(VAR_TEMP_1, 3) // level
	callnative(DebugCheatStartGenerateMon)
	givemon(VAR_TEMP_0, VAR_TEMP_1, ITEM_NONE)

	if (var(VAR_ZONE) == 1) {
		return
	}
	random(5)
	if (var(VAR_RESULT) == 1) {
		setflag(FLAG_TEMP_1)
	} else {
		random(2)
		if (var(VAR_RESULT) == 1) {
			setflag(FLAG_TEMP_2)
		}
	}
	setvar(VAR_TEMP_0, 4) // wild define gWildMonHeaders in src/data/wild_encounters.h
	setvar(VAR_TEMP_1, 4) // level
	callnative(DebugCheatStartGenerateMon)
	givemon(VAR_TEMP_0, VAR_TEMP_1, ITEM_NONE)
	random(15)
	switch (var(VAR_RESULT)) {
		case 0:
			givemon(SPECIES_PANSAGE, 5, metLocation=METLOC_GIVE_FWG)
		case 1:
			givemon(SPECIES_GOSSIFLEUR, 5, metLocation=METLOC_GIVE_FWG)
		case 2:
			givemon(SPECIES_SUNKERN, 5, metLocation=METLOC_GIVE_FWG)
		case 3:
			givemon(SPECIES_CHERUBI, 5, metLocation=METLOC_GIVE_FWG)
		case 4:
			givemon(SPECIES_FOMANTIS, 5, metLocation=METLOC_GIVE_FWG)
		case 5:
			givemon(SPECIES_PANSEAR, 5, metLocation=METLOC_GIVE_FWG)
		case 6:
			givemon(SPECIES_VULPIX, 5, metLocation=METLOC_GIVE_FWG)
		case 7:
			givemon(SPECIES_SLUGMA, 5, metLocation=METLOC_GIVE_FWG)
		case 8:
			givemon(SPECIES_SIZZLIPEDE, 5, metLocation=METLOC_GIVE_FWG)
		case 9:
			givemon(SPECIES_PONYTA, 5, metLocation=METLOC_GIVE_FWG)
		case 10:
			givemon(SPECIES_PANPOUR, 5, metLocation=METLOC_GIVE_FWG)
		case 11:
			givemon(SPECIES_PSYDUCK, 5, metLocation=METLOC_GIVE_FWG)
		case 12:
			givemon(SPECIES_GOLDEEN, 5, metLocation=METLOC_GIVE_FWG)
		case 13:
