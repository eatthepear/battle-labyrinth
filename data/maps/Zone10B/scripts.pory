mapscripts Zone10B_MapScripts {}

script Zone10B_EventScript_RuinManiac {
	lock
	faceplayer
	if (flag(FLAG_ZONE10B_FOSSIL_RECEIVED) == FALSE) {
		msgbox("You get a Fossil!\nYou get a Fossil!\lEverybody gets a Fossil!")
		setflag(FLAG_ZONE10B_FOSSIL_RECEIVED)
		if (flag(FLAG_SETTINGS_NUZLOCKE)) {
			random(11)
			switch (var(VAR_RESULT)) {
				case 0:
					giveitem(ITEM_DOME_FOSSIL)
				case 1:
					giveitem(ITEM_HELIX_FOSSIL)
				case 2:
					giveitem(ITEM_OLD_AMBER)
				case 3:
					giveitem(ITEM_ROOT_FOSSIL)
				case 4:
					giveitem(ITEM_CLAW_FOSSIL)
				case 5:
					giveitem(ITEM_SKULL_FOSSIL)
				case 6:
					giveitem(ITEM_ARMOR_FOSSIL)
				case 7:
					giveitem(ITEM_COVER_FOSSIL)
				case 8:
					giveitem(ITEM_PLUME_FOSSIL)
				case 9:
					giveitem(ITEM_JAW_FOSSIL)
				case 10:
					giveitem(ITEM_SAIL_FOSSIL)
			}
		} else {
			message(format("Which Fossil do you want?"))
			waitmessage
			dynmultipush("Dome Fossil", ITEM_DOME_FOSSIL)
			dynmultipush("Helix Fossil", ITEM_HELIX_FOSSIL)
			dynmultipush("Root Fossil", ITEM_ROOT_FOSSIL)
			dynmultipush("Claw Fossil", ITEM_CLAW_FOSSIL)
			dynmultipush("Skull Fossil", ITEM_SKULL_FOSSIL)
			dynmultipush("Armor Fossil", ITEM_ARMOR_FOSSIL)
			dynmultipush("Cover Fossil", ITEM_COVER_FOSSIL)
			dynmultipush("Plume Fossil", ITEM_PLUME_FOSSIL)
			dynmultipush("Jaw Fossil", ITEM_JAW_FOSSIL)
			dynmultipush("Sail Fossil", ITEM_SAIL_FOSSIL)
			dynmultipush("Old Amber", ITEM_OLD_AMBER)
			dynmultistack(0, 0, TRUE, 6, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_ITEM)
			giveitem(VAR_RESULT)
		}
	}
	msgbox(format("Hope you enjoy your Fossil!"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_RUIN_MANIAC_10B, Common_Movement_FaceLeft)
	waitmovement(0)
	release
	end
}

script Zone10B_EventScript_WaterMerchant {
	lock
	faceplayer
	if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
		msgbox(format("In the desert, it's supply and demand. And the demand is water.\pThe Fresh Water I usually sell is in such high demand that I am out of stock."))
		release
		end
	}
	showmoneybox(0, 0)
	message(format("In the desert, it's supply and demand. And the demand is water.\p¥200 for Fresh Water.\nRestores 30 HP each."))
	waitmessage
	dynmultipush("1x Fresh Water - ¥200", 0)
	dynmultipush("10x Fresh Water - ¥2000", 1)
	dynmultipush("Exit", 2)
	dynmultichoice(0, 12, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE)
	switch(var(VAR_RESULT)) {
	case 0:
		checkmoney(200)
		if (var(VAR_RESULT) == FALSE) {
			goto(Zone10B_EventScript_WaterNotEnough)
		} else {
			removemoney(200)
			updatemoneybox
			msgbox("Here you go.")
			giveitem(ITEM_FRESH_WATER, 1)
			hidemoneybox
			release
			end
		}
	case 1:
		checkmoney(2000)
		if (var(VAR_RESULT) == FALSE) {
			goto(Zone10B_EventScript_WaterNotEnough)
		} else {
			removemoney(2000)
			updatemoneybox
			msgbox("Here you go.")
			giveitem(ITEM_FRESH_WATER, 10)
			hidemoneybox
			release
			end
		}
	}
	closemessage
	hidemoneybox
	msgbox("Ah, fine.")
	release
}

script Zone10B_EventScript_WaterNotEnough {
	msgbox(gText_YouDontHaveEnoughMoney)
	hidemoneybox
	release
	end
}

script Zone10B_EventScript_BirdKeeper {
	lock
	faceplayer
	if (checkitem(ITEM_TM_ROOST) == FALSE) {
		msgbox(format("Bird Pokémon sometimes need to rest! This TM will help remedy that!"))
		giveitem(ITEM_TM_ROOST)
	}
	msgbox(format("The move {COLOR GREEN}Roost{COLOR DARK_GRAY} can help a Pokémon heal up, but it also causes it to lose its Flying-typing if it has one, until the end of the turn."))
	release
	end
}
