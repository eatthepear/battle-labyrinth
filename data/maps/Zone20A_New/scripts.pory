script Zone20A_EventScript_ShinyStone {
	lock
	if (flag(FLAG_ITEM_ZONE20A_SHINY_STONE)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE20A_SHINY_STONE)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_SHINY_STONE)
	release
	end
}

script Zone20A_EventScript_ExpertBelt {
	lock
	if (flag(FLAG_ITEM_ZONE20A_EXPERT_BELT)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE20A_EXPERT_BELT)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_EXPERT_BELT)
	release
	end
}
