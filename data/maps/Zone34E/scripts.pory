mapscripts Zone34E_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		if (defeated(TRAINER_PBL_MAXIE_BOSS_34)) {
			setmetatile(9, 3, METATILE_RocketCastle_Warp, 0)
		}
    }
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_ZONE_34_STATE_MAXIE, 1: Zone34E_EventScript_MaxieBattle
	]
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_1, 0 {
            setvar(VAR_TEMP_1, 1)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
        }
    ]
}

script Zone34E_EventScript_MaxieBattle {
    lockall
    applymovement(LOCALID_PLAYER, Common_Movement_WalkUp3)
    setspeaker("???")
    msgbox(format("Hmm"))
    applymovement(LOCALID_MAXIE, Common_Movement_FaceDown)
    waitmovement(0)
    setspeaker("???")
    msgbox(format("MAXIE!"))
    closemessage
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_MAXIE_BOSS_34, format("DEFEAT!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
    setspeaker("Maxie")
    msgbox(format("DEFEAT!"))
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, Zone34E_Camera_MoveRightUp)
    waitmovement(0)
    setmetatile(9, 3, METATILE_RocketCastle_Warp, 0)
    playse(SE_EXP_MAX)
    special(DrawWholeMapView)
    waitse
    delay(10)
    applymovement(LOCALID_CAMERA, Zone34E_Camera_MoveLeftDown)
    waitmovement(0)
    special(RemoveCameraObject)
    setvar(VAR_ZONE_34_STATE_MAXIE, 2)
    releaseall
}

movement Zone34E_Camera_MoveRightUp {
    walk_diag_northeast * 2
}

movement Zone34E_Camera_MoveLeftDown {
    walk_diag_southwest * 2
}
