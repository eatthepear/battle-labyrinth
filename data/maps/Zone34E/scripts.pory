mapscripts Zone34E_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_ZONE_34_STATE_MAXIE, 0: Zone34E_EventScript_MaxieBattle
	]
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_1, 0 {
            setvar(VAR_TEMP_1, 1)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
        }
    ]
}

script Zone34E_EventScript_MaxieBattle {
    lockall
    applymovement(LOCALID_PLAYER, Common_Movement_WalkUp3)
    setspeaker("???")
    msgbox(format("Hmm"))
    applymovement(LOCALID_MAXIE, Common_Movement_FaceDown)
    waitmovement(0)
    setspeaker("???")
    msgbox(format("MAXIE!"))
    closemessage
    applymovement(LOCALID_MAXIE, Common_Movement_WalkDown)
    waitmovement(0)
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_MAXIE_BOSS_34, format("DEFEAT!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
    setvar(VAR_ZONE_34_STATE_MAXIE, 1)
    releaseall
}
