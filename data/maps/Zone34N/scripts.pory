mapscripts Zone34N_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_1, 0 {
            setvar(VAR_TEMP_1, 1)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
        }
    ]
}

script Zone34N_EventScript_Door {
    lockall
    msgbox(format("You feel a foreboding evil beyond this door.\pGo through the door?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        releaseall
        end
    }
    closemessage
    warp(MAP_ZONE34O, 0)
    waitstate
    releaseall
    end
}
