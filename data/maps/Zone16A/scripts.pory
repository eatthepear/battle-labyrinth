mapscripts Zone16A_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE16A_TM_FLY)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE16A_RANDOM_1)) {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE16A_RANDOM_2)) {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE16A_RANDOM_3)) {
			setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ITEM_CHEST)
		}
	}
}

script Zone16A_EventScript_TriggerJupiter {
	lockall
	fadeoutbgm(1)
	getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
	if (var(VAR_TEMP_0) == 67) {
		applymovement(LOCALID_PLAYER, Common_Movement_WalkRight)
		waitmovement(0)
		applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
		waitmovement(0)
	}
	applymovement(LOCALID_JUPITER_16A, Common_Movement_WalkDown2)
	waitmovement(0)
	setspeaker("Jupiter")
	msgbox(format("BATTLE!"), MSGBOX_DEFAULT)
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_JUPITER_BOSS_16, format("DEFEAT!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Jupiter")
	msgbox(format("Well then. I suppose you'll be wanting your reward.\pHere you go."), MSGBOX_DEFAULT)
	// giveitem(ITEM_TM28)
	setspeaker("Jupiter")
	msgbox(format("RUN!"), MSGBOX_AUTOCLOSE)
	fadescreenswapbuffers(FADE_TO_BLACK)
	removeobject(LOCALID_GRUNT_1_16A)
	removeobject(LOCALID_GRUNT_2_16A)
	removeobject(LOCALID_JUPITER_16A)
	setflag(FLAG_BEAT_BOSS_16)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	clearflag(FLAG_HIDE_ZONE16A_KIMONO_GIRL)
	addobject(LOCALID_KIMONO_GIRL_16A)
	playbgm(MUS_HG_KIMONO_GIRL, 0)
	applymovement(LOCALID_KIMONO_GIRL_16A, Common_Movement_WalkUp2)
	waitmovement(0)
	applymovement(LOCALID_KIMONO_GIRL_16A, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
	waitmovement(0)
	applymovement(LOCALID_KIMONO_GIRL_16A, Common_Movement_WalkUp3)
	waitmovement(0)
	setspeaker("Kimono Girl")
	msgbox(format("HELLO! I SAW UR BATTLE, U BATTLE GOOD. TAKE THIS ITEM!"), MSGBOX_AUTOCLOSE)
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_BOTTLE_CAP)
	setspeaker("Kimono Girl")
	msgbox(format("SEE YA!"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_KIMONO_GIRL_16A, Common_Movement_WalkDown5)
	waitmovement(0)
	removeobject(LOCALID_KIMONO_GIRL_16A)
	setflag(FLAG_HIDE_ZONE6A_KIMONO_GIRL)
	setvar(VAR_ZONE_16_STATE, 1)
	release
	end
}

script Zone16A_EventScript_SandPile {
	lockall
	random(5)
	if (var(VAR_RESULT) == 0) {
		applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
		msgbox(format("There was a Pokémon in the sand pile!"), MSGBOX_DEFAULT)
		waitmovement(0)
		closemessage
		random(4)
		switch (var(VAR_RESULT)) {
			case 0:
				setwildbattle(SPECIES_PINCURCHIN, 28, ITEM_NONE)
				playmoncry(SPECIES_PINCURCHIN, 2)
				delay(40)
				waitmoncry
			case 1:
				setwildbattle(SPECIES_PYUKUMUKU, 28, ITEM_NONE)
				playmoncry(SPECIES_PYUKUMUKU, 2)
				delay(40)
				waitmoncry
			case 2:
				setwildbattle(SPECIES_SANDYGAST, 28, ITEM_NONE)
				playmoncry(SPECIES_SANDYGAST, 2)
				delay(40)
				waitmoncry
			case 3:
				setwildbattle(SPECIES_WIMPOD, 28, ITEM_NONE)
				playmoncry(SPECIES_WIMPOD, 2)
				delay(40)
				waitmoncry
		}
		dowildbattle
	} else {
		msgbox("It's a pile of sand.")
	}
	releaseall
	end
}

script Zone16A_EventScript_TMFly {
	lock
	if (flag(FLAG_ITEM_ZONE16A_TM_FLY)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE16A_TM_FLY)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_TM_FLY, 1)
	release
	end
}

script Zone16A_EventScript_Random1 {
	lock
	if (flag(FLAG_ITEM_ZONE16A_RANDOM_1)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE16A_RANDOM_1)
	addobject(VAR_LAST_TALKED)
	specialvar(VAR_TEMP_1, RandomItemChest)
	finditem(VAR_TEMP_1, VAR_TEMP_0)
	release
	end
}

