script Zone16A_EventScript_Iona {
	trainerbattle_single(TRAINER_PBL_IONA, format("The Water Pokémon are tickling my toes!"), format("Oh, that was just seaweed."))
	msgbox(format("Don't you love that there is such a diversity of Water Pokémon?"), MSGBOX_AUTOCLOSE)
	end
}

script Zone16A_EventScript_Berke {
	trainerbattle_single(TRAINER_PBL_BERKE, format("Just keep swimming, just keep swimming!"), format("It's a good motto, right?"))
	msgbox(format("Finding Nemo? Who's Nemo?"), MSGBOX_AUTOCLOSE)
	end
}

script Zone16A_EventScript_Tanisha {
