raw `
Zone16A_EventScript_Sign::
	msgbox Zone16A_Text_Sign, MSGBOX_SIGN
	end

Zone16A_Text_Sign:
	.string "Sand piles may contain Pokémon.\p"
	.string "Be cautious!\n"
	.string "They don't like being disturbed!$"
`
