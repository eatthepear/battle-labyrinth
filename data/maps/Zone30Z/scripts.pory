mapscripts Zone30Z_MapScripts {}

script Zone30Z_EventScript_Attendant {
	lock
	faceplayer
	setvar(VAR_0x8004, 0)
	if (!flag(FLAG_TEMP_2)) {
		special(SetDeptStoreFloor)
	}
	setvar(VAR_0x8004, 0)
	message(format("Welcome to {COLOR GREEN}Rainbow Rocket Co.{COLOR DARK_GRAY}\pWhich floor would you like?"))
	waitmessage
	dynmultipush("8F - RR", 8)
	dynmultipush("7F - Galactic", 7)
	dynmultipush("6F - Galactic", 6)
	dynmultipush("5F - Magma", 5)
	dynmultipush("4F - Magma", 4)
	dynmultipush("3F - Aqua", 3)
	dynmultipush("2F - Aqua", 2)
	dynmultipush("1F - Lobby", 1)
	dynmultipush("Exit", 0)
	dynmultistack(0, 0, FALSE, 6, FALSE, VAR_ZONE_30_FLOOR, DYN_MULTICHOICE_CB_NONE)
	switch(var(VAR_RESULT)) {
		case 1:
			setvar(VAR_0x8006, ZONE30_FLOORNUM_1F)
			setdynamicwarp(MAP_ZONE30A, 0)
			if (var(VAR_ZONE_30_FLOOR) != ZONE30_FLOORNUM_1F) {
				call(Zone30Z_EventScript_MoveElevator)
				setvar(VAR_ZONE_30_FLOOR, ZONE30_FLOORNUM_1F)
			}
		case 2:
			setvar(VAR_0x8006, ZONE30_FLOORNUM_2F)
			setdynamicwarp(MAP_ZONE30B, 0)
			if (var(VAR_ZONE_30_FLOOR) != ZONE30_FLOORNUM_2F) {
				call(Zone30Z_EventScript_MoveElevator)
				setvar(VAR_ZONE_30_FLOOR, ZONE30_FLOORNUM_2F)
			}
		case 3:
			setvar(VAR_0x8006, ZONE30_FLOORNUM_3F)
			setdynamicwarp(MAP_ZONE30C, 0)
			if (var(VAR_ZONE_30_FLOOR) != ZONE30_FLOORNUM_3F) {
				call(Zone30Z_EventScript_MoveElevator)
				setvar(VAR_ZONE_30_FLOOR, ZONE30_FLOORNUM_3F)
			}
		case 4:
			setvar(VAR_0x8006, ZONE30_FLOORNUM_4F)
			setdynamicwarp(MAP_ZONE30D, 0)
			if (var(VAR_ZONE_30_FLOOR) != ZONE30_FLOORNUM_4F) {
				call(LilycoveCity_DepartmentStoreElevator_EventScript_MoveElevator)
				setvar(VAR_ZONE_30_FLOOR, ZONE30_FLOORNUM_4F)
			}
		case 5:
			setvar(VAR_0x8006, ZONE30_FLOORNUM_5F)
			setdynamicwarp(MAP_ZONE30E, 0)
			if (var(VAR_ZONE_30_FLOOR) != ZONE30_FLOORNUM_5F) {
				call(LilycoveCity_DepartmentStoreElevator_EventScript_MoveElevator)
				setvar(VAR_ZONE_30_FLOOR, ZONE30_FLOORNUM_5F)
			}
		case 6:
			setvar(VAR_0x8006, ZONE30_FLOORNUM_6F)
			setdynamicwarp(MAP_ZONE30F, 0)
			if (var(VAR_ZONE_30_FLOOR) != ZONE30_FLOORNUM_6F) {
				call(LilycoveCity_DepartmentStoreElevator_EventScript_MoveElevator)
				setvar(VAR_ZONE_30_FLOOR, ZONE30_FLOORNUM_6F)
			}
		case 7:
			setvar(VAR_0x8006, ZONE30_FLOORNUM_7F)
			setdynamicwarp(MAP_ZONE30G, 0)
			if (var(VAR_ZONE_30_FLOOR) != ZONE30_FLOORNUM_7F) {
				call(LilycoveCity_DepartmentStoreElevator_EventScript_MoveElevator)
				setvar(VAR_ZONE_30_FLOOR, ZONE30_FLOORNUM_7F)
			}
		case 8:
			setvar(VAR_0x8006, ZONE30_FLOORNUM_8F)
			setdynamicwarp(MAP_ZONE30H, 0)
			if (var(VAR_ZONE_30_FLOOR) != ZONE30_FLOORNUM_8F) {
				call(LilycoveCity_DepartmentStoreElevator_EventScript_MoveElevator)
				setvar(VAR_ZONE_30_FLOOR, ZONE30_FLOORNUM_8F)
			}
	}
	release
	end
}

script Zone30Z_EventScript_MoveElevator {
	closemessage
	applymovement(VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterDown)
	waitmovement(0)
	waitse
	special(MoveElevator)
	setflag(FLAG_TEMP_2)
	return
}
