mapscripts Zone30Z_MapScripts {}

script Zone30Z_EventScript_Attendant {
	lock
	faceplayer
	setvar(VAR_0x8004, 0)
	if (!flag(FLAG_TEMP_2)) {
		special(SetDeptStoreFloor)
	}
	copyvar(VAR_0x8005, VAR_ZONE_30_FLOOR)
	message(format("Welcome to LILYCOVE DEPARTMENT STORE.\pWhich floor would you like?"))
	waitmessage
	setvar(VAR_0x8004, 0)
	dynmultipush("5F", 5)
	dynmultipush("4F", 4)
	dynmultipush("3F", 3)
	dynmultipush("2F", 2)
	dynmultipush("1F", 1)
	dynmultipush("Exit", 0)
	dynmultistack(0, 0, FALSE, 6, FALSE, VAR_ZONE_30_FLOOR, DYN_MULTICHOICE_CB_NONE)
	switch(var(VAR_RESULT)) {
		case 1:
			setvar(VAR_0x8006, ZONE30_FLOORNUM_1F)
			setdynamicwarp(MAP_ZONE30A, 0)
			if (var(VAR_ZONE_30_FLOOR) != ZONE30_FLOORNUM_1F) {
				call(LilycoveCity_DepartmentStoreElevator_EventScript_MoveElevator)
				setvar(VAR_ZONE_30_FLOOR, ZONE30_FLOORNUM_1F)
			}
		// case 2:
		// 	setvar(VAR_0x8006, ZONE30_FLOORNUM_2F)
		// 	setdynamicwarp(MAP_ZONE30B, 2, 1)
		// 	if (var(VAR_ZONE_30_FLOOR) != ZONE30_FLOORNUM_2F) {
		// 		call(LilycoveCity_DepartmentStoreElevator_EventScript_MoveElevator)
		// 		setvar(VAR_ZONE_30_FLOOR, ZONE30_FLOORNUM_2F)
		// 	}
		// case 3:
		// 	setvar(VAR_0x8006, ZONE30_FLOORNUM_3F)
		// 	setdynamicwarp(MAP_ZONE30C, 2, 1)
		// 	if (var(VAR_ZONE_30_FLOOR) != ZONE30_FLOORNUM_3F) {
		// 		call(LilycoveCity_DepartmentStoreElevator_EventScript_MoveElevator)
		// 		setvar(VAR_ZONE_30_FLOOR, ZONE30_FLOORNUM_3F)
		// 	}
		// case 4:
		// 	setvar(VAR_0x8006, ZONE30_FLOORNUM_4F)
		// 	setdynamicwarp(MAP_ZONE30D, 2, 1)
		// 	if (var(VAR_ZONE_30_FLOOR) != ZONE30_FLOORNUM_4F) {
		// 		call(LilycoveCity_DepartmentStoreElevator_EventScript_MoveElevator)
		// 		setvar(VAR_ZONE_30_FLOOR, ZONE30_FLOORNUM_4F)
		// 	}
		// case 5:
		// 	setvar(VAR_0x8006, ZONE30_FLOORNUM_5F)
		// 	setdynamicwarp(MAP_ZONE30E, 2, 1)
		// 	if (var(VAR_ZONE_30_FLOOR) != ZONE30_FLOORNUM_5F) {
		// 		call(LilycoveCity_DepartmentStoreElevator_EventScript_MoveElevator)
		// 		setvar(VAR_ZONE_30_FLOOR, ZONE30_FLOORNUM_5F)
		// 	}
	}
	release
	end
}