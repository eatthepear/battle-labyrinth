mapscripts Zone14B_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE14B_FIRE_STONE)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
	}
}

script Zone14B_EventScript_FireStone {
	lock
	if (flag(FLAG_ITEM_ZONE14B_FIRE_STONE)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE14B_FIRE_STONE)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_FIRE_STONE)
	release
	end
}

script Zone14B_EventScript_MagmaGrunt1 {
	trainerbattle_single(TRAINER_PBL_MAGMA_GRUNT_14B_1, format("Magma!"), format("Magma!"))
	msgbox(format("Magma!"), MSGBOX_AUTOCLOSE)
	end
}

