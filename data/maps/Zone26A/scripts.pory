mapscripts Zone26A_MapScripts {}

script Zone26A_EventScript_StopLeave {
	lockall
	applymovement(LOCALID_PLAYER, Common_Movement_WalkUp)
	waitmovement(0)
	msgbox(format("A mysterious force pushes you away from the exit."), MSGBOX_AUTOCLOSE)
	releaseall
	end
}

raw `
Zone26A_EventScript_Exit::
	lockall
	warp MAP_ZONE_SANCTUARY, 255, 22, 7
	releaseall
	end

Zone26A_EventScript_Banettite::
	finditem ITEM_BANETTITE
	end
`
