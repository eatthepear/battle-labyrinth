	setmetatile(7, 25, METATILE_RocketCo_Floor_ShadeFull, 0)
	setmetatile(8, 25, METATILE_RocketCo_Floor_ShadeFull, 0)
	setmetatile(7, 26, METATILE_RocketCo_Floor_WallLeftCorner, 0)
	setmetatile(8, 26, METATILE_RocketCo_Floor_WallRightCorner, 0)
	waitse
	playse(SE_UNLOCK)
