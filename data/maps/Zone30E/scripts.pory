}

script Zone30E_EventScript_Door3 {
	lockall
	setvar(VAR_TEMP_1, 1) // 1 = lobby, 2 = magma, 3 = aqua, 4 = galactic, 5 = rocket top floor
	setvar(VAR_0x8004, FLAG_ZONE_30E_DOOR_3)
    if (flag(FLAG_ZONE_30E_DOOR_3)) {
        goto(Zone30_EventScript_DoorUnlocked)
    }
    call(Zone30_EventScript_CheckCanOpenDoor)
	setmetatile(19, 25, METATILE_RocketCo_Floor_ShadeFull, 0)
	setmetatile(20, 25, METATILE_RocketCo_Floor, 0)
	setmetatile(19, 26, METATILE_RocketCo_Floor_ShadeFull, 0)
	setmetatile(20, 26, METATILE_RocketCo_Floor, 0)
	setmetatile(20, 27, METATILE_RocketCo_Floor, 0)
	waitse
	playse(SE_UNLOCK)
	special(DrawWholeMapView)
	waitse
	special(SetHiddenItemFlag)
	releaseall
	end
}

script Zone30E_EventScript_Shelly {
    lock
    faceplayer
    msgbox(format("DIALOGUE!"))
    release
    end
}

script Zone30E_EventScript_Matt {
    lock
    faceplayer
    msgbox(format("DIALOGUE!"))
    release
    end
}

script Zone30E_EventScript_TagBattle {
    lockall
    setspeaker("Shelly")
    msgbox(format("DIALOGUE!"))
    setspeaker("Wally")
    msgbox(format("DIALOGUE!"))
    setspeaker("Matt")
    msgbox(format("DIALOGUE!"))
    call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
    multi_2_vs_2(TRAINER_PBL_SHELLY_BOSS_30, format("DEFEATED 1!"), TRAINER_PBL_MATT_BOSS_30, format("DEFEATED 2!"), PARTNER_PBL_LEAF_30)
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
    destroyfollowernpc
    setvar(VAR_ZONE_30_STATE, 5)
    releaseall
    end
}
