mapscripts Zone30E_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		if (flag(FLAG_ZONE_30E_DOOR_1) == FALSE) {
			setmetatile(7, 13, METATILE_RocketCo_VerticalBarrier_TopLeft, 1)
			setmetatile(8, 13, METATILE_RocketCo_VerticalBarrier_TopRight, 1)
			setmetatile(7, 14, METATILE_RocketCo_VerticalBarrier_MidLeft, 1)
			setmetatile(8, 14, METATILE_RocketCo_VerticalBarrier_MidRight, 1)
			setmetatile(7, 15, METATILE_RocketCo_VerticalBarrier_BottomLeft, 1)
			setmetatile(8, 15, METATILE_RocketCo_VerticalBarrier_BottomRight, 1)
		}
		if (flag(FLAG_ZONE_30E_DOOR_2) == FALSE) {
			setmetatile(7, 24, METATILE_RocketCo_VerticalBarrier_TopLeft, 1)
			setmetatile(8, 24, METATILE_RocketCo_VerticalBarrier_TopRight, 1)
			setmetatile(7, 25, METATILE_RocketCo_VerticalBarrier_MidLeft, 1)
			setmetatile(8, 25, METATILE_RocketCo_VerticalBarrier_MidRight, 1)
			setmetatile(7, 26, METATILE_RocketCo_VerticalBarrier_BottomLeft, 1)
			setmetatile(8, 26, METATILE_RocketCo_VerticalBarrier_BottomRight, 1)
		}
		if (flag(FLAG_ZONE_30E_DOOR_3) == FALSE) {
			setmetatile(19, 25, METATILE_RocketCo_HorizontalBarrier_TopLeft, 1)
			setmetatile(20, 25, METATILE_RocketCo_HorizontalBarrier_TopRight, 1)
			setmetatile(19, 26, METATILE_RocketCo_HorizontalBarrier_BottomLeft, 1)
			setmetatile(20, 26, METATILE_RocketCo_HorizontalBarrier_BottomRight, 1)
			setmetatile(20, 27, METATILE_RocketCo_Floor_ShadeFull, 0)
		}
	}
}



script Zone30E_EventScript_Door1 {
	lockall
	setvar(VAR_TEMP_1, 1) // 1 = lobby, 2 = magma, 3 = aqua, 4 = galactic, 5 = rocket top floor
	setvar(VAR_0x8004, FLAG_ZONE_30E_DOOR_1)
    if (flag(FLAG_ZONE_30E_DOOR_1)) {
        goto(Zone30_EventScript_DoorUnlocked)
    }
    call(Zone30_EventScript_CheckCanOpenDoor)
	setmetatile(7, 13, METATILE_RocketCo_Wall_LeftEdge, 1)
	setmetatile(8, 13, METATILE_RocketCo_Wall_RightEdge, 1)
	setmetatile(7, 14, METATILE_RocketCo_Floor_ShadeFull, 0)
	setmetatile(8, 14, METATILE_RocketCo_Floor_ShadeFull, 0)
	setmetatile(7, 15, METATILE_RocketCo_Floor_WallLeftCorner, 0)
	setmetatile(8, 15, METATILE_RocketCo_Floor_WallRightCorner, 0)
	waitse
	playse(SE_UNLOCK)
	special(DrawWholeMapView)
	waitse
	special(SetHiddenItemFlag)
	releaseall
	end
}

script Zone30E_EventScript_Door2 {
	lockall
	setvar(VAR_TEMP_1, 1) // 1 = lobby, 2 = magma, 3 = aqua, 4 = galactic, 5 = rocket top floor
	setvar(VAR_0x8004, FLAG_ZONE_30E_DOOR_2)
    if (flag(FLAG_ZONE_30E_DOOR_2)) {
