mapscripts Zone25K_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE25K_RANDOM_1)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE25K_TM_AURA_SPHERE)) {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_TM_CHEST)
		}
	}
}

script Zone25K_EventScript_Random1 {
	lock
	if (flag(FLAG_ITEM_ZONE25K_RANDOM_1)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE25K_RANDOM_1)
	addobject(VAR_LAST_TALKED)
	specialvar(VAR_TEMP_1, RandomItemChest)
	finditem(VAR_TEMP_1, VAR_TEMP_0)
	release
	end
}

script Zone25K_EventScript_TMAuraSphere {
	lock
	if (flag(FLAG_ITEM_ZONE25K_TM_AURA_SPHERE)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_TM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE25K_TM_AURA_SPHERE)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_TM_AURA_SPHERE)
	release
	end
}

script Zone25K_EventScript_RocketGrunt_1 {
	trainerbattle_single(TRAINER_PBL_ROCKET_GRUNT_25K_1, format("BATTLE INTRO TEXT TODO!"), format("DEFEAT TEXT  TODO!"))
	msgbox(format("DEFEATED TEXT TODO!"), MSGBOX_AUTOCLOSE)
	end
}

