mapscripts Zone25K_MapScripts {}

raw `
Zone25K_EventScript_TM37::
	finditem ITEM_TM37
	end
`

script Zone25K_EventScript_RocketGrunt_1 {
	trainerbattle_single(TRAINER_PBL_ROCKET_GRUNT_25K_1, format("BATTLE!"), format("DEFEAT!"))
	msgbox(format("DEFEATED!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone25K_EventScript_RocketGrunt_2 {
	trainerbattle_single(TRAINER_PBL_ROCKET_GRUNT_25K_1, format("BATTLE!"), format("DEFEAT!"))
	msgbox(format("DEFEATED!"), MSGBOX_AUTOCLOSE)
	end
