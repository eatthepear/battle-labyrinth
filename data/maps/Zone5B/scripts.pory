mapscripts Zone5B_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_TEMP_HIDE_FOLLOWER)
    }
}

script Zone5B_EventScript_Liza {
    lock
	if (flag(FLAG_BEAT_BOSS_5)) {
		setspeaker("Liza")
		msgbox(format("You will become even stronger! I've battled you, so I know."))
		release
		end
	}
	setspeaker("Liza")
	msgbox(format("Hehehe… Were you surprised?\pThis is my own Pokémon Gym, my very own, without my brother anywhere near!\pWhile it would be nice to be around him sometimes…\pNever mind. You've brought yourself, and you're looking for a challenge.\pI hope to meet that expectation!\pBring it!"))
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_LIZA_BOSS_5, format("What? I lost?"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Liza")
	msgbox(format("It can't be helped. You've won…\pCongratulations. Please take the Mind Badge!"))
	setspeaker(SP_NAME_NONE)
	playfanfare(MUS_OBTAIN_BADGE)
	msgbox(format("{PLAYER} received the Mind Badge from {COLOR BLUE}Liza{COLOR DARK_GRAY}!"))
	waitfanfare
	setspeaker("Liza")
	msgbox(format("Since you now have the Mind Badge, you can use the HM {COLOR GREEN}Cut{COLOR DARK_GRAY} outside battle.\pI'd also like you to take this TM."))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_TM_LIGHT_SCREEN)
	setspeaker("Liza")
	msgbox(format("That's it!\pFufufu…\pJust kidding, here's the other one as well. Us Gym Leaders give out multiple rewards!"))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_TM_REFLECT)
	setspeaker("Liza")
	msgbox(format("You will become even stronger! I've battled you, so I know."))
    setflag(FLAG_BEAT_BOSS_5)
	setflag(FLAG_BADGE02_GET)
	release
	end
}

script Zone5B_EventScript_GymStatue {
    lockall
	msgbox(format("Liza's Pokémon Gym"))
	releaseall
	end
}

script Zone5B_EventScript_GymGuide {
    lock
    faceplayer
    msgbox(format("Welcome to {COLOR BLUE}Liza{COLOR DARK_GRAY}'s Pokémon Gym!\pYou'll find some challenging puzzles up ahead to test your mind.\pThe Gym Leader, {COLOR BLUE}Liza{COLOR DARK_GRAY}, is estranged from her brother currently, so be prepared for a single battle!"))
    release
    end
}

script Zone5B_EventScript_YellowFloorSwitch {
    setvar(VAR_TEMP_0, 0)
    goto(Zone5B_EventScript_FloorSwitch)
}

script Zone5B_EventScript_BlueFloorSwitch {
    setvar(VAR_TEMP_0, 1)
    goto(Zone5B_EventScript_FloorSwitch)
}

script Zone5B_EventScript_GreenFloorSwitch {
    setvar(VAR_TEMP_0, 2)
    goto(Zone5B_EventScript_FloorSwitch)
}

script Zone5B_EventScript_PurpleFloorSwitch {
    setvar(VAR_TEMP_0, 3)
    goto(Zone5B_EventScript_FloorSwitch)
}

script Zone5B_EventScript_RedFloorSwitch {
    setvar(VAR_TEMP_0, 4)
    goto(Zone5B_EventScript_FloorSwitch)
}

script Zone5B_EventScript_FloorSwitch {
	playse(SE_SWITCH)
	waitse
	playse(SE_REPEL)
	initrotatingtilepuzzle(FALSE)
	moverotatingtileobjects(VAR_TEMP_0)
	waitmovement(0)
	turnrotatingtileobjects
	waitmovement(0)
	freerotatingtilepuzzle
    end
}

script Zone5B_EventScript_WarpToEntrance {
	lockall
	setvar(VAR_ZONE_5_STATE, 1)
	warpmossdeepgym(MAP_ZONE5B, 0, 31)
	waitstate
	releaseall
	end
}

script Zone5B_EventScript_WarpToLizasRoom {
	lockall
	warpmossdeepgym(MAP_ZONE5B, 25, 2)
	waitstate
	releaseall
	end
}

script Zone5B_EventScript_WarpToPriorWarp {
	lockall
	warpmossdeepgym(MAP_ZONE5B, 4, 11)
	waitstate
	releaseall
	end
}

script Zone5B_EventScript_Sylvia {
	trainerbattle_single(TRAINER_PBL_SYLVIA, format("Psychic Pokémon are the most powerful!"), format("I stand corrected!"))
	msgbox(format("You are the most powerful!\pWell, aside from our Gym Leader!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone5B_EventScript_Theresa {
	trainerbattle_single(TRAINER_PBL_THERESA, format("What a strange place to find myself in…"), format("I find myself feeling dizzy for some reaon!"))
	msgbox(format("Surely the spinning isn't messing with my head, right?"), MSGBOX_AUTOCLOSE)
	end
}

script Zone5B_EventScript_Fred {
	trainerbattle_single(TRAINER_PBL_FRED, format("Many have asked why the Gym Leader does not battle with her brother.\pI ask, why does it matter? She battles exceptionally well by herself!"), format("Our Gym Leader is the best!"))
	msgbox(format("I have to admit though, she would be even more formidable with her brother alongside her."), MSGBOX_AUTOCLOSE)
	end
}
