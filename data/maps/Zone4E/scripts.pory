mapscripts Zone4E_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE4E_RANDOM_1)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE4E_POISON_BARB)) {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST)
		}
	}
}

script Zone4E_EventScript_KimonoGirl_Exit {
	lockall
	applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, Common_Movement_FaceUp)
	waitmovement(0)
	applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	playbgm(MUS_HG_KIMONO_GIRL, 0)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
	waitmovement(0)
	setspeaker("Kimono Girl")
	msgbox(format("Oh, look! The exit!\pThe poor Kimono Girl has been led to the exit by a kind trainer!\pPlease take this as thanks."))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_SACRED_ASH)
	setspeaker("Kimono Girl")
	msgbox(format("That Sacred Ash is quite rare. Use it for emergencies.\pWell, I shall be off. It seems someone awaits you up ahead. Be cautious, young trainer."), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_PLAYER, Zone4E_Movement_Player_UnblockKimonoGirl)
	applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, Zone4E_Movement_KimonoGirl_Exit)
	waitmovement(0)
	destroyfollowernpc
	setvar(VAR_ZONE_4_STATE, 2)
	fadedefaultbgm
	releaseall
}

movement Zone4E_Movement_Player_UnblockKimonoGirl {
	walk_down
	walk_right
	face_left
	delay_16 * 4
	face_up
	delay_16 * 6
	face_left
}

movement Zone4E_Movement_KimonoGirl_Exit {
	walk_left
	walk_right
	walk_up * 2
	walk_right * 4
	walk_up * 2
	walk_left * 4
	walk_up
	walk_left * 3
	walk_up
}

script Zone4E_EventScript_LeviathanBattle {
	lockall
	playbgm(MUS_HG_ENCOUNTER_ROCKET, TRUE)
	applymovement(LOCALID_PROTON, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	delay(16)
	applymovement(LOCALID_PROTON, Common_Movement_WalkDown3)
	waitmovement(0)
	applymovement(LOCALID_PROTON, Common_Movement_FaceRight)
	waitmovement(0)
	delay(16)
	setspeaker("Proton")
	msgbox(format("So! The one who's been messing with my grunts comes walking around.\pYou must be wondering who I am.\pMy name is {COLOR BLUE}Proton{COLOR DARK_GRAY}, an {COLOR GREEN}Admin{COLOR DARK_GRAY} of {COLOR GREEN}Team Rainbow Rocket!{COLOR DARK_GRAY}.\pWe've been gathering resources, supplies, and like-minded people to join us in our mission of multiversal conquest.\pSomething about the way you stand says you'll get in our way.\pSo be it! I, Proton, will teach you a lesson."))
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_PROTON_LEVIATHAN_4, format("Defeated by a child!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Proton")
	msgbox(format("Argh… A shameful defeat, but it won't hold me back.\pYou're going to regret standing in the way of {COLOR GREEN}Team Rainbow Rocket!{COLOR DARK_GRAY}, mark my words.\pOur organization has grown over the years, absorbing other villainous organizations into it as well.\pTake heart in knowing your victory will be short lived."), MSGBOX_AUTOCLOSE)
	fadescreenswapbuffers(FADE_TO_BLACK)
	removeobject(LOCALID_PROTON)
	removeobject(LOCALID_GRUNT_1_4E)
	removeobject(LOCALID_GRUNT_2_4E)
	setflag(FLAG_BEAT_LEVIATHAN_4)
	setvar(VAR_ZONE_4_STATE, 3)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	msgbox(format("Proton vanished into thin air without a trace!\pHow could he have done such a thing?\pThere's something on the ground where he was standing…"))
	giveitem(ITEM_TM_VENOSHOCK)
	closemessage
	fadedefaultbgm
	releaseall
	end
}

script Zone4E_EventScript_Random1 {
	lock
	if (flag(FLAG_ITEM_ZONE4E_RANDOM_1)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE4E_RANDOM_1)
	addobject(VAR_LAST_TALKED)
	specialvar(VAR_TEMP_1, RandomItemChest)
	finditem(VAR_TEMP_1, VAR_TEMP_0)
	release
	end
}

script Zone4E_EventScript_PoisonBarb {
	lock
	if (flag(FLAG_ITEM_ZONE4E_POISON_BARB)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE4E_POISON_BARB)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_POISON_BARB, 1)
	release
	end
}

script Zone4E_EventScript_RocketGrunt_1 {
	trainerbattle_single(TRAINER_PBL_ROCKET_GRUNT_4E_1, format("Our Admin is up ahead doing important work! I can't let you stop him!"), format("You stopped me instead!"))
	msgbox(format("I don't know what he's doing, but I'm sure it furthers Team Rainbow Rocket's goals!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone4E_EventScript_RocketGrunt_2 {
	trainerbattle_single(TRAINER_PBL_ROCKET_GRUNT_4E_2, format("We're Team Rainbow Rocket, not just ordinary Team Rocket!"), format("It's a major rebrand!"))
	msgbox(format("Not sure when or why we rebranded, but it's working well for us!"), MSGBOX_AUTOCLOSE)
	end
}
