mapscripts Zone30B_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		if (flag(FLAG_ZONE_30B_DOOR_1) == FALSE) {
			setmetatile(32, 18, METATILE_RocketCo_HorizontalBarrier_TopLeft, 1)
			setmetatile(33, 18, METATILE_RocketCo_HorizontalBarrier_TopRight, 1)
			setmetatile(32, 19, METATILE_RocketCo_HorizontalBarrier_BottomLeft, 1)
			setmetatile(33, 19, METATILE_RocketCo_HorizontalBarrier_BottomRight, 1)
			setmetatile(33, 20, METATILE_RocketCo_Floor_ShadeFull, 0)
		}
	}
}

script Zone30B_EventScript_Door1 {
	lockall
	setvar(VAR_TEMP_1, 2) // 1 = lobby, 2 = magma, 3 = aqua, 4 = galactic, 5 = rocket top floor
	setvar(VAR_0x8004, FLAG_ZONE_30B_DOOR_1)
    if (flag(FLAG_ZONE_30B_DOOR_1)) {
        goto(Zone30_EventScript_DoorUnlocked)
    }
    call(Zone30_EventScript_CheckCanOpenDoor)
	setmetatile(32, 18, METATILE_RocketCo_Floor_ShadeFull, 0)
	setmetatile(33, 18, METATILE_RocketCo_Floor, 0)
	setmetatile(32, 19, METATILE_RocketCo_Floor_ShadeFull, 0)
	setmetatile(33, 19, METATILE_RocketCo_Floor, 0)
	setmetatile(33, 20, METATILE_RocketCo_Floor, 0)
	waitse
	playse(SE_UNLOCK)
	special(DrawWholeMapView)
	waitse
	special(SetHiddenItemFlag)
	releaseall
	end
}

script Zone30B_EventScript_Wally_Intro {
	lockall
	playbgm(MUS_BW_FRIEND, 0)
	applymovement(LOCALID_WALLY_ZONE30B, Common_Movement_FaceLeft)
	waitmovement(0)
	applymovement(LOCALID_WALLY_ZONE30B, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	setspeaker("Wally")
	msgbox(format("Oh, poor Wally, all alone in these woods.\pWon't you help show me the way out?"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_WALLY_ZONE30B, Common_Movement_WalkRight3)
	waitmovement(0)
	setspeaker(SP_NAME_NONE)
	msgbox(format("{PLAYER} agreed to help {COLOR BLUE}Wally{COLOR DARK_GRAY}!"))
	setspeaker("Wally")
	msgbox(format("LETS GO!"), MSGBOX_AUTOCLOSE)
	setfollowernpc(LOCALID_WALLY_ZONE30B, FOLLOWER_NPC_FLAG_ALL, 0, PARTNER_PBL_WALLY_30)
	facefollowernpc
	setvar(VAR_ZONE_30_STATE, 2)
	fadedefaultbgm
	releaseall
}

script Zone30B_EventScript_Wally {
	lock
	faceplayer
	setspeaker("Wally")
	msgbox(format("DIALOGUE!"), MSGBOX_AUTOCLOSE)
	release
	end
}
