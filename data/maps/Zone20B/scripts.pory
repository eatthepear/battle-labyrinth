mapscripts Zone20B_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_ZONE_20_STATE, 0: Zone20B_EventScript_TriggerCoriExplanation
	]
}

script Zone20B_EventScript_TriggerCoriExplanation {
    lockall
	applymovement(LOCALID_CORI_20B, Common_Movement_FaceDown)
	waitmovement(0)
	applymovement(LOCALID_CORI_20B, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	applymovement(LOCALID_CORI_20B, Common_Movement_WalkDown2)
	waitmovement(0)
    setspeaker("Cori")
    msgbox(format("Hello, {PLAYER}! It's nice to see you again!\pYou don't remember me?{PAUSE_UNTIL_PRESS} I'm {COLOR BLUE}Cori{COLOR DARK_GRAY}!{PAUSE_UNTIL_PRESS} We battled a long time ago, when you were still at the beginning of your journey.\pNow look at you! You've really come a long way! You've made it all the way to my brothers' restaurant!\pThat's right, I have three older brothers: {COLOR BLUE}Cilan{COLOR DARK_GRAY}, {COLOR BLUE}Cress{COLOR DARK_GRAY}, and {COLOR BLUE}Chili{COLOR DARK_GRAY}!"))
    closemessage
    delay(40)
    setspeaker("Cori")
    msgbox(format("Say, are you here to earn a Gym Badge, per chance? If so, could you do us a favor first?\pThe servers here at the restaurant are feeling a bit unmotivated.\pIt would greatly help if you were to battle them, just to let them get their energy out!\pOnce you've done that, let me know, and I can get my brothers ready for a Gym Battle!"))
    closemessage
	applymovement(LOCALID_CORI_20B, Common_Movement_WalkUp2)
	waitmovement(0)
    setvar(VAR_ZONE_20_STATE, 1)
    releaseall
    end
}

script Zone20B_EventScript_Cori {
    lock
    faceplayer
    if (flag(FLAG_BEAT_BOSS_20)) {
        setspeaker("Cori")
        msgbox(format("Please enjoy my family's restaurant!"))
        release
        end
    }
    setspeaker("Cori")
    msgbox(format("So, did you defeat all the servers?"))
    if (defeated(TRAINER_PBL_WALKER) && defeated(TRAINER_PBL_NATALIA) && defeated(TRAINER_PBL_DUNCAN) && defeated(TRAINER_PBL_EVALINE)) {
        if (var(VAR_ZONE_20_STATE) == 1) {
            setspeaker("Cori")
            msgbox(format("Oh, great, you defeated them all! Great work, {PLAYER}!"))
            setvar(VAR_ZONE_20_STATE, 2)
        }
        setspeaker("Cori")
        msgbox(format("I let my brothers know that you're interested in a challenge for the Gym Badge.\pHow it works is… you pick one of them, and then they are your Tag Partner against the other two in a Tag Battle!\pJust go up and speak to whoever you want to partner with, when you're ready!"))
    } else {
        setspeaker("Cori")
        msgbox(format("Oh, the servers could really use a break from their duties.\pIf you battle them all, and help to get their energy out, I can go tell my brothers you're interested in a Gym Badge!"))
    }
    release
    end
}

script Zone20B_EventScript_Cilan {
    lock
    faceplayer
    if (flag(FLAG_BEAT_BOSS_20)) {
        setspeaker("Cilan")
        msgbox(format("YOU BEAT US!"))
        release
        end
    }
    if (var(VAR_ZONE_20_STATE) == 2) {
        setspeaker("Cilan")
        msgbox(format("Um. My name is Cilan. I like Grass-type Pokémon.\pI heard from my little sister that you're looking to earn a Gym Badge?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            msgbox(format("To earn a Gym Badge here, you have to pick one of myself, Chili, and Cress to be your partner, and then defeat the other two in a Tag Battle!"))
            msgbox(format("How about it? Would you team up with me and take part in a Double Battle against Chili and Cress?"), MSGBOX_YESNO)
            if (var(VAR_RESULT) == YES) {
                msgbox(format("OK. If you're fine with me, I will put everything I have into being your partner in battle!"))
                fadescreenswapbuffers(FADE_TO_BLACK)
                special(SpawnCameraObject)
                applymovement(LOCALID_CAMERA, Common_Movement_WalkDown)
                waitmovement(0)
                special(RemoveCameraObject)
                setvar(VAR_TEMP_0, 1)
                goto(Zone20B_EventScript_StartBossBattle)
            } else {
                msgbox(format("…Ah, hmm. I must've timed… my invitation poorly… True enough, I did want to… to have a Pokémon battle with you."))
            }
            release
            end
        }
        setspeaker("Cilan")
        msgbox(format("Ah, you must not be ready yet.\pLet me know when you are."))
        release
        end
    }
    setspeaker("Cilan")
    msgbox(format("Um. Hello. My name is Cilan. I am one of three Gym Leaders here.\pWe're not taking challengers at the moment.\pSee my younger sister, Cori, if you'd like a Gym Badge."))
    release
    end
}

script Zone20B_EventScript_Chili {
    lock
    faceplayer
    if (flag(FLAG_BEAT_BOSS_20)) {
        setspeaker("Chili")
        msgbox(format("YOU BEAT US!"))
        release
        end
    }
    if (var(VAR_ZONE_20_STATE) == 2) {
        setspeaker("Chili")
        msgbox(format("I'm Chili! My Fire-type Pokémon and I are too hot to handle!\pI heard from my little sister that you're looking to earn a Gym Badge?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            msgbox(format("To earn a Gym Badge here, you have to pick one of myself, Cilan, and Cress to be your partner, and then defeat the other two in a Tag Battle!"))
            msgbox(format("What it boils down to is, I want you to be my partner!\pWhat do you say about teaming up with me against Cilan and Cress?"), MSGBOX_YESNO)
            if (var(VAR_RESULT) == YES) {
                msgbox(format("Yeeeeooow! I'm the strongest of us brothers, and I'll make sure you win!"))
                closemessage
                fadescreenswapbuffers(FADE_TO_BLACK)
                special(SpawnCameraObject)
                applymovement(LOCALID_CAMERA, Common_Movement_WalkDown4)
                waitmovement(0)
                applymovement(LOCALID_CAMERA, Common_Movement_WalkRight5)
                waitmovement(0)
                special(RemoveCameraObject)
                setvar(VAR_TEMP_0, 2)
                goto(Zone20B_EventScript_StartBossBattle)
            } else {
                msgbox(format("Aww, man! I was all fired up, too!"))
            }
            release
            end
        }
        setspeaker("Chili")
        msgbox(format("Whoa! Alrighty then!\pYou're not ready, just hit me up when you are!"))
        release
        end
    }
    setspeaker("Chili")
    msgbox(format("Hey there! I'm Chili! A Gym Leader along with my brothers!\pWe're not taking challengers at the moment!\pSee my younger sister if you want to earn a Gym Badge!"))
    release
    end
}

script Zone20B_EventScript_Cress {
    lock
    faceplayer
    if (flag(FLAG_BEAT_BOSS_20)) {
        setspeaker("Cress")
        msgbox(format("YOU BEAT US!"))
        release
        end
    }
    if (var(VAR_ZONE_20_STATE) == 2) {
        setspeaker("Cress")
        msgbox(format("I'm a Water-type specialist, and my name is Cress. Pleased to make your acquaintance.\pI heard from my little sister that you're looking to earn a Gym Badge?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            msgbox(format("To earn a Gym Badge here, you have to pick one of myself, Cilan, and Chili to be your partner, and then defeat the other two in a Tag Battle!"))
            msgbox(format("Would you be so kind as to be my partner in a battle against Cilan and Chili?"), MSGBOX_YESNO)
            if (var(VAR_RESULT) == YES) {
                msgbox(format("That's wonderful. With me, Cress, as your partner, victory is assured."))
                closemessage
                fadescreenswapbuffers(FADE_TO_BLACK)
                special(SpawnCameraObject)
                applymovement(LOCALID_CAMERA, Common_Movement_WalkDown4)
                waitmovement(0)
                applymovement(LOCALID_CAMERA, Common_Movement_WalkLeft5)
                waitmovement(0)
                special(RemoveCameraObject)
                setvar(VAR_TEMP_0, 3)
                goto(Zone20B_EventScript_StartBossBattle)
            } else {
                msgbox(format("Oh, what's this? I'm amazed you turned me, Cress, down."))
            }
            release
            end
        }
        setspeaker("Cress")
        msgbox(format("I see, you must need a little more time.\pLet me know when you are fully prepared."))
        release
        end
    }
    setspeaker("Cress")
    msgbox(format("Hello, my name is Cress, and I am a Gym Leader, one of three.\pWe're not taking challengers at the moment.\pPlease see my younger sister at the front if you'd like to earn a Gym Badge."))
    release
    end
}

script Zone20B_EventScript_StartBossBattle {
    lockall
    hidefollower
    setobjectxy(LOCALID_CORI_20B, 14, 7)
    setobjectxy(LOCALID_PLAYER, 11, 8)
    applymovement(LOCALID_CORI_20B, Common_Movement_FaceDown)
    applymovement(LOCALID_PLAYER, Common_Movement_FaceRight)
    switch (var(VAR_TEMP_0)) {
        case 1:
            setobjectxy(LOCALID_CILAN, 11, 9)
            setobjectxy(LOCALID_CHILI, 17, 8)
            setobjectxy(LOCALID_CRESS, 17, 9)
            applymovement(LOCALID_CILAN, Common_Movement_FaceRight)
            applymovement(LOCALID_CHILI, Common_Movement_FaceLeft)
            applymovement(LOCALID_CRESS, Common_Movement_FaceLeft)
            waitmovement(0)
        case 2:
            setobjectxy(LOCALID_CHILI, 11, 9)
            setobjectxy(LOCALID_CILAN, 17, 8)
            setobjectxy(LOCALID_CRESS, 17, 9)
            applymovement(LOCALID_CHILI, Common_Movement_FaceRight)
            applymovement(LOCALID_CILAN, Common_Movement_FaceLeft)
            applymovement(LOCALID_CRESS, Common_Movement_FaceLeft)
            waitmovement(0)
        case 3:
            setobjectxy(LOCALID_CRESS, 11, 9)
            setobjectxy(LOCALID_CILAN, 17, 8)
            setobjectxy(LOCALID_CHILI, 17, 9)
            applymovement(LOCALID_CRESS, Common_Movement_FaceRight)
            applymovement(LOCALID_CILAN, Common_Movement_FaceLeft)
            applymovement(LOCALID_CHILI, Common_Movement_FaceLeft)
            waitmovement(0)
    }
	fadescreenswapbuffers(FADE_FROM_BLACK)
    setspeaker("Cori")
    msgbox(format("Ok! {PLAYER} is trying to get their Gym Badge!"))
    switch (var(VAR_TEMP_0)) {
        case 1:
            msgbox(format("They've selected Cilan as their partner!\pSo it will be {PLAYER} and Cilan, versus Chili and Cress!"))
            applymovement(LOCALID_CILAN, Common_Movement_WalkInPlaceRight)
            waitmovement(0)
            setspeaker("Cilan")
            msgbox(format("OK… So, um, I'm Cilan, I like Grass-type Pokémon, and this is my partner here!"))
            closemessage
            call(Zone20B_EventScript_ChiliPreBattle)
            call(Zone20B_EventScript_CressPreBattle)
        case 2:
            msgbox(format("They've selected Chili as their partner!\pSo it will be {PLAYER} and Chili, versus Cilan and Cress!"))
            applymovement(LOCALID_CHILI, Common_Movement_WalkInPlaceRight)
            waitmovement(0)
            setspeaker("Chili")
            msgbox(format("That's that, then!\pI'm going to show you what me and my blazing Fire types can do!"))
            closemessage
            call(Zone20B_EventScript_CilanPreBattle)
            call(Zone20B_EventScript_CressPreBattle)
        case 3:
            msgbox(format("They've selected Cress as their partner!\pSo it will be {PLAYER} and Cress, versus Cilan and Chili!"))
            applymovement(LOCALID_CRESS, Common_Movement_WalkInPlaceRight)
            waitmovement(0)
            setspeaker("Cress")
            msgbox(format("It shall be I and my esteemed Water types that you must face in battle! Let us begin, then!\pIn garde, user of Grass-type Pokémon, Cilan, and of Fire-type Pokémon, Chili!"))
            closemessage
            call(Zone20B_EventScript_CilanPreBattle)
            call(Zone20B_EventScript_ChiliPreBattle)
    }
    call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
    special(SpawnCameraObject)
    switch (var(VAR_TEMP_0)) {
        case 1:
            applymovement(LOCALID_PLAYER, Common_Movement_WalkRight)
            applymovement(LOCALID_CILAN, Common_Movement_WalkRight)
            applymovement(LOCALID_CHILI, Common_Movement_WalkLeft)
            applymovement(LOCALID_CRESS, Common_Movement_WalkLeft)
            waitmovement(0)
            special(RemoveCameraObject)
	        multi_2_vs_2(TRAINER_PBL_CHILI_BOSS_20, Zone20B_Text_Chili_Defeated, TRAINER_PBL_CRESS_BOSS_20, Zone20B_Text_Cress_Defeated, PARTNER_PBL_CILAN_20)
        case 2:
            applymovement(LOCALID_PLAYER, Common_Movement_WalkRight)
            applymovement(LOCALID_CHILI, Common_Movement_WalkRight)
            applymovement(LOCALID_CILAN, Common_Movement_WalkLeft)
            applymovement(LOCALID_CRESS, Common_Movement_WalkLeft)
            waitmovement(0)
            special(RemoveCameraObject)
	        multi_2_vs_2(TRAINER_PBL_CILAN_BOSS_20, Zone20B_Text_Cilan_Defeated, TRAINER_PBL_CRESS_BOSS_20, Zone20B_Text_Cress_Defeated, PARTNER_PBL_CHILI_20)
        case 3:
            applymovement(LOCALID_PLAYER, Common_Movement_WalkRight)
            applymovement(LOCALID_CRESS, Common_Movement_WalkRight)
            applymovement(LOCALID_CILAN, Common_Movement_WalkLeft)
            applymovement(LOCALID_CHILI, Common_Movement_WalkLeft)
            waitmovement(0)
            special(RemoveCameraObject)
	        multi_2_vs_2(TRAINER_PBL_CILAN_BOSS_20, Zone20B_Text_Cilan_Defeated, TRAINER_PBL_CHILI_BOSS_20, Zone20B_Text_Chili_Defeated, PARTNER_PBL_CRESS_20)
    }
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
    setspeaker("Cori")
    msgbox(format("Wow! What an incredible battle!\pLet's get all cleaned up…"))
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, Common_Movement_WalkUp3)
    waitmovement(0)
    special(RemoveCameraObject)
    setobjectxy(LOCALID_CORI_20B, 13, 7)
    setobjectxy(LOCALID_PLAYER, 14, 7)
    setobjectxy(LOCALID_CILAN, 14, 5)
    setobjectxy(LOCALID_CHILI, 12, 4)
    setobjectxy(LOCALID_CRESS, 16, 4)
    applymovement(LOCALID_CORI_20B, Common_Movement_FaceUp)
    applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
    applymovement(LOCALID_CILAN, Common_Movement_FaceDown)
    applymovement(LOCALID_CHILI, Common_Movement_FaceDown)
    applymovement(LOCALID_CRESS, Common_Movement_FaceDown)
    waitmovement(0)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	setspeaker("Cori")
	msgbox(format("Gym Badges are a proof of a Trainer's abilities.\pSince you completed our challenge and won your Tag Battle, please take the Trio Badge!"))
	setspeaker(SP_NAME_NONE)
	playfanfare(MUS_OBTAIN_BADGE)
	msgbox(format("{PLAYER} received the Trio Badge from {COLOR BLUE}Cori{COLOR DARK_GRAY}, {COLOR BLUE}Cilan{COLOR DARK_GRAY}, {COLOR BLUE}Chili{COLOR DARK_GRAY}, and {COLOR BLUE}Cress{COLOR DARK_GRAY}!"))
	waitfanfare
	setspeaker("Cori")
	msgbox(format("That badge lets you use {COLOR GREEN}Strength{COLOR DARK_GRAY} outside battle!\pAlso, my brothers have some things for you as well!"))
	setspeaker("Cilan")
	msgbox(format("Um… Yes… Please take this from me."))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_TM_GIGA_DRAIN)
    closemessage
	setspeaker("Cilan")
	msgbox(format("Giga Drain is one of my favorite moves."))
    closemessage
    applymovement(LOCALID_CILAN, Zone20B_Movement_CenterToRight)
    applymovement(LOCALID_CHILI, Zone20B_Movement_LeftToCenter)
    applymovement(LOCALID_CRESS, Zone20B_Movement_RightToLeft)
    waitmovement(0)
	setspeaker("Chili")
	msgbox(format("And take this from me!\pFlaming hot!"))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_TM_FLAMETHROWER)
    closemessage
	setspeaker("Chili")
	msgbox(format("Yeah! That's one barbecue right there!"))
    closemessage
    applymovement(LOCALID_CILAN, Zone20B_Movement_RightToLeft)
    applymovement(LOCALID_CHILI, Zone20B_Movement_CenterToRight)
    applymovement(LOCALID_CRESS, Zone20B_Movement_LeftToCenter)
    waitmovement(0)
	setspeaker("Cress")
	msgbox(format("And finally from me, please take this."))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_TM_SCALD)
    closemessage
	setspeaker("Cress")
	msgbox(format("I hope it will prove useful to you."))
    closemessage
    applymovement(LOCALID_CILAN, Zone20B_Movement_LeftToCenter)
    applymovement(LOCALID_CHILI, Zone20B_Movement_RightToLeft)
    applymovement(LOCALID_CRESS, Zone20B_Movement_CenterToRight)
    waitmovement(0)
	setspeaker("Cilan")
	msgbox(format("Um… back to work for now, I suppose."))
    closemessage
    applymovement(LOCALID_CHILI, Common_Movement_WalkLeft)
    applymovement(LOCALID_CRESS, Common_Movement_WalkRight)
    waitmovement(0)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, Common_Movement_WalkDown2)
    waitmovement(0)
    special(RemoveCameraObject)
    applymovement(LOCALID_CORI_20B, Common_Movement_FaceRight)
    applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    setspeaker("Cori")
    msgbox(format("Congratulations again, {PLAYER}!\pI think you made everyone in the restaurant a little happier today."))
    closemessage
    applymovement(LOCALID_CORI_20B, Common_Movement_WalkDown6)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
    waitmovement(0)
    setobjectxy(LOCALID_CORI_20B, 14, 14)
    setflag(FLAG_BEAT_BOSS_20)
	setflag(FLAG_BADGE06_GET)
    clearflag(FLAG_HIDE_ZONE20A_PORYGON)
    setvar(VAR_ZONE_20_STATE, 3)
    releaseall
    end
}

text Zone20B_Text_Cilan_Defeated {
    format("Er… Is it over now?")
}

text Zone20B_Text_Chili_Defeated {
    format("You got me. I am… burned… out…")
}

text Zone20B_Text_Cress_Defeated {
    format("Lose? Me? I don't believe this.")
}

movement Zone20B_Movement_LeftToCenter {
    walk_down
    walk_right * 2
    face_down
}

movement Zone20B_Movement_CenterToRight {
    walk_right * 2
    walk_up
    face_down
}

movement Zone20B_Movement_RightToLeft {
    walk_left * 4
    face_down
}

script Zone20B_EventScript_CilanPreBattle {
    applymovement(LOCALID_CILAN, Common_Movement_WalkInPlaceLeft)
    waitmovement(0)
    setspeaker("Cilan")
    msgbox(format("Nothing personal… No hard feelings…\pMe and my Grass-type Pokémon will… um…\pWe're gonna battle come what may."))
    closemessage
}

script Zone20B_EventScript_ChiliPreBattle {
    applymovement(LOCALID_CHILI, Common_Movement_WalkInPlaceLeft)
    waitmovement(0)
    setspeaker("Chili")
    msgbox(format("That's that, then!\pI'm going to show you what me and my blazing Fire types can do!"))
    closemessage
}

script Zone20B_EventScript_CressPreBattle {
    applymovement(LOCALID_CRESS, Common_Movement_WalkInPlaceLeft)
    waitmovement(0)
    setspeaker("Cress")
    msgbox(format("What incredible luck for you! You get to battle the best among the three of us."))
    closemessage
}

script Zone20B_EventScript_Walker {
	trainerbattle_single(TRAINER_PBL_WALKER, format("BATTLE!"), format("DEFEAT!"))
	msgbox(format("DEFEATED!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone20B_EventScript_Natalia {
	trainerbattle_single(TRAINER_PBL_NATALIA, format("BATTLE!"), format("DEFEAT!"))
	msgbox(format("DEFEATED!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone20B_EventScript_Duncan {
	trainerbattle_single(TRAINER_PBL_DUNCAN, format("BATTLE!"), format("DEFEAT!"))
	msgbox(format("DEFEATED!"), MSGBOX_AUTOCLOSE)
	end
