mapscripts Zone34M_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_ZONE_34_STATE_CYRUS, 1: Zone34M_EventScript_CyrusBattle
	]
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_1, 0 {
            setvar(VAR_TEMP_1, 1)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
        }
    ]
}

script Zone34M_EventScript_CyrusBattle {
    lockall
    applymovement(LOCALID_PLAYER, Common_Movement_WalkUp3)
    setspeaker("???")
    msgbox(format("Hmm"))
    applymovement(LOCALID_CYRUS, Common_Movement_FaceDown)
    waitmovement(0)
    setspeaker("???")
    msgbox(format("CYRUS!"))
    closemessage
    applymovement(LOCALID_CYRUS, Common_Movement_WalkDown)
    waitmovement(0)
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_CYRUS_BOSS_34, format("DEFEAT!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
    setspeaker("Cyrus")
    msgbox(format("DEFEAT!"))
    // move camera over to warp
    giveitem(ITEM_SECRET_KEY)
    setvar(VAR_ZONE_34_STATE_CYRUS, 2)
    releaseall
}
