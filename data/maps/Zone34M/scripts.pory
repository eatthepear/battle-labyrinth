mapscripts Zone34M_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		if (defeated(TRAINER_PBL_CYRUS_BOSS_34)) {
			setmetatile(9, 3, METATILE_RocketCastle_Warp, 0)
		}
    }
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_ZONE_34_STATE_CYRUS, 1: Zone34M_EventScript_CyrusBattle
	]
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_1, 0 {
            setvar(VAR_TEMP_1, 1)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
        }
    ]
}

script Zone34M_EventScript_CyrusBattle {
    lockall
    applymovement(LOCALID_PLAYER, Common_Movement_WalkUp3)
    setspeaker("???")
    msgbox(format("Hmm"))
    applymovement(LOCALID_CYRUS, Common_Movement_FaceDown)
    waitmovement(0)
    setspeaker("???")
    msgbox(format("CYRUS!"))
    closemessage
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
    if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
        setstartingstatus(STARTING_STATUS_GRAVITY)
        setstartingstatus(STARTING_STATUS_TRICK_ROOM)
    }
	trainerbattle_no_intro(TRAINER_PBL_CYRUS_BOSS_34, format("DEFEAT!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
    setspeaker("Cyrus")
    msgbox(format("DEFEAT!"))
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, Zone34M_Camera_MoveRightUp)
    waitmovement(0)
    setmetatile(9, 3, METATILE_RocketCastle_Warp, 0)
    playse(SE_EXP_MAX)
    special(DrawWholeMapView)
    waitse
    delay(10)
    applymovement(LOCALID_CAMERA, Zone34M_Camera_MoveLeftDown)
    waitmovement(0)
    special(RemoveCameraObject)
    giveitem(ITEM_SECRET_KEY)
    setvar(VAR_ZONE_34_STATE_CYRUS, 2)
    releaseall
}

movement Zone34M_Camera_MoveRightUp {
    walk_diag_northeast * 2
}

movement Zone34M_Camera_MoveLeftDown {
    walk_diag_southwest * 2
}
