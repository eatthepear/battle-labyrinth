mapscripts Zone18A_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_ZONE_18_STATE, 3: Zone18A_EventScript_ReturnAzurill
	]
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE18A_LINKING_CORD)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE18A_TM_U_TURN)) {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST)
		}
	}
}

script Zone18A_EventScript_ReturnAzurill {
	lockall
	applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
	waitmovement(0)
	setspeaker("Tuber")
	msgbox(format("Oh! You came back! Do you have my Azurill doll?"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_PLAYER, Common_Movement_WalkRight)
	waitmovement(0)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
	waitmovement(0)
	clearflag(FLAG_HIDE_ZONE18A_DOLL)
	addobject(LOCALID_AZURILL_DOLL)
	clearflag(FLAG_HIDE_ZONE18A_PORYGON)
	setvar(VAR_ZONE_18_STATE, 4)
	setspeaker("Tuber")
	msgbox(format("Wow! Thank you so much!"))
	msgbox(Zone18A_Text_Tuber_Replaced)
	releaseall
	end
}

script Zone18A_EventScript_TriggerGrunts {
	lockall
	applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
	waitmovement(0)
	special(SpawnCameraObject)
	applymovement(LOCALID_CAMERA, Common_Movement_WalkDown3)
	waitmovement(0)
	setspeaker("Tuber")
	msgbox(format("My Azurill doll! You're my favorite!"), MSGBOX_AUTOCLOSE)
	playbgm(MUS_ENCOUNTER_AQUA, 0)
	addobject(LOCALID_GRUNT_1_18A)
	addobject(LOCALID_GRUNT_1_18B)
	clearflag(FLAG_HIDE_ZONE18A_GRUNTS)
	delay(40)
	playse(SE_PIN)
	applymovement(LOCALID_TUBER_18A, Common_Movement_ExclamationMark)
	applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
	applymovement(LOCALID_GRUNT_1_18A, Common_Movement_WalkLeft6)
	applymovement(LOCALID_GRUNT_1_18B, Common_Movement_WalkLeft5)
	waitmovement(0)
	applymovement(LOCALID_GRUNT_1_18A, Common_Movement_FaceDown)
	waitmovement(0)
	setspeaker("Tuber")
	msgbox(format("What's going on?"), MSGBOX_AUTOCLOSE)
	delay(16)
	setspeaker("Team Aqua Grunt")
	msgbox(format("It be ours now, laddy!"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_GRUNT_1_18A, Common_Movement_FaceDown)
	waitmovement(0)
	removeobject(LOCALID_AZURILL_DOLL)
	setflag(FLAG_HIDE_ZONE18A_DOLL)
	delay(40)
	applymovement(LOCALID_GRUNT_1_18A, Common_Movement_WalkRight6)
	applymovement(LOCALID_GRUNT_1_18B, Common_Movement_WalkRight5)
	waitmovement(0)
	removeobject(LOCALID_GRUNT_1_18A)
	removeobject(LOCALID_GRUNT_1_18B)
	setflag(FLAG_HIDE_ZONE18A_GRUNTS)
	setspeaker("Tuber")
	msgbox(format("My Azurill doll!"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_BOAT_18A, Common_Movement_WalkRight2)
	waitmovement(0)
	removeobject(LOCALID_BOAT_18A)
	setflag(FLAG_HIDE_ZONE18A_BOAT)
	setspeaker("Tuber")
	msgbox(format("Wah!!!"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_TUBER_18A, Common_Movement_FaceUp)
	waitmovement(0)
	msgbox(Zone18A_Text_Tuber_Help, MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_CAMERA, Common_Movement_WalkUp3)
	waitmovement(0)
	special(RemoveCameraObject)
	fadedefaultbgm
	setvar(VAR_ZONE_18_STATE, 2)
	release
	end
}

text Zone18A_Text_Tuber_Help {
	format("Please! Help! My Azurill doll!")
}

text Zone18A_Text_Tuber_Replaced {
	format("How I missed you, Azurill!\pThough I almost replaced you with that {COLOR GREEN}strange looking Pokemon I saw in the grass nearby{COLOR DARK_GRAY}!")
}

script Zone18A_EventScript_Tuber {
	lock
	setspeaker("Tuber")
	switch (var(VAR_ZONE_18_STATE)) {
		case 0:
			msgbox(format("My Azurill doll is my favorite!"))
		case 1:
		case 2:
		case 3:
			faceplayer
			msgbox(Zone18A_Text_Tuber_Help)
		case 4:
			msgbox(Zone18A_Text_Tuber_Replaced)
	}
	release
	end
}

script Zone18A_EventScript_AzurillDoll {
	msgbox("It's an Azurill doll.\nIt's clearly been well loved.", MSGBOX_SIGN)
	end
}

script Zone18A_EventScript_SellSodaPop {
	lock
	faceplayer
	// if ((flag(FLAG_SETTINGS_BRUTAL) == true) || (flag(FLAG_SETTINGS_INDEPENDENT) == true)) {
	// 	msgbox(format("Soda Pop! I usually sell it, but today I'm out of stock!"))
	// 	release
	// 	end
	// }
	showmoneybox(0, 0, 0)
	msgbox("Want to buy some Soda Pop?\n¥300 for 50 HP a pop!", MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		checkmoney(300, 0)
		if (var(VAR_RESULT) == FALSE) {
			msgbox("You don't have enough money!")
			hidemoneybox
		} else {
			msgbox("Here you go!")
			removemoney(300, 0)
			updatemoneybox
			giveitem(ITEM_SODA_POP)
			hidemoneybox
		}
	} else {
		hidemoneybox
		msgbox("Aww, did you not like my pun?")
	}
	release
	end
}

script Zone18A_EventScript_LinkingCord {
	lock
	if (flag(FLAG_ITEM_ZONE18A_LINKING_CORD)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE18A_LINKING_CORD)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_LINKING_CORD)
	release
	end
}

script Zone18A_EventScript_TMUTurn {
	lock
	if (flag(FLAG_ITEM_ZONE18A_TM_U_TURN)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE18A_TM_U_TURN)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_TM_U_TURN)
	release
	end
}

script Zone18A_EventScript_John {
	trainerbattle_single(TRAINER_PBL_JOHN, format("BATTLE!"), format("DEFEAT!"))
	msgbox(format("DEFEATED!"), MSGBOX_AUTOCLOSE)
	end
}

raw `
Zone18A_EventScript_Sign::
	msgbox Zone18A_Text_Sign, MSGBOX_SIGN
	end

Zone18A_Text_Sign:
	.string "Trainer's Dojo!\n"
	.string "All challengers welcome!$"

Zone18A_EventScript_Doris::
	trainerbattle_single TRAINER_PBL_DORIS, Zone18A_Text_DorisIntro, Zone18A_Text_DorisDefeat
	msgbox Zone18A_Text_DorisPostBattle, MSGBOX_AUTOCLOSE
	end

Zone18A_Text_DorisIntro:
	.string "I've wanted a relaxing vacation for\n"
	.string "so long, but it's been so boring!\p"
	.string "How about a battle to spice things up?$"

Zone18A_Text_DorisDefeat:
	.string "Now that was exciting!$"

Zone18A_Text_DorisPostBattle:
	.string "I'll check out the Trainer's Dojo.\n"
	.string "It'll be more fun than just\l"
	.string "lounging around, right?$"

Zone18A_EventScript_Homer::
	trainerbattle_single TRAINER_PBL_HOMER, Zone18A_Text_HomerIntro, Zone18A_Text_HomerDefeat
	msgbox Zone18A_Text_HomerPostBattle, MSGBOX_AUTOCLOSE
	end

Zone18A_Text_HomerIntro:
	.string "Ah, a lovely day by the beach.\p"
	.string "What's that? A battle?\p"
	.string "Say no more! I'm all riled up!$"

Zone18A_Text_HomerDefeat:
	.string "Argh! You ruined my perfect day!$"

Zone18A_Text_HomerPostBattle:
	.string "My day is ruined! How am I supposed\n"
	.string "to enjoy my day at the beach\l"
	.string "knowing I've lost to some commoner?$"
`
