mapscripts Zone21C_MapScripts {}

script Zone21C_EventScript_Thaddeus {
	lock
	faceplayer
	if (flag(FLAG_BADGE08_GET) == FALSE) {
		setspeaker("Thaddeus")
		msgbox(format("I don't battle anyone with less than 8 Gym Badges. Get lost, kid."))
		release
		end
	}
	if (defeated(TRAINER_PBL_THADDEUS_OPTIONAL_21)) {
		setspeaker("Thaddeus")
		msgbox(format("There are three other Aspiring Leaders like me out there. The others like to be hide away in their obscure locations.\pMe? This is my house, so I'm gonna stick with it."))
		release
		end
	}
	setspeaker("Thaddeus")
	msgbox(format("Hey, kid. My name is {COLOR BLUE}Thaddeus{COLOR DARK_GRAY}, and I am one of the four {COLOR BLUE}Aspiring Leaders{COLOR DARK_GRAY}.\pWe are skilled trainers who specialize in a particular type just like a Gym Leader, and indeed, we hope to be Gym Leaders one day.\pYou want to tough it out against me?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		msgbox(format("Oh, it's all good, just take your time!"), MSGBOX_AUTOCLOSE)
		releaseall
		end
	}
	msgbox(format("That's the spirit. You're going down!"))
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_THADDEUS_OPTIONAL_21, format("Your Pokémon pack a mean punch!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Thaddeus")
	msgbox(format("I didn't expect a little kid like you to beat me! Oh well.\pI, {COLOR BLUE}Thaddeus{COLOR DARK_GRAY} the Aspiring Leader, will give you the victory.\pAnd, here's a little something extra for you."))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_TM_DARK_PULSE, 1)
	setspeaker("Thaddeus")
	msgbox(format("Yeah, that right there is one of my favorite TMs.\p{COLOR GREEN}Dark Pulse{COLOR DARK_GRAY} is pretty nice on any Dark-type Pokémon, but it can also be learned by some other strong Pokémon as well."))
	release
	end
}
