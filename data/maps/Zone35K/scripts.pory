mapscripts Zone35K_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ZONE_35_STATE, 5 {
            lockall
            setvar(VAR_ZONE_35_STATE, 6)
            call(Zone35K_EventScript_EnterRoom)
            releaseall
        }
    ]
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_1, 0 {
            turnobject(LOCALID_PLAYER, DIR_NORTH)
        }
    ]
}

script Zone35K_EventScript_EnterRoom {
	lockall
	applymovement(LOCALID_PLAYER, Common_Movement_WalkUp5)
	waitmovement(0)
    playbgm(MUS_DP_ENCOUNTER_CHAMPION, FALSE)
	delay(40)
	setspeaker("Cynthia")
	msgbox(format("One look at you tells me many things about you.\pTogether, you and your Pokémon overcame all the challenges you faced, however difficult.\pIt means that you've triumphed over any personal weaknesses, too.\pThe power you learned…\pI can feel it emanating from you.\pThat's enough talking.\pLet's get on with why you're here.\pAs the Pokémon League Champion, I accept your challenge!\pThere won't be any letup from me!"))
	trainerbattle_no_intro(TRAINER_PBL_CYNTHIA_BOSS_35, format("…Just a few moments ago, you were the most powerful challenger.\pAnd just now, you became the most powerful of all the Trainers.\pYou are now the newest Champion!"))
	playse(SE_DOOR)
	setmetatile(6, 1, METATILE_EliteFour_OpenDoorChampion_Frame, FALSE)
	setmetatile(6, 2, METATILE_EliteFour_OpenDoorChampion_Opening, FALSE)
	special(DrawWholeMapView)
	setspeaker("Cynthia")
	msgbox(format("That was excellent. Truly, an outstanding battle.\pYou gave the support your Pokémon needed to maximize their power.\pAnd you guided them with certainty to secure victory.\pYou have both passion and calculating coolness.\pTogether, you and your Pokémon can overcome any challenge that may come your way.\pThose are the impressions I got from our battle.\pCome with me, now, to the Hall of Fame."))
	closemessage
	applymovement(LOCALID_CYNTHIA_35K, Zone35K_Movement_CynthiaExit)
	applymovement(LOCALID_PLAYER, Zone35K_Movement_PlayerExit)
	waitmovement(0)
	warp(MAP_ZONE35L, 7, 16)
	waitstate
    releaseall
    end
}

movement Zone35K_Movement_CynthiaExit {
	walk_up * 3
	delay_8
	set_invisible
}

movement Zone35K_Movement_PlayerExit {
	walk_up * 4
    delay_16
	walk_up
	delay_8
	set_invisible
}
