mapscripts Zone14C_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE14C_METAL_COAT)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
	}
}


script Zone14C_EventScript_Courtney {
	lock
	faceplayer
	playbgm(MUS_ENCOUNTER_MAGMA, TRUE)
	setspeaker("Courtney")
	msgbox(format("So! You're the one who's been defeating all of my grunts.\pYou look kinda cute. Ever thought about joining Team Magma?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
	    setspeaker("Courtney")
		msgbox(format("Hm… but you did defeat a bunch of my grunts, so… even though you're a cutie…\pNo can do!"))
	} else {
	    setspeaker("Courtney")
		msgbox(format("Didn't think so! You've got the looks, but none of the brains, it seems!"))
	}
    setspeaker("Courtney")
	msgbox(format("Either way, you can't stop us here.\pMy fellow Admin Tabitha and I have already siphoned the necessary energy from this place.\pNow, I'm going to defeat you in battle, just to teach you a lesson!"))
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_COURTNEY_BOSS_14, format("You're… really good at battling, I guess."))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Courtney")
	msgbox(format("Whew! That was… a great battle.\pHere, you can have this for entertaining me so well."))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_TM_ATTRACT)
	setspeaker("Courtney")
	msgbox(format("I guess it's time go.\pToo bad, I wanted to get to know you more.\pIf we ever meet again, I'll have to save some time to chat!"))
	closemessage
	fadescreenswapbuffers(FADE_TO_BLACK)
	removeobject(LOCALID_COURTNEY_14C)
	setflag(FLAG_BEAT_BOSS_14)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	savebgm(MUS_DUMMY)
	fadedefaultbgm
	releaseall
	end
}

script Zone14C_EventScript_MetalCoat {
	lock
	if (flag(FLAG_ITEM_ZONE14C_METAL_COAT)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE14C_METAL_COAT)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_METAL_COAT)
	release
	end
}
