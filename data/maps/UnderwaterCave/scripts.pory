mapscripts UnderwaterCave_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_UNDERWATER_CAVE_TM_FLING)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST)
		}
    }
}

script UnderwaterCave_EventScript_TMFling {
	lock
	if (flag(FLAG_ITEM_UNDERWATER_CAVE_TM_FLING)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
	setflag(FLAG_ITEM_UNDERWATER_CAVE_TM_FLING)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_TM_FLING, 1)
	release
	end
}
