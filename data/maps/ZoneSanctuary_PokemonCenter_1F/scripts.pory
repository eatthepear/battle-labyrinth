mapscripts ZoneSanctuary_PokemonCenter_1F_MapScripts {}

script EventScript_Joy {
	lock
	faceplayer
	if (flag(FLAG_JOY_INTRO) == false) {
		setflag(FLAG_JOY_INTRO)
		setspeaker("???")
		msgbox(format("Welcome to {COLOR GREEN}Joy's Center of Restoration{COLOR DARK_GRAY}! My name is Joy."))
		setspeaker("Joy")
		msgbox(format("I used to work at the Pokémon Center, but they gave terrible pay.\pSo now, this building, {COLOR GREEN}Joy's Center of Restoration{COLOR DARK_GRAY}, is my own! I own it! Isn't that amazing?\pAnyways, not only do we encourage folks to use the building as a social space, we also still heal your Pokémon and offer access to the PC, for free!"), MSGBOX_DEFAULT)
	}
	setspeaker("Joy")
	msgbox(format("Welcome! Should I heal your Pokémon?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		closemessage
		incrementgamestat(GAME_STAT_USED_POKECENTER)
		hidefollower(0)
		fadescreenswapbuffers(FADE_TO_BLACK)
		playfanfare(MUS_HEAL)
		waitfanfare
		special(HealPlayerParty)
		fadescreenswapbuffers(FADE_FROM_BLACK)
		callnative(UpdateFollowingPokemon)
		applymovement(LOCALID_JOY, Movement_PkmnCenterNurse_Bow)
		waitmovement(0)
		setspeaker("Joy")
		msgbox(format("Your Pokémon have been restored. See you next time!"), MSGBOX_AUTOCLOSE)
		applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
		waitmovement(0)
	}
	release
	end
}

script EventScript_AfterWhiteOutHeal_PBL {
	lockall
	if (flag(FLAG_SETTINGS_NUZLOCKE)) {
		msgbox(format("You have wiped. {COLOR GREEN}Nuzlocke{COLOR DARK_GRAY} mode turned off."))
		clearflag(FLAG_SETTINGS_NUZLOCKE)
	}
	setspeaker("Joy")
	msgbox(format("First, let's restore your Pokémon to full health."))
	call(EventScript_PkmnCenterNurse_TakeAndHealPkmn)
	setspeaker("Joy")
	msgbox(format("Your Pokémon have been healed to perfect health.\pYou can always speak to Colress to decrease the difficulty.\pWe hope you excel!"))
	applymovement(VAR_LAST_TALKED, Movement_PkmnCenterNurse_Bow)
	waitmovement(0)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
	waitmovement(0)
	fadedefaultbgm
	releaseall
	end
}

script EventScript_Chansey {
	lock
	faceplayer
	setspeaker("Chansey")
	playmoncry(SPECIES_CHANSEY, CRY_MODE_NORMAL)
	msgbox(format("Chan!"))
	waitmoncry
	release
	end
}

script EventScript_SavesQuestBoy {
	lock
	faceplayer
	specialvar(VAR_TEMP_0, GetGameStatSavedGame)
	buffernumberstring(0, VAR_TEMP_0)
	if (checkitem(ITEM_EXP_SHARE) == FALSE) {
		msgbox(format("Saving your progress is important while playing games.\pI learned that the hard way!\pDon't be like me!\pI'll give you something if you can save your game 50 times!"))
		if (var(VAR_TEMP_0) >= 50) {
			msgbox(format("Wow!\pYou've saved your game {STR_VAR_1} times!\pThat's amazing!\pHere, as a reward, take this nifty {COLOR GREEN}Exp. Share{COLOR DARK_GRAY}!\pIt lets you toggle the Exp. All setting on or off."))
			giveitem(ITEM_EXP_SHARE)
			release
			end
		}
	}
	msgbox(format("You've saved your game {STR_VAR_1} times so far!\pDon't forget to save your game!"))
	release
	end
}

script EventScript_PokedexQuestScientist {
	lock
	faceplayer
	msgbox(format("Kids these days are always neglecting filling their Pokédex!\pIf you can show me a Pokédex that's seen all the Pokémon in existence, I'll reward you!"))
	msgbox(format("Seeing all the Pokémon is tough enough.\pImagine capturing them all!"))
	release
	end
}

script EventScript_FindHiddenQuest {
	lock
	faceplayer
	specialvar(VAR_TEMP_0, GetGameStatFoundHiddenItem)
	buffernumberstring(0, VAR_TEMP_0)
	if (checkitem(ITEM_METEORITE) == FALSE) {
		msgbox(format("When you're out and about, you might be able to find a hidden item in a lone grass tile or a rock!\pIf you can show me you've found 100 hidden items, I'll give you a sweet reward."))
		if (var(VAR_TEMP_0) >= 100) {
			msgbox(format("Wow!\pYou've found a total of {STR_VAR_1} hidden items!\pThat's amazing!\pHere, as a reward, take this nifty {COLOR GREEN}Exp. Share{COLOR DARK_GRAY}!\pIt lets you toggle the Exp. All setting on or off."))
			// giveitem(ITEM_METEORITE)
			release
			end
		}
	}
	msgbox(format("You've found a total of {STR_VAR_1} hidden items so far!"))
	release
	end
}

script EventScript_OldMan_PriorZone {
	lock
	faceplayer
	if (var(VAR_ZONE) == 1) {
		msgbox(format("Looking to access a prior Zone?\pHm, it seems you have not completed any Zones yet. Come back when you have."))
		release
		end
	}
	message(format("Looking to access a prior Zone?\nIt will cost you ¥1000."))
	waitmessage
	setvar(VAR_TEMP_0, 1)
	while (var(VAR_TEMP_0) != VAR_ZONE) {
		call(EventScript_BufferZoneName)
		dynmultipush("{STR_VAR_1}", VAR_TEMP_0)
		addvar(VAR_TEMP_0, 1)
	}
	dynmultipush("Cancel", 0)
	dynmultistack(0, 0, FALSE, 6, FALSE, 1, DYN_MULTICHOICE_CB_NONE)
	switch (var(VAR_RESULT)) {
		case 0:
		case MULTI_B_PRESSED:
			release
			end
		default:
			copyvar(VAR_TEMP_0, VAR_RESULT)
	}
	showmoneybox(18, 0)
	call(EventScript_BufferZoneName)
	msgbox(format("Are you sure you want to go to {STR_VAR_1}?\lIt will cost you ¥1000."), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		hidemoneybox
		release
		end
	}
	if (checkmoney(1000) == FALSE) {
		msgbox(gText_YouDontHaveEnoughMoney)
		hidemoneybox
		release
		end
	}
	removemoney(1000)
	updatemoneybox
	msgbox(format("Thank you very much…"), MSGBOX_DEFAULT)
	closemessage
	getplayerxy(VAR_TEMP_2, VAR_TEMP_1)
	if (var(VAR_TEMP_2) == 15) {
		applymovement(LOCALID_OLD_MAN, Common_Movement_WalkDown)
		applymovement(LOCALID_PLAYER, Common_Movement_WalkRight)
		waitmovement(0)
		applymovement(LOCALID_OLD_MAN, Common_Movement_FaceUp)
		waitmovement(0)
	} elif (var(VAR_TEMP_2) == 16) {
		applymovement(LOCALID_OLD_MAN, Common_Movement_WalkLeft)
		applymovement(LOCALID_PLAYER, Common_Movement_WalkUp)
		waitmovement(0)
		applymovement(LOCALID_OLD_MAN, Common_Movement_FaceRight)
		waitmovement(0)
	} else {
		applymovement(LOCALID_OLD_MAN, Common_Movement_WalkDown)
		applymovement(LOCALID_PLAYER, Common_Movement_WalkLeft)
		waitmovement(0)
		applymovement(LOCALID_OLD_MAN, Common_Movement_FaceUp)
		waitmovement(0)
	}
	setflag(FLAG_IS_REVISITING_ZONE)
	switch (var(VAR_TEMP_0)) {
		case 1:
			warpdoor(MAP_ZONE1A, WARP_ZONE_1)
		case 2:
			warpdoor(MAP_ZONE2A, WARP_ZONE_2)
		case 3:
			warpdoor(MAP_ZONE3A, WARP_ZONE_3)
		case 4:
			warpdoor(MAP_ZONE4A, WARP_ZONE_4)
		case 5:
			warpdoor(MAP_ZONE5A, WARP_ZONE_5)
		case 6:
			warpdoor(MAP_ZONE6A, WARP_ZONE_6)
		case 7:
			warpdoor(MAP_ZONE7A, WARP_ZONE_7)
		case 8:
			warpdoor(MAP_ZONE8A, WARP_ZONE_8)
		case 9:
			warpdoor(MAP_ZONE9A, WARP_ZONE_9)
		case 10:
			warpdoor(MAP_ZONE10A, WARP_ZONE_10)
		case 11:
			warpdoor(MAP_ZONE11A, WARP_ZONE_11)
		case 12:
			warpdoor(MAP_ZONE12A, WARP_ZONE_12)
		case 13:
			warpdoor(MAP_ZONE13A, WARP_ZONE_13)
		case 14:
			warpdoor(MAP_ZONE14A, WARP_ZONE_14)
		case 15:
			warpdoor(MAP_ZONE15A, WARP_ZONE_15)
		case 16:
			warpdoor(MAP_ZONE16A, WARP_ZONE_16)
		case 17:
			warpdoor(MAP_ZONE17A, WARP_ZONE_17)
		case 18:
			warpdoor(MAP_ZONE18A, WARP_ZONE_18)
		case 19:
			warpdoor(MAP_ZONE19A, WARP_ZONE_19)
		case 20:
			warpdoor(MAP_ZONE20A, WARP_ZONE_20)
		case 21:
			warpdoor(MAP_ZONE21A, WARP_ZONE_21)
		case 22:
			warpdoor(MAP_ZONE22A, WARP_ZONE_22)
		case 23:
			warpdoor(MAP_ZONE23A, WARP_ZONE_23)
		case 24:
			warpdoor(MAP_ZONE24A, WARP_ZONE_24)
		case 25:
			warpdoor(MAP_ZONE25A, WARP_ZONE_25)
		case 26:
			warpdoor(MAP_ZONE26A, WARP_ZONE_26)
		case 27:
			warpdoor(MAP_ZONE27A, WARP_ZONE_27)
		case 28:
			warpdoor(MAP_ZONE28A, WARP_ZONE_28)
		case 29:
			warpdoor(MAP_ZONE29A, WARP_ZONE_29)
		case 30:
			warpdoor(MAP_ZONE30A, WARP_ZONE_30)
		case 31:
			warpdoor(MAP_ZONE31A, WARP_ZONE_31)
		case 32:
			warpdoor(MAP_ZONE32A, WARP_ZONE_32)
		case 33:
			warpdoor(MAP_ZONE33A, WARP_ZONE_33)
		case 34:
			warpdoor(MAP_ZONE34A, WARP_ZONE_34)
		case 35:
			warpdoor(MAP_ZONE35A, WARP_ZONE_35)
	}
	waitstate
	release
	end
