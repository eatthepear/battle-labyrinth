mapscripts Zone25G_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_ICE_STEP_COUNT, 0: EventScript_FallDownHole
	]
    MAP_SCRIPT_ON_TRANSITION {
		call(CaveHole_FixCrackedGround)
    }
	MAP_SCRIPT_ON_RESUME {
        setstepcallback(STEP_CB_CRACKED_FLOOR)
	    setholewarp(MAP_ZONE25H)
	}
}

raw `
Zone25G_EventScript_KingsRock::
	finditem ITEM_KINGS_ROCK
	end

Zone25G_EventScript_4000::
	lock
	showmoneybox 0, 0, 0
	addmoney 4000, 0
	playfanfare MUS_OBTAIN_ITEM
	msgbox Zone25G_Text_Found4000, MSGBOX_DEFAULT
	updatemoneybox
	waitfanfare
	hidemoneybox
	setflag FLAG_ITEM_ZONE25G_4000
	removeobject 2
	release
	end

Zone25G_Text_Found4000:
	.string "Found ¥4000!$"
`

script Zone25G_EventScript_RocketGrunt_1 {
	trainerbattle_single(TRAINER_PBL_ROCKET_GRUNT_25G_1, format("BATTLE!"), format("DEFEAT!"))
	msgbox(format("DEFEATED!"), MSGBOX_AUTOCLOSE)
	end
}
