mapscripts Zone20B_New_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_ZONE_20_STATE, 0: Zone20B_EventScript_TriggerCoriExplanation
	]
}

script Zone20B_EventScript_TriggerCoriExplanation {
    lockall
	applymovement(LOCALID_CORI_20B, Common_Movement_FaceDown)
	waitmovement(0)
	applymovement(LOCALID_CORI_20B, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	applymovement(LOCALID_CORI_20B, Common_Movement_WalkDown2)
	waitmovement(0)
    setspeaker("Cori")
    msgbox(format("EXPLANATION!"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_CORI_20B, Common_Movement_WalkUp2)
	waitmovement(0)
    setvar(VAR_ZONE_20_STATE, 1)
    releaseall
    end
}

script Zone20B_EventScript_Cori {
    lock
    faceplayer
    msgbox(format("HI!"))
    release
    end
}

script Zone20B_EventScript_Cilan {
    lock
    faceplayer
    if (flag(FLAG_BEAT_BOSS_20)) {
        setspeaker("Cilan")
        msgbox(format("YOU BEAT US!"))
        release
        end
    }
    if (defeated(TRAINER_PBL_WALKER) && defeated(TRAINER_PBL_NATALIA) && defeated(TRAINER_PBL_DUNCAN) && defeated(TRAINER_PBL_EVALINE)) {
        setspeaker("Cilan")
        msgbox(format("DEFEATED ALL! TIME TO BATTLE?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            msgbox(format("INTRO TEXT! EXPLAIN GIMMICK!"))
            msgbox(format("YOU WANT TO BE PARTNERS WITH ME AGAINST MY BROTHERS, RIGHT?"), MSGBOX_YESNO)
            if (var(VAR_RESULT) == YES) {
                msgbox(format("GREAT! LET'S GO BATTLE!"), MSGBOX_AUTOCLOSE)
                fadescreenswapbuffers(FADE_TO_BLACK)
                special(SpawnCameraObject)
                applymovement(LOCALID_CAMERA, Common_Movement_WalkDown)
                waitmovement(0)
                special(RemoveCameraObject)
                goto(Zone20B_EventScript_StartBossBattle)
            } else {
                msgbox(format("SO SAD! LET ME KNOW IF YOU CHANGE MIND!"))
            }
            release
            end
        }
        setspeaker("Cilan")
        msgbox(format("SAY WHEN READY TO BATTLE!"))
        release
        end
    }
    setspeaker("Cilan")
    msgbox(format("NEED BEAT ALL STAFF!"))
    release
    end
}

