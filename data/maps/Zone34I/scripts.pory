mapscripts Zone34I_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		if (defeated(TRAINER_PBL_ARCHIE_BOSS_34)) {
			setmetatile(1, 3, METATILE_RocketCastle_Warp, 0)
		}
    }
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_ZONE_34_STATE_ARCHIE, 1: Zone34I_EventScript_ArchieBattle
	]
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_1, 0 {
            setvar(VAR_TEMP_1, 1)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
        }
    ]
}

script Zone34I_EventScript_ArchieBattle {
    lockall
    applymovement(LOCALID_PLAYER, Common_Movement_WalkUp3)
    setspeaker("???")
    msgbox(format("Hmm"))
    applymovement(LOCALID_ARCHIE, Common_Movement_FaceDown)
    waitmovement(0)
    setspeaker("???")
    msgbox(format("ARCHIE!"))
    closemessage
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_ARCHIE_BOSS_34, format("DEFEAT!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
    setspeaker("Archie")
    msgbox(format("DEFEAT!"))
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, Zone34I_Camera_MoveLeftUp)
    waitmovement(0)
    setmetatile(1, 3, METATILE_RocketCastle_Warp, 0)
    playse(SE_EXP_MAX)
    special(DrawWholeMapView)
    waitse
    delay(10)
    applymovement(LOCALID_CAMERA, Zone34I_Camera_MoveRightDown)
    waitmovement(0)
    special(RemoveCameraObject)
    setvar(VAR_ZONE_34_STATE_ARCHIE, 2)
    releaseall
}

movement Zone34I_Camera_MoveLeftUp {
    walk_diag_northwest * 2
}

movement Zone34I_Camera_MoveRightDown {
    walk_diag_southeast * 2
}
