mapscripts Zone14A_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE14A_DRAGON_FANG)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
	}
}

script Zone14A_EventScript_DragonFang {
	lock
	if (flag(FLAG_ITEM_ZONE14A_DRAGON_FANG)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE14A_DRAGON_FANG)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_DRAGON_FANG)
	release
	end
}

script Zone14A_EventScript_MagmaGrunt1 {
	trainerbattle_single(TRAINER_PBL_MAGMA_GRUNT_14A_1, format("Magma!"), format("Magma!"))
	msgbox(format("Magma!"), MSGBOX_AUTOCLOSE)
	end
}

