mapscripts Zone25L_MapScripts {}

script Zone25L_EventScript_TriggerBoss {
	lockall
	playbgm(MUS_HG_ENCOUNTER_ROCKET, TRUE)
	getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
	if (var(VAR_TEMP_0) == 5) {
		applymovement(LOCALID_PLAYER, Common_Movement_WalkRight)
		waitmovement(0)
	} elif (var(VAR_TEMP_0) == 7) {
		applymovement(LOCALID_PLAYER, Common_Movement_WalkLeft)
		waitmovement(0)
	}
	applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
	waitmovement(0)
	applymovement(LOCALID_ARIANA_25L, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	applymovement(LOCALID_ARIANA_25L, Common_Movement_WalkDown2)
	waitmovement(0)
	setspeaker("???")
	msgbox(format("So! Here's the child that defeated both {COLOR BLUE}Proton{COLOR DARK_GRAY} and {COLOR BLUE}Archer{COLOR DARK_GRAY}.\pMost impressive. My name is {COLOR BLUE}Ariana{COLOR DARK_GRAY}."))
	setspeaker("Ariana")
	msgbox(format("As you may have guessed, I am an {COLOR GREEN}Executive{COLOR DARK_GRAY} of {COLOR GREEN}Team Rainbow Rocket{COLOR DARK_GRAY}, the most fearsome organization in all realities.\pWe've taken control of worlds and subsumed other organizations, making them and their resources work for us.\pYou're just a child. You need to be taught a lesson for standing in the way."))
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_ARIANA_BOSS_25, format("Tch, you really are strong. It's too bad. If you were to join Team Rocket, you could become an Executive."))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Ariana")
	msgbox(format("Losing here is fine.\pWe were already able to accomplish our goal of capturing Fossil Pokémon for us to use.\pIt doesn't matter what happens to this tower now. We have much bigger plans.\pYou'll come to appreciate {COLOR GREEN}Team Rainbow Rocket{COLOR DARK_GRAY}'s true power soon enough.\pEnjoy yourself while you can… Hee hee hee…"))
	closemessage
	fadescreenswapbuffers(FADE_TO_BLACK)
	removeobject(LOCALID_ARIANA_25L)
	setvar(VAR_ZONE_25_STATE, 1)
	setflag(FLAG_BEAT_BOSS_25)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	msgbox(format("There's something on the ground where she was standing…"))
	giveitem(ITEM_TM_TAUNT)
	closemessage
	savebgm(MUS_DUMMY)
	fadedefaultbgm
	release
	end
}
