mapscripts Zone3A_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE3A_RANDOM_1)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE3A_RANDOM_2)) {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE3A_RANDOM_3)) {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE3A_HYPER_POTION)) {
			setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ITEM_CHEST)
		}
	}
}

script Zone3A_EventScript_Grant {
	lock
	faceplayer
	if (flag(FLAG_BEAT_LEVIATHAN_3)) {
		setspeaker("Grant")
		msgbox(format("I see your potential. You can do anything you set your heart to!\pThere are other Gym Leaders, stronger than I am. Perhaps defeating them will prove a worthy challenge!"))
		release
		end
	}
	setspeaker("Grant")
	msgbox(format("I've been waiting in eager anticipation!\pWhat have I been waiting for?\pFor a worthy challenger to appear!\pAre you that worthy challenger?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		msgbox(format("Don't keep me waiting any longer than needed!\pTake a deep breath, and prepare yourself for the climb!"), MSGBOX_AUTOCLOSE)
		releaseall
		end
	}
	msgbox(format("I have a feeling that our battle will turn out to be worth the wait!\pI hope you'll show me that your skill as a Trainer surpasses even mine."))
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_GRANT_LEVIATHAN_3, format("You have proven to be a wall that I am unable to surmount!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Grant")
	msgbox(format("There are some things that seem out of reach no matter how hard you try.\pHowever, it's important that you never give up - no matter the opponent or the odds.\pI could tell from our battle that you and your Pokémon understand that.\pTo commemorate such an impressive show of teamwork, please accept the Cliff Badge!"))
	setspeaker(SP_NAME_NONE)
	playfanfare(MUS_OBTAIN_BADGE)
	msgbox(format("{PLAYER} received the Cliff Badge from Grant!"))
	waitfanfare
	setspeaker("Grant")
	msgbox(format("With the Cliff Badge in your grasp, you should have no issues using the HM {COLOR GREEN}Rock Smash{COLOR DARK_GRAY} outside battle!\pYour Pokémon don't need to know the move to use it, just having the HM and the requisite Gym Badge is enough!\pAh, finally, I'd like you to take these as well."))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_TM_ROCK_TOMB, 1)
	giveitem(ITEM_EVIOLITE, 1)
	msgbox(format("With Rock Tomb, a Pokémon can hurl rocks at its target, not only inflicting damage but also lowering the target's Speed.\pAnd the Eviolite is a pretty nifty item for your Pokémon that can still evolve.\pWhich should be most of your Pokémon, yeah?\pHaha, just playing with you! You're just starting on your journey, so enjoy the ride and feel the breeze in your face!"))
	setflag(FLAG_BEAT_LEVIATHAN_3)
	setflag(FLAG_BADGE01_GET)
	release
	end
}

script Zone3A_EventScript_GymGuide {
    lock
    faceplayer
	if (flag(FLAG_BEAT_LEVIATHAN_3)) {
		msgbox(format("Hey, congrats! You beat Grant! I knew you could do it!"))
	} else {
    	msgbox(format("Hey there!\pI'm Gym Leader Grant's personal Gym Guide, which means I help out would be challengers like you!\pYou'd do well to be prepared to battle some Rock-type Pokémon. I recommend using super-effective moves like {COLOR GREEN}Rock Smash{COLOR DARK_GRAY}!"))
	}
    release
    end
}

script Zone3A_EventScript_Phillipa {
	lock
	faceplayer
	setspeaker("Phillipa")
	msgbox(format("I heard there's a move like {COLOR GREEN}Rollout{COLOR DARK_GRAY}, but Ice-type instead.\pThat sounds pretty neat!"))
	release
	end
}

script Zone3A_EventScript_TriggerPhillipaLeft {
	lockall
	applymovement(LOCALID_PHILLIPA, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	applymovement(LOCALID_PHILLIPA, Common_Movement_WalkLeft)
	waitmovement(0)
	call(Zone3A_EventScript_TriggerPhillipa)
	applymovement(LOCALID_PHILLIPA, Common_Movement_WalkRight)
	waitmovement(0)
	releaseall
	end
}

script Zone3A_EventScript_TriggerPhillipaRight {
	lockall
	applymovement(LOCALID_PHILLIPA, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	call(Zone3A_EventScript_TriggerPhillipa)
	releaseall
	end
}

script Zone3A_EventScript_TriggerPhillipa {
	applymovement(LOCALID_PHILLIPA, Common_Movement_WalkDown3)
	waitmovement(0)
	setspeaker("Phillipa")
	msgbox(format("This right here is my island! You gotta deal with it!\pSomething about the look in your eyes says you're gonna challenge me for it.\pIf you wanna battle, I'll go all out with {COLOR GREEN}Rollout{COLOR DARK_GRAY}!"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		msgbox(format("Aha! You're scared! Go away, scaredy cat!"), MSGBOX_AUTOCLOSE)
		applymovement(LOCALID_PLAYER, Common_Movement_WalkDown)
		waitmovement(0)
		applymovement(LOCALID_PHILLIPA, Common_Movement_WalkUp3)
		waitmovement(0)
		return
	}
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_PHILLIPA_OPTIONAL_1, format("Wah!!!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Phillipa")
	msgbox(format("You beat me! No fair! Argh…\pFine, you can explore this island too.\pHave that {COLOR GREEN}Rare Candy{COLOR DARK_GRAY} too while you're at it!"), MSGBOX_AUTOCLOSE)
	setvar(VAR_ZONE_3_STATE, 1)
	applymovement(LOCALID_PHILLIPA, Common_Movement_WalkUp3)
	waitmovement(0)
	releaseall
	end
}

script Zone3A_EventScript_Trade {
	lock
	faceplayer
	if (flag(FLAG_ZONE3A_TRADE)) {
		msgbox(Zone3A_Text_BeGood)
		release
		end
	}
	setvar(VAR_0x8008, INGAME_TRADE_FARFETCHD_PBL)
	copyvar(VAR_0x8004, VAR_0x8008)
	specialvar(VAR_RESULT, GetInGameTradeSpeciesInfo)
	copyvar(VAR_0x8009, VAR_RESULT)
	msgbox(format("Hey! Are you a {STR_VAR_2} fan?\pIf so, let's trade {STR_VAR_2}s!\pI'll trade you a Galarian {STR_VAR_1} for a Kantonian {STR_VAR_1}!"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		msgbox(Zone3A_Text_ComeBack)
		release
		end
	}
	special(ChoosePartyMon)
	copyvar(VAR_0x800A, VAR_0x8004)
	if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
		msgbox(Zone3A_Text_ComeBack)
		release
		end
	}
	specialvar(VAR_RESULT, IsPokemonFainted)
	if (var(VAR_RESULT) == TRUE) {
		msgbox(format("Hey! Don't trade me a fainted Pokémon!"))
		release
		end
	}
	copyvar(VAR_0x8005, VAR_0x800A)
	specialvar(VAR_RESULT, GetTradeSpecies)
	copyvar(VAR_0x800B, VAR_RESULT)
	if (var(VAR_RESULT) != VAR_0x8009) {
		bufferspeciesname(STR_VAR_1, VAR_0x8009)
		msgbox(format("Huh? That doesn't look anything like a {STR_VAR_1} to me."), MSGBOX_DEFAULT)
		release
		end
	}
	copyvar(VAR_0x8004, VAR_0x8008)
	copyvar(VAR_0x8005, VAR_0x800A)
	special(CreateInGameTradePokemon)
	special(DoInGameTradeScene)
	msgbox(Zone3A_Text_BeGood)
	setflag(FLAG_ZONE3A_TRADE)
	release
	end
}

text Zone3A_Text_ComeBack {
	format("Come back with a Kantonian Farfetch'd if you want to trade!")
}

text Zone3A_Text_BeGood {
	format("Please be good to my Farfetch'd!\pI wish I had a {COLOR RED}Notebook{COLOR DARK_GRAY} to see how to evolve a Galarian Farfetch'd…")
}

script Zone3A_EventScript_Random1 {
	lock
	if (flag(FLAG_ITEM_ZONE3A_RANDOM_1)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE3A_RANDOM_1)
	addobject(VAR_LAST_TALKED)
	specialvar(VAR_TEMP_1, RandomItemChest)
	finditem(VAR_TEMP_1, VAR_TEMP_0)
	release
	end
}

