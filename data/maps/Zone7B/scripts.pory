mapscripts Zone7B_MapScripts {}

script Zone7B_EventScript_BossBattle {
	lock
	faceplayer
	if (flag(FLAG_ZONE7B_DEFEATED_OPTIONAL) == true) {
		setspeaker("Betty")
		msgbox(Zone7B_Text_BettyPost)
		release
		end
	}
	setspeaker("Betty")
	msgbox(format("Ah, another traveler. I grow tired of sitting around nibbling on Berries.\pCare to entertain a lady like me with a battle?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		setspeaker("Betty")
		msgbox(format("Well, I will be here, if you change your mind."))
		release
		end
	}
	fadeoutbgm(1)
	setspeaker("Betty")
	msgbox(format("I will show you how to behave in the prim and proper way!"), MSGBOX_DEFAULT)
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_BETTY_OPTIONAL_7, format("It seems I was the one who ended up being humbled…"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	faceplayer
	setspeaker("Betty")
	msgbox(format("Your battling skills are certainly up to par. Excellent form.\pI'd like to give you this TM.\pVery, very expensive, or so my butler tells me."), MSGBOX_AUTOCLOSE)
	giveitem(ITEM_TM_NATURAL_GIFT)
	setflag(FLAG_ZONE7B_DEFEATED_OPTIONAL)
	setspeaker("Betty")
	msgbox(Zone7B_Text_BettyPost)
	release
	end
}

text Zone7B_Text_BettyPost {
	format("{COLOR GREEN}Natural Gift{COLOR DARK_GRAY} is a great TM to use with Berries!\pIt consumes a held Berry to deal damage, and changes type and power based on the type of berry!\pI know a Pecha Berry deals Electric damage and a Cheri Berry deals Fire damage.\pCounterintuitive, right?")
}

script Zone7B_EventScript_Lady {
	lock
	faceplayer
	if ((flag(FLAG_ZONE7B_HEAL_USED) == FALSE) && (var(VAR_DIFFICULTY) < DIFFICULTY_BRUTAL)) {
		msgbox(format("Greetings, child.\nTo ease your journey, you may rest at my humble home.\pHowever, I only have enough medicine to heal your Pokémon once.\pWould you like to rest, child?"), MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			msgbox(format("Rest well, child."), MSGBOX_AUTOCLOSE)
			fadescreen(FADE_TO_BLACK)
			playfanfare(MUS_HEAL)
			waitfanfare
			special(HealPlayerParty)
			fadescreen(FADE_FROM_BLACK)
			setflag(FLAG_ZONE7B_HEAL_USED)
		} else {
			msgbox(format("Come back when you need to rest, child."))
			release
			end
		}
	}
	msgbox(format("Best of luck on your journey, child."))
	release
	end
}
