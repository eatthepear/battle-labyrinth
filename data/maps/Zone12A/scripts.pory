mapscripts Zone12A_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE12A_TM_BRICK_BREAK)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE12A_THUNDER_STONE)) {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE12A_RANDOM_1)) {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE12A_WATER_STONE)) {
			setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE12A_TM_SMART_STRIKE)) {
			setvar(VAR_OBJ_GFX_ID_4, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_4, OBJ_EVENT_GFX_TM_CHEST)
		}
	}
}

script Zone12A_EventScript_KimonoGirl {
	lock
	msgbox(format("She doesn't even notice you.\pShe appears to be trembling."))
	release
	end
}

script Zone12A_EventScript_TriggerKimonoGirl {
	lockall
	playbgm(MUS_HG_KIMONO_GIRL, 0)
	applymovement(LOCALID_KIMONO_GIRL_12A, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	applymovement(LOCALID_KIMONO_GIRL_12A, Common_Movement_FaceUp)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
	waitmovement(0)
	setspeaker("Kimono Girl")
	msgbox(format("Uh… Uh… excuse me…\pWould you be able to help me across this bridge?"), MSGBOX_AUTOCLOSE)
	setspeaker(SP_NAME_NONE)
	msgbox(format("{PLAYER} agreed to help the Kimono Girl!"))
	setspeaker("Kimono Girl")
	msgbox(format("Thank you…\nLet's make our way across… slowly…"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_KIMONO_GIRL_12A, Common_Movement_WalkRight5)
	applymovement(LOCALID_PLAYER, Common_Movement_WalkRight5)
	waitmovement(0)
	setspeaker("Kimono Girl")
	msgbox(format("Phew… We made it…"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_KIMONO_GIRL_12A, Common_Movement_FaceUp)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
	waitmovement(0)
	delay(32)
	setspeaker("Kimono Girl")
	msgbox(format("Thank you for your help.\pI'm scared of water and can get in a nervous state, but you just need a little help to snap out of it.\pHere, take this item. It can help your Pokémon resist uncommon effects."), MSGBOX_AUTOCLOSE)
	giveitem(ITEM_MENTAL_HERB)
	setspeaker("Kimono Girl")
	msgbox(format("I will see you around…"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_KIMONO_GIRL_12A, Common_Movement_WalkRight2)
	waitmovement(0)
	applymovement(LOCALID_KIMONO_GIRL_12A, Common_Movement_WalkDown6)
	waitmovement(0)
	setflag(FLAG_HIDE_ZONE12A_KIMONO_GIRL)
	removeobject(LOCALID_KIMONO_GIRL_12A)
	setvar(VAR_ZONE_12_STATE, 1)
	fadedefaultbgm
	releaseall
	end
}

script Zone12A_EventScript_Inver {
	lock
	faceplayer
	if (flag(FLAG_BEAT_BOSS_12) == TRUE) {
		setspeaker("Inver")
		msgbox(Zone12A_Text_Inver_Post)
		release
		end
	}
	setspeaker("Inver")
	msgbox(format("My Pokémon love to eat, just like me!"))
	if (!defeated(TRAINER_PBL_GENIE) || !defeated(TRAINER_PBL_ABIGAIL) || !defeated(TRAINER_PBL_CELIA)) {
		setspeaker("Inver")
		msgbox(format("Tell you what, if you go and defeat all four of my friends around the farm, I'll show you just how much my Pokémon can eat!"))
		release
		end
	}
	setspeaker("Inver")
	msgbox(format("My friends tell me you've defeated every last one of them!\pAre you interested in a battle? I'll show you just how much my Pokémon can eat!"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		setspeaker("Inver")
		msgbox(format("Oh, all right…"))
		release
		end
	}
	closemessage
	fadeoutbgm(1)
	setspeaker("Inver")
	msgbox(format("All right then, let's battle!"))
	setflag(FLAG_SYS_INVERSE_BATTLE)
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_INVER_BOSS_12, format("Ack! I lost again!\pDoggone it!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	clearflag(FLAG_SYS_INVERSE_BATTLE)
	setspeaker("Inver")
	msgbox(format("Even after all those Berries, it wasn't enough to get across the finish line.\pThat's all right though! I enjoyed our battle so much, I want to give you this!"))
	setspeaker(SP_NAME_NONE)
	msgbox(format("Obtained resist berries!"))
	additem(ITEM_CHILAN_BERRY)
    additem(ITEM_OCCA_BERRY)
    additem(ITEM_PASSHO_BERRY)
    additem(ITEM_WACAN_BERRY)
    additem(ITEM_RINDO_BERRY)
    additem(ITEM_YACHE_BERRY)
    additem(ITEM_CHOPLE_BERRY)
    additem(ITEM_KEBIA_BERRY)
    additem(ITEM_SHUCA_BERRY)
    additem(ITEM_COBA_BERRY)
    additem(ITEM_PAYAPA_BERRY)
    additem(ITEM_TANGA_BERRY)
    additem(ITEM_CHARTI_BERRY)
    additem(ITEM_KASIB_BERRY)
    additem(ITEM_HABAN_BERRY)
    additem(ITEM_COLBUR_BERRY)
    additem(ITEM_BABIRI_BERRY)
    additem(ITEM_ROSELI_BERRY)
	setflag(FLAG_BEAT_BOSS_12)
	removeobject(LOCALID_PSYDUCK_1)
	removeobject(LOCALID_PSYDUCK_2)
	removeobject(LOCALID_PSYDUCK_3)
	removeobject(LOCALID_PSYDUCK_4)
	removeobject(LOCALID_PSYDUCK_5)
	setspeaker("Inver")
	msgbox(Zone12A_Text_Inver_Post)
	release
	end
}

text Zone12A_Text_Inver_Post {
	format("POST")
}

script Zone12A_EventScript_Genie {
	lock
	faceplayer
	if (defeated(TRAINER_PBL_GENIE)) {
		msgbox(format("DEFEATED!"), MSGBOX_AUTOCLOSE)
		release
		end
	}
	msgbox(format("Battle?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		msgbox(format("Sad!"), MSGBOX_AUTOCLOSE)
		release
		end
	}
	msgbox(format("BATTLE!"))
	setflag(FLAG_SYS_INVERSE_BATTLE)
	trainerbattle_no_intro(TRAINER_PBL_GENIE, format("DEFEAT!"))
	clearflag(FLAG_SYS_INVERSE_BATTLE)
	msgbox(format("DEFEATED!"), MSGBOX_AUTOCLOSE)
	release
	end
}

