script Zone12A_EventScript_Hilda {
	trainerbattle_single(TRAINER_PBL_HILDA, format("How would you say if someone is rich or not?\pIs it by the amount of money one has in their bank account? In assets?"), format("People will label anyone as rich these days!"))
	msgbox(format("My family's business owns 61 hotels in the Kalos region.\pI'm not rich though, of course!\pI only own one of those hotels personally."), MSGBOX_AUTOCLOSE)
	end
}

