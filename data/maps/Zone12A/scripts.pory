mapscripts Zone12A_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE12A_TM_BRICK_BREAK)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE12A_THUNDER_STONE)) {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE12A_RANDOM_1)) {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE12A_WATER_STONE)) {
			setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE12A_TM_SMART_STRIKE)) {
			setvar(VAR_OBJ_GFX_ID_4, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_4, OBJ_EVENT_GFX_TM_CHEST)
		}
	}
}

script Zone12A_EventScript_KimonoGirl {
	lock
	msgbox(format("She doesn't even notice you.\pShe appears to be trembling."))
	release
	end
}

script Zone12A_EventScript_TriggerKimonoGirl {
	lockall
	playbgm(MUS_HG_KIMONO_GIRL, 0)
	applymovement(LOCALID_KIMONO_GIRL_12A, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	applymovement(LOCALID_KIMONO_GIRL_12A, Common_Movement_FaceUp)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
	waitmovement(0)
	setspeaker("Kimono Girl")
	msgbox(format("Uh… Uh… excuse me…\pWould you be able to help me across this bridge?"), MSGBOX_AUTOCLOSE)
	setspeaker(SP_NAME_NONE)
	msgbox(format("{PLAYER} agreed to help the Kimono Girl!"))
	setspeaker("Kimono Girl")
	msgbox(format("Thank you…\nLet's make our way across… slowly…"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_KIMONO_GIRL_12A, Common_Movement_WalkRight5)
	applymovement(LOCALID_PLAYER, Common_Movement_WalkRight5)
	waitmovement(0)
	setspeaker("Kimono Girl")
	msgbox(format("Phew… We made it…"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_KIMONO_GIRL_12A, Common_Movement_FaceUp)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
	waitmovement(0)
	delay(32)
	setspeaker("Kimono Girl")
	msgbox(format("Thank you for your help.\pI'm scared of water and can get in a nervous state, but you just need a little help to snap out of it.\pHere, take this item. It can help your Pokémon resist uncommon effects."), MSGBOX_AUTOCLOSE)
	giveitem(ITEM_MENTAL_HERB)
	setspeaker("Kimono Girl")
	msgbox(format("I will see you around…"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_KIMONO_GIRL_12A, Common_Movement_WalkRight2)
	waitmovement(0)
	applymovement(LOCALID_KIMONO_GIRL_12A, Common_Movement_WalkDown6)
	waitmovement(0)
	setflag(FLAG_HIDE_ZONE12A_KIMONO_GIRL)
	removeobject(LOCALID_KIMONO_GIRL_12A)
	setvar(VAR_ZONE_12_STATE, 1)
	fadedefaultbgm
	releaseall
	end
}

script Zone12A_EventScript_Inver {
	lock
	faceplayer
	if (flag(FLAG_BEAT_BOSS_12) == TRUE) {
		setspeaker("Inver")
		msgbox(Zone12A_Text_Inver_Post)
		release
		end
	}
	setspeaker("Inver")
	msgbox(format("Greetings! I am {COLOR GREEN}Proprietor Inver{COLOR DARK_GRAY}.\pHave you ever tried an {COLOR GREEN}Inverse Battle{COLOR DARK_GRAY}?\pIn an {COLOR GREEN}Inverse Battle{COLOR DARK_GRAY}, all type matchups are completely reversed.\pA Fire-type move, for example, will be not very effective on a Grass type Pokémon, and super effective on a Water type Pokémon."))
	if (!defeated(TRAINER_PBL_GENIE) || !defeated(TRAINER_PBL_ABIGAIL) || !defeated(TRAINER_PBL_CELIA)) {
		setspeaker("Inver")
		msgbox(format("If you find and defeat my three students scattered throughout this area, I could show you the joys of {COLOR GREEN}Inverse Battles{COLOR DARK_GRAY}!"))
		release
		end
	}
	setspeaker("Inver")
	msgbox(format("My students tell me they have all been defeated!\pSo you are ready for a showcase of how thrilling {COLOR GREEN}Inverse Battles{COLOR DARK_GRAY} can be"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		setspeaker("Inver")
		msgbox(format("This is most regrettable…"))
		release
		end
	}
	closemessage
	setspeaker("Inver")
	msgbox(format("Excellent! Let's get started!"))
	setflag(FLAG_SYS_INVERSE_BATTLE)
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_INVER_BOSS_12, format("My expectations were inverted!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	clearflag(FLAG_SYS_INVERSE_BATTLE)
	setspeaker("Inver")
	msgbox(format("That was an excellent battle!\pYou've clearly proved your mastery over {COLOR GREEN}Inverse Battles{COLOR DARK_GRAY}!\pFor your prize, I'd like to give you some special berries!"))
	setspeaker(SP_NAME_NONE)
	playfanfare(MUS_OBTAIN_ITEM)
	msgbox(format("Obtained type-resisting berries!"))
	waitfanfare
	additem(ITEM_CHILAN_BERRY)
    additem(ITEM_OCCA_BERRY)
    additem(ITEM_PASSHO_BERRY)
    additem(ITEM_WACAN_BERRY)
    additem(ITEM_RINDO_BERRY)
    additem(ITEM_YACHE_BERRY)
    additem(ITEM_CHOPLE_BERRY)
    additem(ITEM_KEBIA_BERRY)
    additem(ITEM_SHUCA_BERRY)
    additem(ITEM_COBA_BERRY)
    additem(ITEM_PAYAPA_BERRY)
    additem(ITEM_TANGA_BERRY)
    additem(ITEM_CHARTI_BERRY)
    additem(ITEM_KASIB_BERRY)
    additem(ITEM_HABAN_BERRY)
    additem(ITEM_COLBUR_BERRY)
    additem(ITEM_BABIRI_BERRY)
    additem(ITEM_ROSELI_BERRY)
	setflag(FLAG_BEAT_BOSS_12)
	removeobject(LOCALID_PSYDUCK_1)
	removeobject(LOCALID_PSYDUCK_2)
	removeobject(LOCALID_PSYDUCK_3)
	removeobject(LOCALID_PSYDUCK_4)
	removeobject(LOCALID_PSYDUCK_5)
	setspeaker("Inver")
	msgbox(Zone12A_Text_Inver_Post)
	release
	end
}

text Zone12A_Text_Inver_Post {
	format("Perhaps we will meet again in the future!\pI would love for you to show me your {COLOR GREEN}Inverse Battle{COLOR DARK_GRAY} skills again!")
}

script Zone12A_EventScript_Charles {
	lock
	faceplayer
	if (defeated(TRAINER_PBL_CHARLES_OPTIONAL_12)) {
		setspeaker("Charles")
		msgbox(format("I see your potential. You can do anything you set your heart to!\pThere are other Gym Leaders, stronger than I am. Perhaps defeating them will prove a worthy challenge!"))
		release
		end
	}
	setspeaker("Charles")
	msgbox(format("I've been waiting in eager anticipation!\pWhat have I been waiting for?\pFor a worthy challenger to appear!\pAre you that worthy challenger?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		msgbox(format("Don't keep me waiting any longer than needed!\pTake a deep breath, and prepare yourself for the climb!"), MSGBOX_AUTOCLOSE)
		releaseall
		end
	}
	msgbox(format("I have a feeling that our battle will turn out to be worth the wait!\pI hope you'll show me that your skill as a Trainer surpasses even mine."))
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_CHARLES_OPTIONAL_12, format("You have proven to be a wall that I am unable to surmount!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Charles")
	msgbox(format("With the Cliff Badge in your grasp, you should have no issues using the HM {COLOR GREEN}Rock Smash{COLOR DARK_GRAY} outside battle!\pYour Pokémon don't need to know the move to use it, just having the HM and the requisite Gym Badge is enough!\pAh, finally, I'd like you to take these as well."))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_TM_ACROBATICS, 1)
	setspeaker("Charles")
	msgbox(format("With {COLOR GREEN}Rock Tomb{COLOR DARK_GRAY}, a Pokémon can hurl rocks at its target, not only inflicting damage but also lowering the target's Speed.\pAnd the {COLOR GREEN}Hard Stone{COLOR DARK_GRAY} increases the damage of your Pokémon's Rock-type moves by 20%. Forms a nifty combo, huh?\pYou're just starting on your journey, so enjoy the ride and feel the breeze in your face!"))
	release
	end
}

script Zone12A_EventScript_Genie {
	lock
	faceplayer
	if (defeated(TRAINER_PBL_GENIE)) {
		msgbox(Zone12A_Text_Genie_Post)
		release
		end
	}
	msgbox(format("Yo! I'm one of Master {COLOR GREEN}Inver{COLOR DARK_GRAY}'s students.\pWhat does he teach? {COLOR GREEN}Inverse Battles{COLOR DARK_GRAY}, of course!\pIn an {COLOR GREEN}Inverse Battle{COLOR DARK_GRAY}, all type matchups are completely reversed.\pSay, do you want to try it out?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		msgbox(format("Yo! Not cool!\pCome back to battle soon!"), MSGBOX_AUTOCLOSE)
		release
		end
	}
	msgbox(format("Master {COLOR GREEN}Inver{COLOR DARK_GRAY}, I'll show you what I've learned!"))
	setflag(FLAG_SYS_INVERSE_BATTLE)
	trainerbattle_no_intro(TRAINER_PBL_GENIE, format("Well, that's a bummer!"))
	clearflag(FLAG_SYS_INVERSE_BATTLE)
	msgbox(Zone12A_Text_Genie_Post)
	release
	end
}

text Zone12A_Text_Genie_Post {
	format("Did you know?\p{COLOR GREEN}Inverse Battles{COLOR DARK_GRAY} don't perfectly invert the type chart.\pUnlike a normal battle, there's no immunities in an Inverse Battle, so types like Normal, Electric, or Ground might be especially powerful!")
}

script Zone12A_EventScript_Abigail {
	lock
	faceplayer
	if (defeated(TRAINER_PBL_ABIGAIL)) {
		msgbox(Zone12A_Text_Abigail_Post)
		release
		end
	}
	msgbox(format("Hey! I study under Master {COLOR GREEN}Inver{COLOR DARK_GRAY}, to learn about {COLOR GREEN}Inverse Battles{COLOR DARK_GRAY}!\pIn an {COLOR GREEN}Inverse Battle{COLOR DARK_GRAY}, all type matchups are completely reversed.\pWould you be interested in trying it out?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		msgbox(format("That's somewhat disappointing, but okay!"), MSGBOX_AUTOCLOSE)
		release
		end
	}
	msgbox(format("Master {COLOR GREEN}Inver{COLOR DARK_GRAY} has taught me a lot!"))
	setflag(FLAG_SYS_INVERSE_BATTLE)
	trainerbattle_no_intro(TRAINER_PBL_ABIGAIL, format("Knowledge isn't everything!"))
	clearflag(FLAG_SYS_INVERSE_BATTLE)
	msgbox(Zone12A_Text_Abigail_Post)
	release
	end
}

text Zone12A_Text_Abigail_Post {
	format("Just because I know the type matchups of an {COLOR GREEN}Inverse Battle{COLOR DARK_GRAY}, doesn't mean I can win every single battle!")
}

script Zone12A_EventScript_Celia {
	lock
	faceplayer
	if (defeated(TRAINER_PBL_CELIA)) {
		msgbox(Zone12A_Text_Celia_Post)
		release
		end
	}
	msgbox(format("Hi! Mr. {COLOR GREEN}Inver{COLOR DARK_GRAY} has been teaching me lots about {COLOR GREEN}Inverse Battles{COLOR DARK_GRAY}!\pIn an {COLOR GREEN}Inverse Battle{COLOR DARK_GRAY}, all type matchups are completely reversed.\pDo you maybe wanna try it out?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		msgbox(format("Aw! You're no fun!"), MSGBOX_AUTOCLOSE)
		release
		end
	}
	msgbox(format("I'll make Mr. {COLOR GREEN}Inver{COLOR DARK_GRAY} proud!"))
	setflag(FLAG_SYS_INVERSE_BATTLE)
	trainerbattle_no_intro(TRAINER_PBL_CELIA, format("The type matchups are so confusing!"))
	clearflag(FLAG_SYS_INVERSE_BATTLE)
	msgbox(Zone12A_Text_Celia_Post)
	release
	end
}

text Zone12A_Text_Celia_Post {
	format("So Normal-type attacks aren't resisted by anything, because Normal-type attacks aren't super effective normally… right?")
}

script Zone12A_EventScript_TMBrickBreak {
	lock
	if (flag(FLAG_ITEM_ZONE12A_TM_BRICK_BREAK)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE12A_TM_BRICK_BREAK)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_TM_BRICK_BREAK, 1)
	release
	end
}

