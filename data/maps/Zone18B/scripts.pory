script Zone18B_EventScript_SlideOpenRoomDoors {
	special(PetalburgGymSlideOpenRoomDoors)
	return
}

script Zone18B_EventScript_UnlockRoomDoors {
	special(PetalburgGymUnlockRoomDoors)
	return
}

script Zone18B_EventScript_Statue {
	msgbox("Trainer's Dojo\nEstablished 2021", MSGBOX_SIGN)
	end
}

script Zone18B_EventScript_Rachel {
	trainerbattle_single(TRAINER_PBL_RACHEL, format("Welcome to the Trainer's Dojo!\pUh… what else is in this script…\pOh! Each room has a particular type associated with it.\pYou can pick and choose which room to challenge.\pHmm… Looks like I'm supposed to battle you now.\pWell, good luck to you, facing my Grass-types in battle!"), format("You got me!"), Zone18B_EventScript_SlideOpenGrassRoomDoors)
	msgbox(format("You can pick between the Rock room and the Ice room."), MSGBOX_AUTOCLOSE)
	end
}

script Zone18B_EventScript_Glenn {
	trainerbattle_single(TRAINER_PBL_GLENN, format("Rock 'em, sock em!"), format("You rocked!"), Zone18B_EventScript_SlideOpenRockRoomDoors)
	msgbox(format("How many weaknesses do Rock-types have?\pI'll tell you: none, if you're careful about type matchups!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone18B_EventScript_Jay {
	trainerbattle_single(TRAINER_PBL_JAY, format("Welcome to the Cool Room. Speaking of cool, have you ever read the Great Gatsby?"), format("I'm not Gatsby!"), Zone18B_EventScript_SlideOpenIceRoomDoors)
	msgbox(format("I just think he's a pretty chill  dude."), MSGBOX_AUTOCLOSE)
	end
}

script Zone18B_EventScript_Tyler {
	trainerbattle_single(TRAINER_PBL_TYLER, format("You look tough, kid.\pCan you beat the toughest Dark-types around?"), format("I guess you can!"), Zone18B_EventScript_SlideOpenDarkRoomDoors)
	msgbox(format("I know I'm tough because my momma said so!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone18B_EventScript_Terrence {
	trainerbattle_single(TRAINER_PBL_TERRENCE, format("Take flight, my Pokémon, and defeat this Trainer!"), format("Our wings are clipped and our flight path broken!"), Zone18B_EventScript_SlideOpenFlyingRoomDoors)
	msgbox(format("My favorite board game is Wingspan. You should try it sometime!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone18B_EventScript_Marty {
	trainerbattle_single(TRAINER_PBL_MARTY, format("Through my powers, I see a great battle ahead of us…"), format("It wasn't a great battle because I lost!"), Zone18B_EventScript_SlideOpenPsychicRoomDoors)
	msgbox(format("Why don't my visions ever show me winning?"), MSGBOX_AUTOCLOSE)
	end
}

script Zone18B_EventScript_Kari {
	trainerbattle_single(TRAINER_PBL_KARI, format("Fight me!"), format("The taste of defeat is bitter!"), Zone18B_EventScript_SlideOpenFightingRoomDoors)
	msgbox(format("I'll have to train more for next time!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone18B_EventScript_Abraham {
	trainerbattle_single(TRAINER_PBL_ABRAHAM, format("Dragons can inspire fear or reverence in different cultures.\pWhich one is it for you?"), format("Personally, I fear them. Well, when they evolve more."), Zone18B_EventScript_SlideOpenDragonRoomDoors)
	msgbox(format("Evolution won't be for a while, though!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone18B_EventScript_Melinda {
	trainerbattle_single(TRAINER_PBL_MELINDA, format("Momma… where are you?"), format("She'll be with me soon…"), Zone18B_EventScript_SlideOpenFairyRoomDoors)
	msgbox(format("We'll be together again, like we were meant to be…"), MSGBOX_AUTOCLOSE)
	end
}

script Zone18B_EventScript_Emilio {
	trainerbattle_single(TRAINER_PBL_EMILIO, format("Stone and sand! Stone and sand!"), format("Our boulders have been reduced to pebbles!"), Zone18B_EventScript_SlideOpenGroundRoomDoors)
	msgbox(format("We gotta be more solid next time."), MSGBOX_AUTOCLOSE)
	end
}

script Zone18B_EventScript_Rex {
	trainerbattle_single(TRAINER_PBL_REX, format("Bugs, Bugs, I love Bugs. Don't you?"), format("Ah! My poor Bugs!"), Zone18B_EventScript_SlideOpenBugRoomDoors)
	msgbox(format("My sweet, lovely, creepy-crawlies, I'll work harder for you next time!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone18B_EventScript_Louis {
	trainerbattle_single(TRAINER_PBL_LOUIS, format("I'm a researcher studying rare metal artifacts. Do you have any?"), format("Perhaps I should study Pokémon\nbattling as well."), Zone18B_EventScript_SlideOpenSteelRoomDoors)
	msgbox(format("I've heard there is a great ruin in a dense jungle somewhere, and deep within lies a powerful item."), MSGBOX_AUTOCLOSE)
	end
}

script Zone18B_EventScript_Leroy {
	trainerbattle_single(TRAINER_PBL_LEROY, format("Sneak attack! Poison Powder!"), format("I forgot about the powder!"), Zone18B_EventScript_SlideOpenPoisonRoomDoors)
	msgbox(format("I didn't really sneak up on you either, did I."), MSGBOX_AUTOCLOSE)
	end
}

script Zone18B_EventScript_Elton {
	trainerbattle_single(TRAINER_PBL_ELTON, format("My music will shock you!"), format("You don't like Electric beats?"), Zone18B_EventScript_SlideOpenElectricRoomDoors)
	msgbox(format("I just like the smooth current!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone18B_EventScript_Willie {
	trainerbattle_single(TRAINER_PBL_WILLIE, format("Hot, hot hot hot!"), format("Sorry, I had a hot potato in my hands."), Zone18B_EventScript_SlideOpenFireRoomDoors)
	msgbox(format("You should be careful while cooking something hot!"), MSGBOX_AUTOCLOSE)
	end
}
