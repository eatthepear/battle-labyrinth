script Zone18B_EventScript_LeftBossRoomDoor {
	lockall
	goto_if_not_defeated(TRAINER_PBL_ELTON, Zone18B_EventScript_DoorLocked)
	msgbox("“Gym Leader's Room,”\p“See for yourself what Pokémon await\nyou!” the sign says.\pDo you want to go through?", MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		closemessage
		delay(30)
		if (var(VAR_ZONE_18_STATE) < 3) {
			setvar(VAR_ZONE_18_STATE, 1)
		}
		warpdoor(MAP_ZONE18B, 71, 1, 7)
		waitstate
	}
	releaseall
	end
}

