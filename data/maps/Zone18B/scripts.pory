		}
		warpdoor(MAP_ZONE18B, 72, 7, 7)
		waitstate
	}
	releaseall
	end
}

script Zone18B_EventScript_SlideOpenNormalRoomDoors {
	setvar(VAR_0x8005, 0)
	call(Zone18B_EventScript_OpenNormalRoomDoors)
	special(DrawWholeMapView)
	release
	end
}

