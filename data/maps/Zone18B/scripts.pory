mapscripts Zone18B_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		setvar(VAR_0x8005, 1)
		call_if_defeated(TRAINER_PBL_RACHEL, Zone18B_EventScript_OpenNormalRoomDoors)
		call_if_defeated(TRAINER_PBL_GLENN, Zone18B_EventScript_OpenRockRoomDoors)
		call_if_defeated(TRAINER_PBL_JAY, Zone18B_EventScript_OpenIceRoomDoors)
		call_if_defeated(TRAINER_PBL_TYLER, Zone18B_EventScript_OpenDarkRoomDoors)
		call_if_defeated(TRAINER_PBL_TERRENCE, Zone18B_EventScript_OpenFlyingRoomDoors)
		call_if_defeated(TRAINER_PBL_MARTY, Zone18B_EventScript_OpenPsychicRoomDoors)
		call_if_defeated(TRAINER_PBL_KARI, Zone18B_EventScript_OpenFightingRoomDoors)
		call_if_defeated(TRAINER_PBL_ABRAHAM, Zone18B_EventScript_OpenDragonRoomDoors)
		call_if_defeated(TRAINER_PBL_MELINDA, Zone18B_EventScript_OpenFairyRoomDoors)
		call_if_defeated(TRAINER_PBL_EMILIO, Zone18B_EventScript_OpenGroundRoomDoors)
		call_if_defeated(TRAINER_PBL_REX, Zone18B_EventScript_OpenBugRoomDoors)
		call_if_defeated(TRAINER_PBL_LOUIS, Zone18B_EventScript_OpenSteelRoomDoors)
		call_if_defeated(TRAINER_PBL_LEROY, Zone18B_EventScript_OpenPoisonRoomDoors)
		call_if_defeated(TRAINER_PBL_ELTON, Zone18B_EventScript_OpenElectricRoomDoors)
		call_if_defeated(TRAINER_PBL_WILLIE, Zone18B_EventScript_OpenFireRoomDoors)
	}
}

script Zone18B_EventScript_Larry {
    lock
	if (flag(FLAG_BEAT_BOSS_18)) {
		setspeaker("Larry")
		msgbox(format("You will become even stronger! I've battled you, so I know."))
		release
		end
	}
	setspeaker("Larry")
	msgbox(format("Hehehe… Were you surprised?\pThis is my own Pokémon Gym, my very own, without my brother anywhere near!\pWhile it would be nice to be around him sometimes…\pNever mind. You've brought yourself, and you're looking for a challenge.\pI hope to meet that expectation!\pBring it!"))
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_LARRY_BOSS_18, format("What? I lost?"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Larry")
	msgbox(format("It can't be helped. You've won…\pCongratulations. Please take the Normal Badge!"))
	setspeaker(SP_NAME_NONE)
	playfanfare(MUS_OBTAIN_BADGE)
	msgbox(format("{PLAYER} received the Normal Badge from {COLOR BLUE}Larry{COLOR DARK_GRAY}!"))
	waitfanfare
	setspeaker("Grant")
	msgbox(format("Since you now have the Normal Badge, you can use the HM {COLOR GREEN}Cut{COLOR DARK_GRAY} outside battle.\pI'd also like you to take this TM."))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_TM_LIGHT_SCREEN)
	setspeaker("Larry")
	msgbox(format("That's it!\pFufufu…\pJust kidding, here's the other one as well. Us Gym Leaders give out multiple rewards!"))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_TM_REFLECT)
	setspeaker("Larry")
	msgbox(format("You will become even stronger! I've battled you, so I know."))
    setflag(FLAG_BEAT_BOSS_18)
	setflag(FLAG_BADGE06_GET)
	release
	end
}

script Zone18B_EventScript_DoorLocked {
	msgbox("This door appears to be locked\nright now…", MSGBOX_DEFAULT)
	releaseall
	end
}

script Zone18B_EventScript_RockRoomDoor {
	lockall
	goto_if_not_defeated(TRAINER_PBL_RACHEL, Zone18B_EventScript_DoorLocked)
	msgbox("“Rock Room,” the sign says.\pDo you want to go through?", MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		closemessage
		delay(30)
		warpdoor(MAP_ZONE18B, 5, 7, 189)
		waitstate
	}
	releaseall
	end
}

