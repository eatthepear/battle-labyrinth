mapscripts PartnerGrove_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_PARTNER_GROVE_TM_ENERGY_BALL)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST)
		}
    }
}

script PartnerGrove_EventScript_TMEnergyBall {
	lock
	if (flag(FLAG_ITEM_PARTNER_GROVE_TM_ENERGY_BALL)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
	setflag(FLAG_ITEM_PARTNER_GROVE_TM_ENERGY_BALL)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_TM_ENERGY_BALL, 1)
	release
	end
}
