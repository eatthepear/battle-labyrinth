script Zone23A_EventScript_Edgardo {
	trainerbattle_single(TRAINER_PBL_EDGARDO, format("Attack, my swarm of Bugs!"), format("Retreat! Full retreat!"))
	msgbox(format("I just need a few more Bugs to fill out my party!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone23A_EventScript_Jean {
	trainerbattle_single(TRAINER_PBL_JEAN, format("Oh, traveler, what brings you to my swamp?"), format("A dark, brooding swamp… Just the perfect place for me!"))
	msgbox(format("I like to dress up as a witch.\pCosplay is fun!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone23A_EventScript_Rose {
	trainerbattle_single(TRAINER_PBL_ROSE, format("Won't you stay with me forever?"), format("I never can hold on to anything…"))
	msgbox(format("We could be friends, forever…"), MSGBOX_AUTOCLOSE)
	end
}

script Zone23A_EventScript_Jennifer {
	trainerbattle_single(TRAINER_PBL_JENNIFER, format("Something about you is peculiar…"), format("I can't read your mind, it's too resilient…"))
	msgbox(format("Your mental fortitude must be incredible, having made it this far!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone23A_EventScript_Matthew {
	trainerbattle_single(TRAINER_PBL_MATTHEW, format("Adversity is the best teacher!"), format("I lose! I haven't learned anything!"))
	msgbox(format("Hardship is my teacher, but I don't think I'm learning that much, all things considered."), MSGBOX_AUTOCLOSE)
	end
}

script Zone23A_EventScript_Kerry {
	trainerbattle_single(TRAINER_PBL_KERRY, format("What's your favorite seafood?"), format("I personally love scallops!"))
	msgbox(format("Some folks have dietary restrictions that prevent them from consuming seafood.\pThat's all right! I still like to eat with them."), MSGBOX_AUTOCLOSE)
	end
}

script Zone23A_EventScript_Annie {
	trainerbattle_single(TRAINER_PBL_ANNIE, format("For the environment!"), format("That's a downer!"))
	msgbox(format("Climate change is a real threat to habitats like these."), MSGBOX_AUTOCLOSE)
	end
}

script Zone23A_EventScript_Clark {
	trainerbattle_single(TRAINER_PBL_CLARK, format("I do love nature, but I hate mud in my boots!"), format("Now there's mud everywhere!"))
	msgbox(format("The rain makes everything muddy!"), MSGBOX_AUTOCLOSE)
	end
}
