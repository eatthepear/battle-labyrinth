mapscripts PartnerCanyon_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_PARTNER_CANYON_TM_WILL_O_WISP)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST)
		}
    }
}

script PartnerCanyon_EventScript_TMWillOWisp {
	lock
	if (flag(FLAG_ITEM_PARTNER_CANYON_TM_WILL_O_WISP)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
	setflag(FLAG_ITEM_PARTNER_CANYON_TM_WILL_O_WISP)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_TM_WILL_O_WISP, 1)
	release
	end
}
