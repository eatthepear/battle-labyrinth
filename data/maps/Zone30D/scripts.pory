mapscripts Zone30D_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		if (flag(FLAG_ZONE_30D_DOOR_1) == FALSE) {
			setmetatile(7, 11, METATILE_RocketCo_VerticalBarrier_TopLeft, 1)
			setmetatile(8, 11, METATILE_RocketCo_VerticalBarrier_TopRight, 1)
			setmetatile(7, 12, METATILE_RocketCo_VerticalBarrier_MidLeft, 1)
			setmetatile(8, 12, METATILE_RocketCo_VerticalBarrier_MidRight, 1)
			setmetatile(7, 13, METATILE_RocketCo_VerticalBarrier_BottomLeft, 1)
			setmetatile(8, 13, METATILE_RocketCo_VerticalBarrier_BottomRight, 1)
		}
		if (flag(FLAG_ZONE_30D_DOOR_2) == FALSE) {
			setmetatile(15, 20, METATILE_RocketCo_HorizontalBarrier_TopLeft, 1)
			setmetatile(16, 20, METATILE_RocketCo_HorizontalBarrier_TopRight, 1)
			setmetatile(15, 21, METATILE_RocketCo_HorizontalBarrier_BottomLeft, 1)
			setmetatile(16, 21, METATILE_RocketCo_HorizontalBarrier_BottomRight, 1)
			setmetatile(16, 22, METATILE_RocketCo_Floor_ShadeFull, 0)
		}
		if (flag(FLAG_ZONE_30D_DOOR_3) == FALSE) {
			setmetatile(37, 19, METATILE_RocketCo_VerticalBarrier_TopLeft, 1)
			setmetatile(38, 19, METATILE_RocketCo_VerticalBarrier_TopRight, 1)
			setmetatile(37, 20, METATILE_RocketCo_VerticalBarrier_MidLeft, 1)
			setmetatile(38, 20, METATILE_RocketCo_VerticalBarrier_MidRight, 1)
			setmetatile(37, 21, METATILE_RocketCo_VerticalBarrier_BottomLeft, 1)
			setmetatile(38, 21, METATILE_RocketCo_VerticalBarrier_BottomRight, 1)
		}
	}
}

script Zone30D_EventScript_Door1 {
	lockall
	setvar(VAR_TEMP_1, 1) // 1 = lobby, 2 = magma, 3 = aqua, 4 = galactic, 5 = rocket top floor
	setvar(VAR_0x8004, FLAG_ZONE_30D_DOOR_1)
    if (flag(FLAG_ZONE_30D_DOOR_1)) {
        goto(Zone30_EventScript_DoorUnlocked)
    }
    call(Zone30_EventScript_CheckCanOpenDoor)
	setmetatile(7, 11, METATILE_RocketCo_Wall_LeftEdge, 1)
	setmetatile(8, 11, METATILE_RocketCo_Wall_RightEdge, 1)
	setmetatile(7, 12, METATILE_RocketCo_Floor_ShadeFull, 0)
	setmetatile(8, 12, METATILE_RocketCo_Floor_ShadeFull, 0)
	setmetatile(7, 13, METATILE_RocketCo_Floor_WallLeftCorner, 0)
	setmetatile(8, 13, METATILE_RocketCo_Floor_WallRightCorner, 0)
	waitse
	playse(SE_UNLOCK)
	special(DrawWholeMapView)
	waitse
	special(SetHiddenItemFlag)
	releaseall
	end
}

script Zone30D_EventScript_Door2 {
	lockall
	setvar(VAR_TEMP_1, 1) // 1 = lobby, 2 = magma, 3 = aqua, 4 = galactic, 5 = rocket top floor
	setvar(VAR_0x8004, FLAG_ZONE_30D_DOOR_2)
    if (flag(FLAG_ZONE_30D_DOOR_2)) {
        goto(Zone30_EventScript_DoorUnlocked)
    }
    call(Zone30_EventScript_CheckCanOpenDoor)
	setmetatile(15, 20, METATILE_RocketCo_Floor_ShadeFull, 0)
	setmetatile(16, 20, METATILE_RocketCo_Floor, 0)
	setmetatile(15, 21, METATILE_RocketCo_Floor_ShadeFull, 0)
	setmetatile(16, 21, METATILE_RocketCo_Floor, 0)
	setmetatile(16, 22, METATILE_RocketCo_Floor, 0)
	waitse
	playse(SE_UNLOCK)
	special(DrawWholeMapView)
	waitse
	special(SetHiddenItemFlag)
	releaseall
	end
}

script Zone30D_EventScript_Door3 {
	lockall
	setvar(VAR_TEMP_1, 1) // 1 = lobby, 2 = magma, 3 = aqua, 4 = galactic, 5 = rocket top floor
	setvar(VAR_0x8004, FLAG_ZONE_30D_DOOR_3)
    if (flag(FLAG_ZONE_30D_DOOR_3)) {
        goto(Zone30_EventScript_DoorUnlocked)
    }
    call(Zone30_EventScript_CheckCanOpenDoor)
	setmetatile(37, 19, METATILE_RocketCo_Wall_LeftEdge, 1)
	setmetatile(38, 19, METATILE_RocketCo_Wall_RightEdge, 1)
	setmetatile(37, 20, METATILE_RocketCo_Floor_ShadeFull, 0)
	setmetatile(38, 20, METATILE_RocketCo_Floor_ShadeFull, 0)
	setmetatile(37, 21, METATILE_RocketCo_Floor_WallLeftCorner, 0)
	setmetatile(38, 21, METATILE_RocketCo_Floor_WallRightCorner, 0)
	waitse
	playse(SE_UNLOCK)
	special(DrawWholeMapView)
	waitse
	special(SetHiddenItemFlag)
	releaseall
	end
}

script Zone30D_EventScript_Leaf_Intro {
	lockall
	playbgm(MUS_BW_FRIEND, 0)
	applymovement(LOCALID_LEAF_ZONE30D, Common_Movement_FaceLeft)
	waitmovement(0)
	applymovement(LOCALID_LEAF_ZONE30D, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	setspeaker("Leaf")
	msgbox(format("Oh, poor Leaf, all alone in these woods.\pWon't you help show me the way out?"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_LEAF_ZONE30D, Common_Movement_WalkRight3)
	waitmovement(0)
	setspeaker(SP_NAME_NONE)
	msgbox(format("{PLAYER} agreed to help {COLOR BLUE}Leaf{COLOR DARK_GRAY}!"))
	setspeaker("Leaf")
	msgbox(format("LETS GO!"), MSGBOX_AUTOCLOSE)
	setfollowernpc(LOCALID_LEAF_ZONE30D, FOLLOWER_NPC_FLAG_ALL, 0, PARTNER_PBL_LEAF_30)
	facefollowernpc
	setvar(VAR_ZONE_30_STATE, 4)
	fadedefaultbgm
	releaseall
}

script Zone30D_EventScript_Leaf {
	lock
	faceplayer
	call_if_eq(VAR_PUZZLE_DIFFICULTY, 1, EventScript_PuzzleHint)
	call_if_eq(VAR_PUZZLE_DIFFICULTY, 2, EventScript_PuzzleSkip)
	setspeaker("Leaf")
	msgbox(format("DIALOGUE!"), MSGBOX_AUTOCLOSE)
	release
	end
}
