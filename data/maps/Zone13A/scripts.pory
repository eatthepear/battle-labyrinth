script Zone13A_EventScript_Steve {
	trainerbattle_single(TRAINER_PBL_STEVE, format("I can hear them buzzing!\nWhere are you, my precious Bug Pokémon?"), format("Buzz! Defeated!"))
	msgbox(format("The only pest I found was you!!"), MSGBOX_AUTOCLOSE)
	end
}

raw `
Zone13A_EventScript_Sign::
	msgbox Zone13A_Text_Sign, MSGBOX_SIGN
	end

Zone13A_Text_Sign:
	.string "Mining Facility$"
`
