mapscripts Zone13A_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE13A_SUN_STONE)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE13A_RANDOM_1)) {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST)
		}
	}
}

script Zone13A_EventScript_Serena {
	lock
	faceplayer
	setspeaker("Serena")
	msgbox(format("Hello! This is bad people hideout. R u strong? Let's battle!"))
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_SERENA_BOSS_13, format("Defeat!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Serena")
	msgbox(format("U r too stronk. Here, take item."))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_SHALOUR_SABLE, 5)
	setspeaker("Serena")
	msgbox(format("These bad people are good, but I stronger, and I beat up bad people. See u later, we battle again!"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_SERENA_13A, Common_Movement_FaceUp)
	waitmovement
	opendoor(20, 18)
	waitdooranim
	applymovement(LOCALID_SERENA_13A, Zone13A_Movement_SerenaWalkUp)
	waitmovement(0)
	removeobject(LOCALID_SERENA_13A)
	setflag(FLAG_HIDE_ZONE13A_SERENA)
	release
	end
}

movement Zone13A_Movement_SerenaWalkUp {
	walk_up
	set_invisible
}

script Zone13A_EventScript_ParasolLady {
	lock
	faceplayer
	if (flag(FLAG_ZONE13A_RECEIVED_UTILITY_UMBRELLA) == false) {
		msgbox(format("Rain or shine, it's important to protect yourself from the elements!"), MSGBOX_DEFAULT)
		giveitem(ITEM_UTILITY_UMBRELLA)
		setflag(FLAG_ZONE13A_RECEIVED_UTILITY_UMBRELLA)
	}
	msgbox(format("The Utility Umbrella nullifies the effects of harsh sunlight or rain on the user.\pIsn't that neat?"))
	release
	end
}

script Zone13A_EventScript_SunStone {
	lock
	if (flag(FLAG_ITEM_ZONE13A_SUN_STONE)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE13A_SUN_STONE)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_SUN_STONE, 1)
	release
	end
}

script Zone13A_EventScript_Random1 {
	lock
	if (flag(FLAG_ITEM_ZONE13A_RANDOM_1)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE13A_RANDOM_1)
	addobject(VAR_LAST_TALKED)
	specialvar(VAR_TEMP_1, RandomItemChest)
	finditem(VAR_TEMP_1, VAR_TEMP_0)
	release
	end
}

script Zone13A_EventScript_Violet {
	trainerbattle_single(TRAINER_PBL_VIOLET, format("Ah, finally, a pleasant aroma!"), format("I wasn't talking about you!\nI meant the flowers!"))
	msgbox(format("Though, you do smell nice.\nUh, nevermind!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone13A_EventScript_Wanda {
	trainerbattle_single(TRAINER_PBL_WANDA, format("BATTLE!"), format("DEFEAT!"))
	msgbox(format("DEFEATED!"), MSGBOX_AUTOCLOSE)
	end
}

