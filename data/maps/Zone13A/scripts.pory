mapscripts Zone13A_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE13A_SUN_STONE)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE13A_RANDOM_1)) {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST)
		}
	}
}

script Zone13A_EventScript_Serena {
	lock
	faceplayer
	setspeaker("Serena")
	msgbox(format("Oh {PLAYER}! Great timing. Some people in red suits calling themselves Team Magma have taken over this building, so I'm going to head in to stop them.\pI need help though. Would you be able to help? I'll need to test you to see if you're up to the challenge."), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		setspeaker("Serena")
		msgbox(format("Oh, I get it. You don't just charge right into battle blindly, do you?"))
		release
		end
	}
	setspeaker("Serena")
	msgbox(format("Great! I'll give this battle my all!"))
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_SERENA_BOSS_13, format("So, I lost, then…"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Serena")
	msgbox(format("You're quite the trainer, {PLAYER}!\pLosing is frustrating, but… It's great to know I have a trainer like you on my side!\pBefore we go in, take these! They're from the Kalos region, where I'm from."))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_SHALOUR_SABLE, 5)
	setspeaker("Serena")
	msgbox(format("Team Magma won't get away with whatever they're planning!\pNow look, I'm going to run in and try to battle Team Magma.\pIf I don't bump into you inside, it was great to see you again!\pThanks again for your help!"))
	closemessage
	applymovement(LOCALID_SERENA_13A, Common_Movement_FaceUp)
	waitmovement
	opendoor(20, 18)
	waitdooranim
	applymovement(LOCALID_SERENA_13A, Zone13A_Movement_SerenaWalkUp)
	waitmovement(0)
	removeobject(LOCALID_SERENA_13A)
	setflag(FLAG_BEAT_BOSS_13)
	closedoor(20, 18)
	waitdooranim
	release
	end
}

movement Zone13A_Movement_SerenaWalkUp {
	walk_up
	set_invisible
}

script Zone13A_EventScript_ParasolLady {
	lock
	faceplayer
	if (flag(FLAG_ZONE13A_RECEIVED_UTILITY_UMBRELLA) == false) {
		msgbox(format("Rain or shine, it's important to protect yourself from the elements!"), MSGBOX_DEFAULT)
		giveitem(ITEM_UTILITY_UMBRELLA)
		setflag(FLAG_ZONE13A_RECEIVED_UTILITY_UMBRELLA)
	}
	msgbox(format("The Utility Umbrella nullifies the effects of harsh sunlight or rain on the user.\pIsn't that neat?"))
	release
	end
}

script Zone13A_EventScript_SunStone {
	lock
	if (flag(FLAG_ITEM_ZONE13A_SUN_STONE)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE13A_SUN_STONE)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_SUN_STONE, 1)
	release
	end
}

script Zone13A_EventScript_Random1 {
	lock
	if (flag(FLAG_ITEM_ZONE13A_RANDOM_1)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE13A_RANDOM_1)
	addobject(VAR_LAST_TALKED)
	specialvar(VAR_TEMP_1, RandomItemChest)
	finditem(VAR_TEMP_1, VAR_TEMP_0)
	release
	end
}

script Zone13A_EventScript_Violet {
	trainerbattle_single(TRAINER_PBL_VIOLET, format("Ah, finally, a pleasant aroma!"), format("I wasn't talking about you!\nI meant the flowers!"))
	msgbox(format("Though, you do smell nice.\nUh, nevermind!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone13A_EventScript_Wanda {
	trainerbattle_single(TRAINER_PBL_WANDA, format("I've traveled long and far, for you to be my final opponent!"), format("My journey, at an end now…"))
	msgbox(format("It's time to go home…"), MSGBOX_AUTOCLOSE)
	end
}

script Zone13A_EventScript_Benjamin {
	trainerbattle_single(TRAINER_PBL_BENJAMIN, format("I'm so lost right now…"), format("I do not know the way…"))
	msgbox(format("To be clear, I know where I am physically.\pI just have a lot on my mind right now."), MSGBOX_AUTOCLOSE)
	end
}

script Zone13A_EventScript_Geralt {
	trainerbattle_single(TRAINER_PBL_GERALT, format("You ever stop to smell the roses, like a real man?"), format("There's nothing wrong with appreciating nature. That's what a real man would do."))
	msgbox(format("Take a moment to enjoy life, like a real man."), MSGBOX_AUTOCLOSE)
	end
}

script Zone13A_EventScript_Steve {
	trainerbattle_single(TRAINER_PBL_STEVE, format("I can hear them buzzing!\nWhere are you, my precious Bug Pokémon?"), format("Buzz! Defeated!"))
	msgbox(format("The only pest I found was you!!"), MSGBOX_AUTOCLOSE)
	end
}

raw `
Zone13A_EventScript_Sign::
	msgbox Zone13A_Text_Sign, MSGBOX_SIGN
	end

Zone13A_Text_Sign:
	.string "Mining Facility$"
`
