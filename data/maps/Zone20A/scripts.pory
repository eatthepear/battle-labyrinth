mapscripts Zone20A_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_ZONE_20_STATE, 4: Zone20A_EventScript_TriggerLacey
	]
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE20A_SHINY_STONE)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE20A_EXPERT_BELT)) {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST)
		}
	}
}

script Zone20A_EventScript_TriggerLacey {
    lockall
	applymovement(LOCALID_LACEY_20A, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
    setspeaker("Lacey")
    msgbox(format("BATTLE! YES / NO?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		setspeaker("Lacey")
		msgbox(format("GREAT!! BATTLE!!"))
		trainerbattle_no_intro(TRAINER_PBL_LACEY_OPTIONAL_20, "DEFEAT!")
		setspeaker("Lacey")
		msgbox(format("DEFEATED!!"))
		setspeaker(SP_NAME_NONE)
		giveitem(ITEM_TM_DAZZLING_GLEAM)
	} else {
		setspeaker("Lacey")
		msgbox(format("AWW NO BATTLE!!"))
	}
    setspeaker("Lacey")
    msgbox(format("BYE!!"))
	closemessage
	applymovement(LOCALID_LACEY_20A, Common_Movement_WalkDown5)
	waitmovement
	removeobject(LOCALID_LACEY_20A)
	setflag(FLAG_HIDE_ZONE20A_LACEY)
    setvar(VAR_ZONE_20_STATE, 5)
    releaseall
    end
}

script Zone20A_EventScript_Winston {
	trainerbattle_single(TRAINER_PBL_WINSTON, format("BATTLE!"), format("DEFEAT!"))
	msgbox(format("DEFEATED!"), MSGBOX_AUTOCLOSE)
	end
}

