	msgbox(format("Minun looks confused and lost, but sniffs you. It seems to recognize the scent of Sophocles!"), MSGBOX_AUTOCLOSE)
	playmoncry(SPECIES_MINUN, CRY_MODE_NORMAL)
	delay(40)
	waitmoncry
	fadescreenswapbuffers(FADE_TO_BLACK)
	removeobject(LOCALID_MINUN_1)
	setflag(FLAG_HIDE_ZONE15A_MON_2)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	msgbox(format("Minun took off! It seems to know the way to Sophocles!"))
	call(Zone15A_EventScript_TimeToFindSophocles)
	release
	end
