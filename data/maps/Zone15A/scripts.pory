mapscripts Zone15A_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_ZONE_15_STATE, 0: Zone15A_EventScript_SophoclesIntro
	]
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE15A_RANDOM_1)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE15A_SHELL_BELL)) {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE15A_ICE_STONE)) {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE15A_RANDOM_2)) {
			setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE15A_TM_AURORA_VEIL)) {
			setvar(VAR_OBJ_GFX_ID_4, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_4, OBJ_EVENT_GFX_TM_CHEST)
		}
	}
}

script Zone15A_EventScript_SophoclesIntro {
	lockall
	applymovement(LOCALID_SOPHOCLES_1, Common_Movement_FaceUp)
	waitmovement(0)
	applymovement(LOCALID_SOPHOCLES_1, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	applymovement(LOCALID_SOPHOCLES_1, Common_Movement_WalkUp2)
	waitmovement(0)
	setspeaker("???")
	msgbox(format("Hello, I'm {COLOR BLUE}Sophocles{COLOR DARK_GRAY}. Would you be able to help me out?"))
	setspeaker("Sophocles")
	msgbox(format("I was trying to train my Pokémon in this cave, but as soon as I let them out of their Poké Balls, they ran off in a frenzy!\pSomething in this cave must be causing them to behave strangely.\pI'm missing two {COLOR GREEN}Plusle{COLOR DARK_GRAY}, two {COLOR GREEN}Minun{COLOR DARK_GRAY}, and my {COLOR GREEN}Ampharos{COLOR DARK_GRAY}.\pCould you help me find {COLOR GREEN}three Pokémon{COLOR DARK_GRAY}?\pI {COLOR GREEN}should find the rest by then{COLOR DARK_GRAY}."))
	playse(MUS_DP_LETS_GO_TOGETHER)
	setspeaker(SP_NAME_NONE)
	msgbox(format("{PLAYER} agreed to help {COLOR BLUE}Sophocles{COLOR DARK_GRAY}!"))
	waitse
	setspeaker("Sophocles")
	msgbox(format("I'll be {COLOR GREEN}by the southwest section of the cave{COLOR DARK_GRAY}."), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_SOPHOCLES_1, Common_Movement_WalkDown2)
	waitmovement(0)
	applymovement(LOCALID_SOPHOCLES_1, Common_Movement_WalkLeft2)
	waitmovement(0)
	applymovement(LOCALID_SOPHOCLES_1, Common_Movement_WalkDown3)
	waitmovement(0)
	removeobject(LOCALID_SOPHOCLES_1)
	setflag(FLAG_HIDE_ZONE15A_SOPHOCLES_1)
	setvar(VAR_ZONE_15_STATE, 1)
	releaseall
	end
}

script Zone15A_EventScript_Sophocles {
	lock
	faceplayer
	setspeaker("Sophocles")
	msgbox(format("Did you find the other Pokémon yet?\pIf you could find {COLOR GREEN}three Pokémon{COLOR DARK_GRAY} for me, I would be extremely grateful!"))
	release
	end
}

script Zone15A_EventScript_Sophocles_BlockPassage {
	lockall
	applymovement(LOCALID_SOPHOCLES_2, Common_Movement_FaceLeft)
	waitmovement(0)
	setspeaker("Sophocles")
	msgbox(format("I'll handle looking down this path! Once you find the others, come here and let me know!"))
	applymovement(LOCALID_PLAYER, Common_Movement_WalkRight)
	waitmovement(0)
	releaseall
	end
}

script Zone15A_EventScript_Plusle_1 {
	lock
	faceplayer
	waitse
	playmoncry(SPECIES_PLUSLE, CRY_MODE_NORMAL)
	delay(40)
	waitmoncry
	msgbox(format("Plusle looks confused and lost, but sniffs you. It seems to recognize the scent of Sophocles!"), MSGBOX_AUTOCLOSE)
	playmoncry(SPECIES_PLUSLE, CRY_MODE_NORMAL)
	delay(40)
	waitmoncry
	fadescreenswapbuffers(FADE_TO_BLACK)
	removeobject(LOCALID_PLUSLE_1)
	setflag(FLAG_HIDE_ZONE15A_MON_1)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	msgbox(format("Plusle ran off! It seems to know the way to Sophocles!"))
	call(Zone15A_EventScript_TimeToFindSophocles)
	release
	end
}

