mapscripts Zone15A_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE15A_SNOWBALL_3)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE15A_TIMER_BALL)) {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE15A_ICE_STONE)) {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE15A_QUICK_BALL)) {
			setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE15A_REVIVE)) {
			setvar(VAR_OBJ_GFX_ID_4, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_4, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE15A_DAWN_STONE)) {
			setvar(VAR_OBJ_GFX_ID_5, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_5, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE15A_TM26)) {
			setvar(VAR_OBJ_GFX_ID_6, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_6, OBJ_EVENT_GFX_TM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE15A_GLALITITE)) {
			setvar(VAR_OBJ_GFX_ID_7, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_7, OBJ_EVENT_GFX_ITEM_CHEST)
		}
	}
}

script Zone15A_EventScript_SophoclesIntro {
	lockall
	applymovement(LOCALID_SOPHOCLES, Common_Movement_FaceUp)
	waitmovement(0)
	applymovement(LOCALID_SOPHOCLES, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	setspeaker("Sophocles")
	msgbox(format("Help! I was trying to train my Pokemon in this cave, but as soon as I let them out of their Poke Balls, they ran off in a frenzy! All my Plusle and Minun, and my Ampharos too! Could you help me find them? There should be 2 Plusle and 2 Minun to find, plus the Ampharos!"))
	releaseall
	end
}

script Zone15A_EventScript_Sophocles {
	lock
	faceplayer
	setspeaker("Sophocles")
	msgbox(format("Help!"))
	release
	end
}

script Zone15A_EventScript_Plusle {
	lock
	faceplayer
	waitse
	playmoncry(SPECIES_PLUSLE, CRY_MODE_NORMAL)
	delay(40)
	waitmoncry
	msgbox(format("Plusle looks confused and lost, but sniffs you. It seems to recognize the scent of Sophocles!"))
	playmoncry(SPECIES_PLUSLE, CRY_MODE_NORMAL)
	delay(40)
	waitmoncry
	// movement
	msgbox(format("Plusle took off! It seems to know the way back to Sophocles!"))
	release
	end
}

