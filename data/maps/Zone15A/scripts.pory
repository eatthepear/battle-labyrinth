script Zone15A_EventScript_TimeToFindSophocles {
	if (flag(FLAG_HIDE_ZONE15A_MON_1) && flag(FLAG_HIDE_ZONE15A_MON_2) && flag(FLAG_HIDE_ZONE15A_MON_3)) {
		msgbox(format("You've found 3 Pokemon. Time to find Sophocles. He said he was in the southwest section of the cave."))
		setvar(VAR_ZONE_15_STATE, 2)
		setflag(FLAG_HIDE_ZONE15A_SOPHOCLES_2)
	}
	return
}

script Zone15A_EventScript_Sophocles_ExplainBoss {
	lockall
	applymovement(LOCALID_SOPHOCLES_3, Common_Movement_FaceRight)
	waitmovement(0)
	applymovement(LOCALID_SOPHOCLES_3, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	setspeaker("Sophocles")
	msgbox(format("There you are!"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_SOPHOCLES_3, Common_Movement_WalkRight4)
	waitmovement(0)
	getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
	if (var(VAR_TEMP_1) == 49) {
		applymovement(LOCALID_SOPHOCLES_3, Common_Movement_WalkUp2)
		waitmovement(0)
	} elif (var(VAR_TEMP_1) == 50) {
		applymovement(LOCALID_SOPHOCLES_3, Common_Movement_WalkUp)
		waitmovement(0)
	}
	applymovement(LOCALID_SOPHOCLES_3, Common_Movement_FaceRight)
	waitmovement(0)
	setspeaker("Sophocles")
	msgbox(format("Thank you for locating the two Plusle and one Minun, but now there's a bigger problem.\pIt seems that my Pokémon are behaving strangely due to the energy emanating from that stone.\pMy Ampharos in particular seems to be running quite rabid.\pI wasn't able to calm it down, it seems only want to battle!\pI hate to ask more of you, but could you defeat Ampharos for me?\pLet me know when you're ready."), MSGBOX_AUTOCLOSE)
	if (var(VAR_TEMP_1) == 49) {
		applymovement(LOCALID_SOPHOCLES_3, Common_Movement_WalkDown2)
		waitmovement(0)
	} elif (var(VAR_TEMP_1) == 50) {
		applymovement(LOCALID_SOPHOCLES_3, Common_Movement_WalkDown)
		waitmovement(0)
	}
	applymovement(LOCALID_SOPHOCLES_3, Common_Movement_WalkLeft4)
	waitmovement(0)
	applymovement(LOCALID_SOPHOCLES_3, Common_Movement_FaceUp)
	waitmovement(0)
	setvar(VAR_ZONE_15_STATE, 3)
	releaseall
}

script Zone15A_EventScript_Sophocles_TriggerBoss {
	lock
	faceplayer
	setspeaker("Sophocles")
	msgbox(format("Are you sure you're ready to face Ampharos?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		msgbox(format("Please, I need your help!"), MSGBOX_AUTOCLOSE)
		applymovement(LOCALID_SOPHOCLES_3, Common_Movement_FaceUp)
		waitmovement(0)
		release
		end
	}
	setspeaker("Sophocles")
	msgbox(format("I'll focus on countering the energy in that stone, while you keep Ampharos distracted!"), MSGBOX_AUTOCLOSE)
	getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
	if (var(VAR_TEMP_0) == 6) {
		applymovement(LOCALID_SOPHOCLES_3, Common_Movement_WalkRight)
		applymovement(LOCALID_PLAYER, Common_Movement_WalkRight)
		waitmovement(0)
		applymovement(LOCALID_SOPHOCLES_3, Common_Movement_WalkLeft)
		applymovement(LOCALID_PLAYER, Common_Movement_WalkUp)
		waitmovement(0)
	} elif (var(VAR_TEMP_0) == 7) {
		applymovement(LOCALID_SOPHOCLES_3, Common_Movement_WalkLeft)
		applymovement(LOCALID_PLAYER, Common_Movement_WalkUp)
		waitmovement(0)
		applymovement(LOCALID_SOPHOCLES_3, Common_Movement_WalkRight)
		applymovement(LOCALID_PLAYER, Common_Movement_WalkUp)
		waitmovement(0)
	} else {
		applymovement(LOCALID_SOPHOCLES_3, Common_Movement_WalkLeft)
		applymovement(LOCALID_PLAYER, Common_Movement_WalkLeft)
		waitmovement(0)
		applymovement(LOCALID_SOPHOCLES_3, Common_Movement_WalkRight)
		applymovement(LOCALID_PLAYER, Common_Movement_WalkUp)
		waitmovement(0)
	}
	applymovement(LOCALID_PLAYER, Common_Movement_WalkUp)
	applymovement(LOCALID_SOPHOCLES_3, Common_Movement_FaceUp)
	waitmovement(0)
	applymovement(LOCALID_AMPHAROS, Common_Movement_FaceDown)
	waitmovement(0)
	applymovement(LOCALID_MINUN_2, Common_Movement_FaceDown)
	waitmovement(0)
	playmoncry(SPECIES_AMPHAROS, CRY_MODE_ENCOUNTER)
	delay(40)
	waitmoncry
	msgbox(format("Ampharos looks like they're in a frenzied state!"), MSGBOX_AUTOCLOSE)
	fadeoutbgm(1)
	playmoncry(SPECIES_AMPHAROS, CRY_MODE_ENCOUNTER)
	delay(40)
	waitmoncry
	playmoncry(SPECIES_MINUN, CRY_MODE_ENCOUNTER)
	delay(40)
	waitmoncry
	msgbox(format("Ampharos and Minun attacked!"), MSGBOX_AUTOCLOSE)
	setwildbattle_pbl(SPECIES_AMPHAROS, 32, ITEM_MAGNET, NATURE_QUIET, 31, 2, MOVE_PARABOLIC_CHARGE, MOVE_DAZZLING_GLEAM, MOVE_MAGNETIC_FLUX, MOVE_REST, SPECIES_MINUN, 30, ITEM_SHUCA_BERRY, NATURE_CALM, 31, 0, MOVE_HELPING_HAND, MOVE_LIGHT_SCREEN, MOVE_SUPER_FANG, MOVE_NUZZLE)
	call(EventScript_HealPreBoss)
	setflag(FLAG_SYS_NO_RUNNING)
	setflag(FLAG_SYS_NO_CATCHING)
	setflag(FLAG_SYS_SMART_WILD_AI_ON)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
		settotemboost(B_POSITION_OPPONENT_LEFT, 1, 1, 1, 1, 1)
	}
	dowildbattle
	msgbox(format("Ampharos is reacting to the energy from the stone!\pWith renewed power, it attacked again!"))
	playmoncry(SPECIES_AMPHAROS, CRY_MODE_ENCOUNTER)
	delay(40)
	waitmoncry
	setwildbattle_pbl(SPECIES_AMPHAROS_MEGA, 32, ITEM_MAGNET, NATURE_QUIET, 31, 1, MOVE_PARABOLIC_CHARGE, MOVE_DRAGON_PULSE, MOVE_GRASS_KNOT, MOVE_REST)
	settotemboost(B_POSITION_OPPONENT_LEFT, 1, 1, 1, 1, 1)
	dowildbattle
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	clearflag(FLAG_SYS_NO_CATCHING)
	clearflag(FLAG_SYS_SMART_WILD_AI_ON)
	clearflag(FLAG_SYS_NO_RUNNING)
	setspeaker("Sophocles")
	msgbox(format("You did it! Thank you!"))
	setspeaker(SP_NAME_NONE)
	playfanfare(MUS_OBTAIN_BADGE)
	msgbox(format("{PLAYER} received the Charge Badge from {COLOR BLUE}Sophocles{COLOR DARK_GRAY}!"))
	waitfanfare
	setflag(FLAG_BADGE04_GET)
	giveitem(ITEM_MEGA_RING)
	giveitem(ITEM_TM_VOLT_SWITCH)
	setspeaker("Sophocles")
	msgbox(format("We leave now! Thanks!"))
	fadescreenswapbuffers(FADE_TO_BLACK)
	removeobject(LOCALID_MINUN_2)
	removeobject(LOCALID_AMPHAROS)
	removeobject(LOCALID_SOPHOCLES_3)
	setflag(FLAG_BEAT_BOSS_15)
	setvar(VAR_ZONE_15_STATE, 4)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	release
	end
}

script Zone15A_EventScript_Random1 {
	lock
	if (flag(FLAG_ITEM_ZONE15A_RANDOM_1)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE15A_RANDOM_1)
	addobject(VAR_LAST_TALKED)
	specialvar(VAR_TEMP_1, RandomItemChest)
	finditem(VAR_TEMP_1, VAR_TEMP_0)
	release
	end
}

