mapscripts Zone21A_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE21A_ROCKY_HELMET)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE21A_DAWN_STONE)) {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE21A_RANDOM_1)) {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE21A_RANDOM_2)) {
			setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ITEM_CHEST)
		}
	}
}

script Zone21A_EventScript_Grotto {
	lock
	call(EventScript_FoundGrotto)
	warp(MAP_HIDDEN_GROTTO_ZONE21A, 0)
	waitstate
	release
	end
}

script Zone21A_EventScript_TriggerWally {
	lockall
	applymovement(LOCALID_WALLY_21A, Common_Movement_FaceDown)
	waitmovement(0)
	playbgm(MUS_BW_FRIEND, TRUE)
	applymovement(LOCALID_WALLY_21A, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	delay(16)
	getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
	switch(var(VAR_TEMP_0)) {
		case 22:
			applymovement(LOCALID_WALLY_21A, Common_Movement_WalkLeft)
			waitmovement(0)
		case 24:
			applymovement(LOCALID_WALLY_21A, Common_Movement_WalkRight)
			waitmovement(0)
	}
	applymovement(LOCALID_WALLY_21A, Common_Movement_WalkDown2)
	waitmovement(0)
	setspeaker("Wally")
	msgbox(format("Um, hello, {PLAYER}.\pI wasn't really expecting to see you here, but it works out that you're here.\pI wanted to challenge you to another battle, now that I've trained my Pokémon better.\pSay, this is Double Battle Road, isn't it? Let's follow suit and try a Double Battle.\pReady or not, here I come!"))
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_WALLY_BOSS_21, format("Wow, you are an amazing trainer, {PLAYER}!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Wally")
	msgbox(format("It feels like you're always one step ahead of me, {PLAYER}.\pStill, I feel proud of myself for having come this far!\pI'm going to keep improving my skills and increasing my strength, little by little!\pSpeaking of which, I found this HM, which I think might be useful for you?"))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_HM_STRENGTH)
	setspeaker("Wally")
	msgbox(format("Thanks again for the battle, {PLAYER}.\pI'm sure I'll improve even more by then! We'll see if I can at least give you more of a challenge then."))
	closemessage
	switch(var(VAR_TEMP_0)) {
		case 22:
			applymovement(LOCALID_WALLY_21A, Common_Movement_WalkRight)
			waitmovement(0)
		case 23:
		case 24:
			applymovement(LOCALID_WALLY_21A, Common_Movement_WalkLeft)
			waitmovement(0)
	}
	applymovement(LOCALID_WALLY_21A, Common_Movement_WalkDown6)
	waitmovement(0)
	removeobject(LOCALID_WALLY_21A)
	removeobject(LOCALID_TAUROS_1)
	removeobject(LOCALID_TAUROS_2)
	setflag(FLAG_BEAT_BOSS_21)
	setvar(VAR_ZONE_21_STATE, 1)
	savebgm(MUS_DUMMY)
	fadedefaultbgm
	releaseall
	end
}

script Zone21A_EventScript_Bernard {
	trainerbattle_single(TRAINER_PBL_BERNARD, format("Welcome to Double Battle Road, where we only battle in Double Battles!"), format("I definitely didn't expect to lose!"))
	msgbox(format("All battles on Double Battle Road are Double Battles!\pBut contrary to popular belief, you don't actually need a Bike to go on Double Battle road."), MSGBOX_AUTOCLOSE)
	end
}

script Zone21A_EventScript_Anita {
	trainerbattle_single(TRAINER_PBL_ANITA, format("Double Battles are double the fun!"), format("They're also double the pain of losing, too…"))
	msgbox(format("Next time, my strategy will be: all out victory!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone21A_EventScript_Howard {
	trainerbattle_single(TRAINER_PBL_HOWARD, format("I've heard there's a secret cave underneath Double Battle Road!"), format("I heard you need to Surf to get to the secret cave!"))
	msgbox(format("I would go, but I like biking too much!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone21A_EventScript_Eloise {
	trainerbattle_single(TRAINER_PBL_ELOISE, format("This is quite the long stretch of road!\pAre you up for the challenge?"), format("You're prepared for anything!"))
	msgbox(format("Keep up your stamina, keep going, and keep pushing through, no matter what!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone21A_EventScript_Amir {
	trainerbattle_single(TRAINER_PBL_AMIR, format("TRAIN!\pTRAIN TO FIND THE HIDDEN CAVE!"), format("LOSE! LOSE AND NEVER FIND THE HIDDEN CAVE!"))
	msgbox(format("SEARCH! SEARCH, AND FIND THE HIDDEN CAVE!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone21A_EventScript_Felix {
	trainerbattle_single(TRAINER_PBL_FELIX, format("Want to join my cookout?\pOn the menu: swift victory!"), format("A swift defeat was served instead!"))
	msgbox(format("You've got me all fired up, thinking of new things to cook!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone21A_EventScript_Rusty {
	trainerbattle_single(TRAINER_PBL_RUSTY, format("To protect the natural world, Rangers will go to any length!\pPrepare yourself!"), format("This was just a taste of my resolve!"))
	msgbox(format("Isn't it great to breathe in the air from the great outdoors?"), MSGBOX_AUTOCLOSE)
	end
}

script Zone21A_EventScript_Ally {
	trainerbattle_single(TRAINER_PBL_ALLY, format("I've heard there's a hidden cave somewhere in the lake.\pHave you found it?"), format("I heard the cave needs true Strength to navigate!"))
	msgbox(format("I've been searching for this cave for days, and no luck!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone21A_EventScript_SecretWarp {
	lockall
	warp(MAP_ZONE21D, 255, 2, 28)
	waitstate
	releaseall
	end
}

script Zone21A_EventScript_RockyHelmet {
	lock
	if (flag(FLAG_ITEM_ZONE21A_ROCKY_HELMET)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE21A_ROCKY_HELMET)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_ROCKY_HELMET)
	release
	end
}

