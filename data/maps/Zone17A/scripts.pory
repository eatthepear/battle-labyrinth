mapscripts Zone17A_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE17A_TM_HEX)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST)
		}
	}
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_ZONE_17_STATE, 0: Zone17A_EventScript_Intro
	]
}

script Zone17A_EventScript_Intro {
	lockall
	delay(48)
	clearflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	addobject(LOCALID_HEX_MANIAC)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
	waitmovement(0)
	removeobject(LOCALID_HEX_MANIAC)
	setflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	delay(32)
	clearflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	addobject(LOCALID_HEX_MANIAC)
	delay(16)
	removeobject(LOCALID_HEX_MANIAC)
	setflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	delay(16)
	clearflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	addobject(LOCALID_HEX_MANIAC)
	delay(16)
	removeobject(LOCALID_HEX_MANIAC)
	setflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	delay(16)
	clearflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	addobject(LOCALID_HEX_MANIAC)
	delay(16)
	removeobject(LOCALID_HEX_MANIAC)
	setflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	delay(16)
	clearflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	addobject(LOCALID_HEX_MANIAC)
	delay(16)
	removeobject(LOCALID_HEX_MANIAC)
	setflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	delay(16)
	clearflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	addobject(LOCALID_HEX_MANIAC)
	delay(48)
	msgbox("Release us… Please…\pTen souls…\nTrapped here…\pInscripted in the stones…", MSGBOX_AUTOCLOSE)
	delay(16)
	removeobject(LOCALID_HEX_MANIAC)
	setflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	delay(16)
	clearflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	addobject(LOCALID_HEX_MANIAC)
	delay(16)
	removeobject(LOCALID_HEX_MANIAC)
	setflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	delay(16)
	clearflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	addobject(LOCALID_HEX_MANIAC)
	delay(16)
	removeobject(LOCALID_HEX_MANIAC)
	setflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	delay(16)
	clearflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	addobject(LOCALID_HEX_MANIAC)
	delay(16)
	removeobject(LOCALID_HEX_MANIAC)
	setflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	delay(16)
	clearflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	addobject(LOCALID_HEX_MANIAC)
	delay(8)
	removeobject(LOCALID_HEX_MANIAC)
	setflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	delay(8)
	clearflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	addobject(LOCALID_HEX_MANIAC)
	delay(8)
	removeobject(LOCALID_HEX_MANIAC)
	setflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	delay(8)
	clearflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	addobject(LOCALID_HEX_MANIAC)
	delay(8)
	removeobject(LOCALID_HEX_MANIAC)
	setflag(FLAG_HIDE_ZONE17A_HEX_MANIAC)
	delay(8)
	setvar(VAR_ZONE_17_STATE, 1)
	releaseall
	end
}

script Zone17A_EventScript_StopLeave {
	lockall
	msgbox(format("The woods ahead are too thick to traverse…"))
	applymovement(LOCALID_PLAYER, Common_Movement_WalkUp)
	waitmovement(0)
	releaseall
	end
}

script Zone17A_EventScript_RiddleSign {
	lock
	checkitem(ITEM_ODD_KEYSTONE, 1)
	if (var(VAR_RESULT) == TRUE) {
		msgbox("There is a spot that looks like it\ncan fit the Odd Keystone.\pWould you like to place the\nOdd Keystone?", MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			goto(Zone17A_StartSpiritombBattle)
		}
	}
	if (var(VAR_ZONE_17_STATE) == 21) {
		goto(Zone17A_EventScript_InitiateBossBattle)
	} else {
		msgbox(Zone17A_Text_RiddleSign, MSGBOX_SIGN)
	}
	release
	end

}

text Zone17A_Text_RiddleSign {
	"We celebrate the day of life\n"
	"With boundless splurge and wonder,\p"
	"We celebrate the day of death\n"
	"With rain, lightning, and thunder,\p"
	"Remember every cherished date,\n"
	"And pay respects aplenty,\p"
	"Another year of special days,\n"
	"The right order of twenty."
}

script Zone17A_EventScript_InitiateBossBattle {
	playse(SE_M_NIGHTMARE)
	waitse
	setspeaker("Leaf")
	msgbox(format("Uh oh, I don't feel so good."))
	playse(SE_M_NIGHTMARE)
	waitse
	msgbox(format("Something is wrong with Leaf! Her eyes look possessed."))
	getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
	if (var(VAR_TEMP_0) == 12) {
		applymovement(LOCALID_17A_LEAF, Common_Movement_WalkDown)
		waitmovement(0)
		applymovement(LOCALID_17A_LEAF, Common_Movement_WalkLeft2)
		waitmovement(0)
		applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
		waitmovement(0)
		applymovement(LOCALID_17A_LEAF, Common_Movement_WalkUp)
		waitmovement(0)
	} elif (var(VAR_TEMP_1) == 9) {
		applymovement(LOCALID_PLAYER, Common_Movement_FaceRight)
		waitmovement(0)
		applymovement(LOCALID_17A_LEAF, Common_Movement_WalkDown)
		waitmovement(0)
		applymovement(LOCALID_17A_LEAF, Common_Movement_FaceLeft)
		waitmovement(0)
	} elif (var(VAR_TEMP_1) == 7) {
		applymovement(LOCALID_PLAYER, Common_Movement_FaceRight)
		waitmovement(0)
		applymovement(LOCALID_17A_LEAF, Common_Movement_WalkUp)
		waitmovement(0)
		applymovement(LOCALID_17A_LEAF, Common_Movement_FaceLeft)
		waitmovement(0)
	}
	setspeaker("Leaf?")
	msgbox(format("Ah, this body will do well."))
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_LEAF_BOSS_17, format("No!!!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setflag(FLAG_BEAT_BOSS_17)
	setspeaker("Leaf")
	msgbox(format("Uh, where am I? Did you solve the riddle?"))
	msgbox("There's something shimmering on the\nground by your feet!", MSGBOX_DEFAULT)
	giveitem(ITEM_TM29)
	clearflag(FLAG_HIDE_ZONE17A_PORYGON)
	setvar(VAR_ZONE_17_STATE, 22)
	release
	end
}

script Zone17A_StartSpiritombBattle {
	removeitem(ITEM_ODD_KEYSTONE)
	msgbox("{PLAYER} placed the Odd Keystone.", MSGBOX_AUTOCLOSE)
	delay(48)
	setwildbattle(SPECIES_SPIRITOMB, 45, ITEM_NONE)
	playmoncry(SPECIES_SPIRITOMB, 2)
	delay(40)
	waitmoncry
	dowildbattle
	specialvar(VAR_RESULT, GetBattleOutcome)
	if (var(VAR_RESULT) == B_OUTCOME_RAN) {
		msgbox("Spiritomb disappeared…")
	}
	if (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) {
		msgbox("Spiritomb disappeared…")
	}
	release
	end
}

// The dates are:
// 1 - Jul 27
// 1 - Sep 14
// 2 - Nov 9
// 2 - May 24
// 3 - Dec 13
// 3 - Jul 5
// 4 - Feb 25
// 4 - Jun 22
// 5 - Apr 28
// 5 - Oct 1
// 6 - Jan 4
// 6 - Aug 10
// 7 - Oct 11
// 7 - Feb 16
// 8 - Mar 2
// 8 - Nov 21
// 9 - Aug 20
// 9 - Jan 6
// 10 - Jun 7
// 10 - Jun 23

// So the correct order to talk to them is:
// 6 - Jan 4
// 9 - Jan 6
// 7 - Feb 16
// 4 - Feb 25
// 8 - Mar 2
// 5 - Apr 28
// 2 - May 24
// 10 - Jun 7
// 4 - Jun 22
// 10 - Jun 23
// 3 - Jul 5
// 1 - Jul 27
// 6 - Aug 10
// 9 - Aug 20
// 1 - Sep 14
// 5 - Oct 1
// 7 - Oct 11
// 2 - Nov 9
// 8 - Nov 21
// 3 - Dec 13

script Zone17A_EventScript_Sign1 {
	lock
	msgbox(format("July 27, '40 - September 14, '02\nThe name has been eroded off…"), MSGBOX_SIGN)
	if (var(VAR_ZONE_17_STATE) == 12) {
		msgbox(Zone17A_Text_PayRespects, MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			msgbox(Zone17A_Text_PaidRespects, MSGBOX_AUTOCLOSE)
			setvar(VAR_ZONE_17_STATE, 13)
		}
	} elif (var(VAR_ZONE_17_STATE) == 15) {
		msgbox(Zone17A_Text_PayRespects, MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			msgbox(Zone17A_Text_PaidRespects, MSGBOX_AUTOCLOSE)
			setvar(VAR_ZONE_17_STATE, 16)
		}
	}
	release
	end
}

