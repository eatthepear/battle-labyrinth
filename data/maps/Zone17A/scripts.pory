mapscripts Zone17A_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE17A_TM_HEX)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST)
		}
	}
}

script Zone17A_EventScript_Intro {
	lockall
	applymovement(LOCALID_17A_LACEY, Common_Movement_FaceDown)
	waitmovement(0)
	applymovement(LOCALID_17A_LACEY, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	call(Zone17A_EventScript_WalkToPlayer)
	setspeaker("???")
	msgbox(format("Ah! You scared me!\pI thought you were a ghost.\pUm… Who are you, and what are you doing in as dangerous a place as Mt. Grief?"))
	closemessage
	delay(40)
	setspeaker("???")
	msgbox(format("Ah, so you're {PLAYER}.\pI'd love to meet you properly, but I don't really want to stay here any longer than necessary.\pMy name is Lacey. I'm a Pokémon trainer, just like you."))
	closemessage
	setspeaker("Lacey")
	call(Sanctuary_EventScript_MoveCameraUp)
	applymovement(LOCALID_17A_LACEY, Common_Movement_FaceUp)
	waitmovement(0)
	setspeaker("Lacey")
	msgbox(format("I had heard rumors that Mt. Grief was being haunted by a malevolent spirit that possessed people.\pI came here in hopes of calming the spirit, and bringing peace to this mountain top.\pBut I'm not sure how to calm the spirit down…\pThere's some sort of… poem? Inscribed in the rock at the top.\pPerhaps that holds the key?"))
	applymovement(LOCALID_17A_LACEY, Common_Movement_FaceDown)
	waitmovement(0)
	setspeaker("Lacey")
	msgbox(format("Please, help me out!"))
	closemessage
	switch (var(VAR_TEMP_0)) {
		case 12:
			applymovement(LOCALID_17A_LACEY, Zone17A_Movement_Lacey_WalkBackFromLeft)
			waitmovement(0)
		case 13:
			applymovement(LOCALID_17A_LACEY, Zone17A_Movement_Lacey_WalkBackFromMiddle)
			waitmovement(0)
		case 14:
			applymovement(LOCALID_17A_LACEY, Zone17A_Movement_Lacey_WalkBackFromRight)
			waitmovement(0)
	}
	call(Sanctuary_EventScript_MoveCameraDown)
	setvar(VAR_ZONE_17_STATE, 1)
	releaseall
	end
}

script Zone17A_EventScript_WalkToPlayer {
	getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
	switch (var(VAR_TEMP_0)) {
		case 12:
			applymovement(LOCALID_17A_LACEY, Zone17A_Movement_Lacey_WalkToLeft)
			waitmovement(0)
		case 13:
			applymovement(LOCALID_17A_LACEY, Zone17A_Movement_Lacey_WalkToMiddle)
			waitmovement(0)
		case 14:
			applymovement(LOCALID_17A_LACEY, Common_Movement_WalkDown2)
			waitmovement(0)
	}
}

movement Zone17A_Movement_Lacey_WalkToLeft {
	walk_down * 2
	walk_left * 2
	face_down
}

movement Zone17A_Movement_Lacey_WalkToMiddle {
	walk_down * 2
	walk_left
	face_down
}

movement Zone17A_Movement_Lacey_WalkBackFromLeft {
	walk_right * 2
	walk_up * 2
	face_left
}

movement Zone17A_Movement_Lacey_WalkBackFromMiddle {
	walk_right
	walk_up * 2
	face_left
}

movement Zone17A_Movement_Lacey_WalkBackFromRight {
	walk_up * 2
	face_left
}

script Zone17A_EventScript_Lacey {
	lock
	faceplayer
	setspeaker("Lacey")
	msgbox(format("I used to come here with my father to see my grandmother's grave every year.\pTo see it like this…\pI need to find that malevolent spirit, and calm it down as fast as possible.\pPlease help me!"))
	applymovement(LOCALID_17A_LACEY, Common_Movement_FaceLeft)
	waitmovement(0)
	release
	end
}

script Zone17A_EventScript_StopLeave {
	lockall
	msgbox(format("The woods ahead are too thick to traverse…"))
	applymovement(LOCALID_PLAYER, Common_Movement_WalkUp)
	waitmovement(0)
	releaseall
	end
}

script Zone17A_EventScript_RiddleSign {
	lock
	checkitem(ITEM_ODD_KEYSTONE, 1)
	if (var(VAR_RESULT) == TRUE) {
		msgbox("There is a spot that looks like it\ncan fit the Odd Keystone.\pWould you like to place the\nOdd Keystone?", MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			goto(Zone17A_StartSpiritombBattle)
		}
	}
	msgbox(Zone17A_Text_RiddleSign, MSGBOX_SIGN)
	release
	end
}

text Zone17A_Text_RiddleSign {
	"We celebrate the day of life\n"
	"With boundless splurge and wonder,\p"
	"We celebrate the day of death\n"
	"With rain, lightning, and thunder,\p"
	"Remember every cherished date,\n"
	"And pay respects aplenty,\p"
	"Another year of special days,\n"
	"The right order of twenty."
}

script Zone17A_EventScript_InitiateBossBattle {
	lockall
	fadeoutbgm(1)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
	waitmovement(0)
	call(Sanctuary_EventScript_MoveCameraUp)
	playse(SE_M_NIGHTMARE)
	waitse
	setspeaker("Lacey")
	msgbox(format("Uh oh, I don't feel so good."))
	playse(SE_M_NIGHTMARE)
	waitse
	call(Sanctuary_EventScript_MoveCameraDown)
	call(Zone17A_EventScript_WalkToPlayer)
	setspeaker(SP_NAME_NONE)
	msgbox(format("Something is wrong with Lacey! Her eyes look possessed."))
	setspeaker("Lacey?")
	msgbox(format("Ah, this body will do well."))
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_LACEY_BOSS_17, format("No!!!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Lacey")
	msgbox(format("Uh, where am I? Did you find the spirit?"))
	closemessage
	delay(40)
	setspeaker("Lacey")
	msgbox(format("Wait, it possessed me!? And you beat me in battle!?\pWell, I don't sense the presence of the spirit anymore, so…\pGreat job, {PLAYER}! Amazing work.\pHere, I want you to take this."))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_HM_DIVE)
	setspeaker("Lacey")
	msgbox(format("It looks like our job is done here.\pSay, I do want to battle you again some day, for real this time. And preferably without getting possessed.\pI'm looking forward to that day!\pSee you later, {PLAYER}!"))
	closemessage
	getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
	if (var(VAR_TEMP_0) == 12) {
		applymovement(LOCALID_17A_LACEY, Zone17A_Movement_Lacey_WalkAwayLeft)
		waitmovement(0)
	} else {
		applymovement(LOCALID_17A_LACEY, Zone17A_Movement_Lacey_WalkAway)
		waitmovement(0)
	}
	clearflag(FLAG_HIDE_ZONE17A_PORYGON)
	removeobject(LOCALID_17A_LACEY)
	setflag(FLAG_BEAT_BOSS_17)
	setvar(VAR_ZONE_17_STATE, 22)
	fadedefaultbgm
	release
	end
}

movement Zone17A_Movement_Lacey_WalkAwayLeft {
	walk_right
	walk_down * 6
}

movement Zone17A_Movement_Lacey_WalkAway {
	walk_left
	walk_down * 6
}

script Zone17A_StartSpiritombBattle {
	removeitem(ITEM_ODD_KEYSTONE)
	msgbox("{PLAYER} placed the Odd Keystone.", MSGBOX_AUTOCLOSE)
	delay(48)
	setwildbattle(SPECIES_SPIRITOMB, 45, ITEM_NONE)
	playmoncry(SPECIES_SPIRITOMB, 2)
	delay(40)
	waitmoncry
	dowildbattle
	specialvar(VAR_RESULT, GetBattleOutcome)
	if (var(VAR_RESULT) == B_OUTCOME_RAN) {
		msgbox("Spiritomb disappeared…")
	}
	if (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) {
		msgbox("Spiritomb disappeared…")
	}
	release
	end
}

