script Zone17A_EventScript_SolvedPuzzle {
	closemessage
	playse(SE_M_PERISH_SONG)
	waitmessage
	msgbox(format("There was a strange song that played for a moment.\pBetter check the inscription at the top of the mountain again."))
}

script Zone17A_EventScript_Sign1 {
	lock
	msgbox(format("July 27, '40 - September 14, '02\nThe name has been eroded off…"), MSGBOX_SIGN)
	if (var(VAR_ZONE_17_STATE) == 12) {
		msgbox(Zone17A_Text_PayRespects, MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			msgbox(Zone17A_Text_PaidRespects, MSGBOX_AUTOCLOSE)
			setvar(VAR_ZONE_17_STATE, 13)
		}
	} elif (var(VAR_ZONE_17_STATE) == 15) {
		msgbox(Zone17A_Text_PayRespects, MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			msgbox(Zone17A_Text_PaidRespects, MSGBOX_AUTOCLOSE)
			setvar(VAR_ZONE_17_STATE, 16)
		}
	}
	release
	end
}

