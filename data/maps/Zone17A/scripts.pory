text Zone17A_Text_PayRespects {
	format("Would you like to pay respects?")
}

text Zone17A_Text_PaidRespects {
	format("{PLAYER} paid respects to the dead.")
}

script Zone17A_EventScript_TMHex {
	lock
	if (flag(FLAG_ITEM_ZONE17A_TM_HEX)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE17A_TM_HEX)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_TM_HEX, 1)
	release
	end
}
