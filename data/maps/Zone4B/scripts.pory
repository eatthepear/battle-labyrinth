mapscripts Zone4B_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE4B_RANDOM_1)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
	}
}

script Zone4B_EventScript_Roughneck {
	lock
	if (flag(FLAG_ZONE4B_RECEIVED_TM_THIEF)) {
		msgbox(format("I'm totally not stealing this sign.\pJust… admiring it."))
		release
		end
	}
	msgbox(format("I'm a kleptomaniac - that is, someone with the inability to resist the urge to steal items.\pThat's what the dictionary said, anyways.\pI'm… totally not thinking about stealing this sign."), MSGBOX_AUTOCLOSE)
	faceplayer
	msgbox(format("Your Pokémon can learn how to steal too. Take this TM."))
	giveitem(ITEM_TM_THIEF)
	msgbox(format("Now, run along. You didn't see me here, okay?"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_4B_ROUGHNECK, Common_Movement_FaceRight)
	waitmovement(0)
	setflag(FLAG_ZONE4B_RECEIVED_TM_THIEF)
	release
	end
}

script Zone4B_EventScript_Random1 {
	lock
	if (flag(FLAG_ITEM_ZONE4B_RANDOM_1)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE4B_RANDOM_1)
	addobject(VAR_LAST_TALKED)
	specialvar(VAR_TEMP_1, RandomItemChest)
	finditem(VAR_TEMP_1, VAR_TEMP_0)
	release
	end
}

raw `
Zone4B_EventScript_Ralph::
	trainerbattle_single TRAINER_PBL_RALPH, Zone4B_Text_RalphIntro, Zone4B_Text_RalphDefeat
	msgbox Zone4B_Text_RalphPostBattle, MSGBOX_AUTOCLOSE
	end

Zone4B_Text_RalphIntro:
	.string "Ugh, where am I? Maybe you'll\n"
	.string "tell me if I beat you!$"

Zone4B_Text_RalphDefeat:
	.string "You don't know either? Oof!$"

Zone4B_Text_RalphPostBattle:
	.string "I guess the more important question is,\n"
	.string "where am I going?$"
`
