mapscripts RainyBog_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflashlevel(1)
    }
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_RAINY_BOG_TM_GRASS_KNOT)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST)
		}
    }
}

script RainyBog_EventScript_Grotto {
	lock
	call(EventScript_FoundGrotto)
	warp(MAP_HIDDEN_GROTTO_RAINY_BOG, 0)
	waitstate
	release
	end
}

script RainyBog_EventScript_BirdKeeperFlyingTaxi {
    lock
    faceplayer
    msgbox(format("Flying Taxi at your service! Express flight to Peaceful Grove! All aboard?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("Alrighty, we'll be here, awaiting our next passenger!"))
        release
        end
    }
    applymovement(LOCALID_BIRD_KEEPER_RAINY_BOG, Common_Movement_FaceRight)
    waitmovement(0)
    msgbox(format("Rufflet! Use Fly!"))
	setspeaker("Rufflet")
	playmoncry(SPECIES_RUFFLET, CRY_MODE_NORMAL)
	msgbox(format("Flet!"))
    warp(MAP_ZONE_SANCTUARY_PEACEFUL_GROVE, 255, 19, 6)
    waitstate
    end
}

script RainyBog_EventScript_TMGrassKnot {
	lock
	if (flag(FLAG_ITEM_RAINY_BOG_TM_GRASS_KNOT)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
	setflag(FLAG_ITEM_RAINY_BOG_TM_GRASS_KNOT)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_TM_GRASS_KNOT, 1)
	release
	end
}
