mapscripts Zone34A_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        clearflag(FLAG_SYS_NO_RUNNING)
        clearflag(FLAG_SYS_NO_CATCHING)
        clearflag(FLAG_SYS_SMART_WILD_AI_ON)
        clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
    }
}

script Zone30_EventScript_RocketGrunt_Guard {
    lock
	setspeaker("Grunt")
	msgbox(format("GUARD!"))
	release
	end
}

script Zone34_EventScript_RocketGrunt_1 {
	trainerbattle_single(TRAINER_PBL_ROCKET_GRUNT_34_1, format("BATTLE!"), format("DEFEAT!"))
	msgbox(format("DEFEATED!"), MSGBOX_AUTOCLOSE)
	end
}

