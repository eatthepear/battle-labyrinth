mapscripts Zone28B_MapScripts {}

script Zone28B_EventScript_Fernando {
	trainerbattle_single(TRAINER_PBL_FERNANDO, format("BATTLE!"), format("DEFEAT!"))
	msgbox(format("DEFEATED!"), MSGBOX_AUTOCLOSE)
	end
}

