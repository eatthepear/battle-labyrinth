mapscripts Zone30A_MapScripts {}

// template door script
script Zone30_EventScript_Door1 {
	lockall
	setvar(VAR_TEMP_1, 1) // 1 = magma, 2 = aqua, 3 = galactic, 4 = rocket
	// setvar VAR_0x8004, FLAG_SILPH_4F_DOOR_1
    // if (flag(FLAG_SILPH_4F_DOOR_1)) {
    //     goto(Zone30_EventScript_DoorUnlocked)
    // }
    call(Zone30_EventScript_CheckCanOpenDoor)
	// call(EventScript_Open2FDoor1)
	waitse
	playse(SE_UNLOCK)
	special(DrawWholeMapView)
	waitse
	// special(SetHiddenItemFlag)
	releaseall
	end
}

script Zone30_EventScript_CheckCanOpenDoor {
    if (!checkitem(ITEM_CARD_KEY)) {
        msgbox(format("No!\nIt needs a CARD KEY!"))
        releaseall
        end
    }
    switch (var(VAR_TEMP_1)) {
        case 1:
            if (var(VAR_ZONE_30_STATE) < 1) {
                msgbox(format("Your Card Key isn't registered for this floor!"))
                releaseall
                end
            }
        case 2:
            if (var(VAR_ZONE_30_STATE) < 1) {
                msgbox(format("Your Card Key isn't registered for this floor!"))
                releaseall
                end
            }
        case 3:
            if (var(VAR_ZONE_30_STATE) < 1) {
                msgbox(format("Your Card Key isn't registered for this floor!"))
                releaseall
                end
            }
        case 4:
            if (var(VAR_ZONE_30_STATE) < 1) {
                msgbox(format("Your Card Key isn't registered for this floor!"))
                releaseall
                end
            }
    }
	playfanfare(MUS_LEVEL_UP)
	msgbox(format("Bingo!\nThe CARD KEY opened the door!"))
	waitfanfare
    return
}

script Zone30_EventScript_DoorUnlocked {
	msgbox(format("The door is open…"))
	releaseall
	end
}

