script Zone30_EventScript_CheckCanOpenDoor {
    if (!checkitem(ITEM_CARD_KEY)) {
        msgbox(format("No!\nIt needs a {COLOR GREEN}Card Key{COLOR DARK_GRAY}!"))
        releaseall
        end
    }
    switch (var(VAR_TEMP_1)) {
        case 1:
            if (var(VAR_ZONE_30_STATE) < 1) {
                msgbox(format("Your {COLOR GREEN}Card Key{COLOR DARK_GRAY} isn't registered for this floor!"))
                releaseall
                end
            }
        case 2:
            if (var(VAR_ZONE_30_STATE) < 3) {
                msgbox(format("Your {COLOR GREEN}Card Key{COLOR DARK_GRAY} isn't registered for this floor!"))
                releaseall
                end
            }
        case 3:
            if (var(VAR_ZONE_30_STATE) < 5) {
                msgbox(format("Your {COLOR GREEN}Card Key{COLOR DARK_GRAY} isn't registered for this floor!"))
                releaseall
                end
            }
        case 4:
            if (var(VAR_ZONE_30_STATE) < 7) {
                msgbox(format("Your {COLOR GREEN}Card Key{COLOR DARK_GRAY} isn't registered for this floor!"))
                releaseall
                end
            }
        case 5:
            if (var(VAR_ZONE_30_STATE) < 9) {
                msgbox(format("Your {COLOR GREEN}Card Key{COLOR DARK_GRAY} isn't registered for this floor!"))
                releaseall
                end
            }
    }
	playfanfare(MUS_LEVEL_UP)
	msgbox(format("Bingo!\nThe {COLOR GREEN}Card Key{COLOR DARK_GRAY} opened the door!"))
	waitfanfare
    return
}

script Zone30_EventScript_DoorUnlocked {
	msgbox(format("The door is open…"))
	releaseall
	end
}

