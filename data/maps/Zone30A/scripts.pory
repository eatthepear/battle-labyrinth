mapscripts Zone30A_MapScripts {}

script ZoneSanctuary_EventScript_Zone30AEventStart {
	closemessage
	fadeoutbgm(1)
	setspeaker(SP_NAME_COLRESS)
	msgbox(format("Wait a moment."), MSGBOX_AUTOCLOSE)
	delay(40)
	setspeaker(SP_NAME_COLRESS)
	msgbox(format("Zone 30… {COLOR GREEN}Sanctuary{COLOR DARK_GRAY}?\pThat makes no sense, unless…"))
	closemessage	
	hidefollower
	special(SpawnCameraObject)
	applymovement(LOCALID_CAMERA, Common_Movement_WalkUp2)
	waitmovement(0)
	playbgm(MUS_HG_ROCKET_TAKEOVER, TRUE)
	clearflag(FLAG_HIDE_SANCTUARY_PROTON_GRUNTS)
	addobject(LOCALID_PROTON_GRUNT_1_SANCTUARY)
	addobject(LOCALID_PROTON_GRUNT_2_SANCTUARY)
	applymovement(LOCALID_COLRESS, Common_Movement_FaceUp)
	waitmovement(0)
	applymovement(LOCALID_COLRESS, Common_Movement_ExclamationMark)
	applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	applymovement(LOCALID_PROTON_GRUNT_1_SANCTUARY, Common_Movement_WalkDown2)
	applymovement(LOCALID_PROTON_GRUNT_2_SANCTUARY, Common_Movement_WalkDown2)
	waitmovement(0)
	setspeaker(SP_NAME_COLRESS)
	msgbox(format("{COLOR GREEN}Team Rainbow Rocket{COLOR DARK_GRAY}! They're here!"))
	closemessage
	addobject(LOCALID_PROTON_SANCTUARY)
	clearflag(FLAG_HIDE_SANCTUARY_PROTON)
	applymovement(LOCALID_PROTON_SANCTUARY, Common_Movement_WalkDown3)
	waitmovement(0)
	setspeaker("Proton")
	msgbox(format("Wahaha! Surprised to see me again? I'm one of three Rainbow Rocket Executives leading this takeover! Now, boys, take him!"))
	setspeaker(SP_NAME_COLRESS)
	msgbox(format("This shouldn't be possible! You aren't programmed to do this!"))
	setspeaker("Proton")
	msgbox(format("Shut your yapping!"))
	closemessage
	applymovement(LOCALID_PROTON_GRUNT_1_SANCTUARY, Common_Movement_WalkDown)
	applymovement(LOCALID_PROTON_GRUNT_2_SANCTUARY, Common_Movement_WalkDown)
	waitmovement(0)
	playmoncry(SPECIES_MAGNEMITE, CRY_MODE_NORMAL)
	msgbox(format("Bzzt…"), MSGBOX_AUTOCLOSE)
	waitmoncry
	setflag(FLAG_HIDE_SANCTUARY_MAGNEMITES)
	removeobject(LOCALID_MAGNEMITE_1)
	removeobject(LOCALID_MAGNEMITE_2)
	applymovement(LOCALID_PROTON_GRUNT_1_SANCTUARY, Common_Movement_WalkDown)
	applymovement(LOCALID_PROTON_GRUNT_2_SANCTUARY, Common_Movement_WalkDown)
	applymovement(LOCALID_PLAYER, Common_Movement_WalkDown2)
	waitmovement(0)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
	waitmovement(0)
	applymovement(LOCALID_PROTON_GRUNT_1_SANCTUARY, Common_Movement_FaceRight)
	applymovement(LOCALID_PROTON_GRUNT_2_SANCTUARY, Common_Movement_FaceLeft)
	applymovement(LOCALID_COLRESS, Common_Movement_FaceLeft)
	waitmovement(0)
	delay(40)
	applymovement(LOCALID_COLRESS, Common_Movement_FaceRight)
	waitmovement(0)
	setspeaker(SP_NAME_COLRESS)
	msgbox(format("Unhand me!"))
	setspeaker("Proton")
	msgbox(format("Take him away while I keep this punk distracted!"))
	setspeaker("Grunts")
	msgbox(format("Yes, sir!"))
	applymovement(LOCALID_COLRESS, Common_Movement_FaceDown)
	waitmovement(0)
	applymovement(LOCALID_CAMERA, Common_Movement_WalkDown4)
	waitmovement(0)
	special(RemoveCameraObject)
	setspeaker(SP_NAME_COLRESS)
	msgbox(format("This isn't right! You have to stop them, {PLAYER}!"))
	closemessage
	applymovement(LOCALID_PROTON_GRUNT_1_SANCTUARY, ZoneSanctuary_Movement_ProtonGrunt1_DragAway)
	applymovement(LOCALID_PROTON_GRUNT_2_SANCTUARY, ZoneSanctuary_Movement_ProtonGrunt2_DragAway)
	applymovement(LOCALID_PROTON_SANCTUARY, Common_Movement_FaceLeft)
	applymovement(LOCALID_COLRESS, ZoneSanctuary_Movement_Colress_DragAway)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
	waitmovement(LOCALID_PROTON_GRUNT_2_SANCTUARY)
	setflag(FLAG_HIDE_SANCTUARY_PROTON_GRUNTS)
	setflag(FLAG_HIDE_SANCTUARY_COLRESS)
	removeobject(LOCALID_PROTON_GRUNT_1_SANCTUARY)
	removeobject(LOCALID_PROTON_GRUNT_2_SANCTUARY)
	removeobject(LOCALID_COLRESS)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
	applymovement(LOCALID_PROTON_SANCTUARY, Common_Movement_WalkDown3)
	waitmovement(0)
	setspeaker("Proton")
	msgbox(format("Now, time to deal with you!\pI've had plenty of time to think on my last defeat!"))
	trainerbattle_no_intro(TRAINER_PBL_PROTON_BOSS_30, format("DEFEATED!"))
	setspeaker("Proton")
	msgbox(format("My defeat here means nothing!\pAll the other admins are here as well!\pThe Sanctuary, and Pokemon Battle Labyrinth, will be ours!"))
	closemessage
	clearflag(FLAG_HIDE_SANCTUARY_ARCHER)
	addobject(LOCALID_ARCHER_SANCTUARY)
	applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
	applymovement(LOCALID_ARCHER_SANCTUARY, Common_Movement_WalkDown5)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	setspeaker("Archer")
	msgbox(format("Well, well, well. What do we have here? Proton, losing to a child again?"))
	clearflag(FLAG_HIDE_SANCTUARY_ARIANA)
	addobject(LOCALID_ARIANA_SANCTUARY)
	applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
	applymovement(LOCALID_ARIANA_SANCTUARY, Common_Movement_WalkDown5)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	setspeaker("Ariana")
	msgbox(format("Tsk, tsk. Surprised, {PLAYER}?\pProton, retreat for now. Us true Admins will handle this."))
	setspeaker("Proton")
	msgbox(format("Argh!"))
	closemessage
	applymovement(LOCALID_PROTON_SANCTUARY, Common_Movement_WalkUp5)
	waitmovement(0)
	setflag(FLAG_HIDE_SANCTUARY_PROTON)
	removeobject(LOCALID_PROTON_SANCTUARY)
	setspeaker("Archer")
	msgbox(format("WE ARE COORDINATE!"))
	setspeaker("Ariana")
	msgbox(format("HERE ARE OUR ALLIES!"))
	closemessage
	applymovement(LOCALID_ARCHER_SANCTUARY, Common_Movement_WalkLeft)
	applymovement(LOCALID_ARIANA_SANCTUARY, Common_Movement_WalkRight)
	waitmovement(0)
	applymovement(LOCALID_ARCHER_SANCTUARY, Common_Movement_FaceDown)
	applymovement(LOCALID_ARIANA_SANCTUARY, Common_Movement_FaceDown)
	waitmovement(0)

	clearflag(FLAG_HIDE_SANCTUARY_MAGMA)
	addobject(LOCALID_TABITHA_SANCTUARY)
	addobject(LOCALID_COURTNEY_SANCTUARY)
	applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
	applymovement(LOCALID_TABITHA_SANCTUARY, Common_Movement_WalkDown5)
	applymovement(LOCALID_COURTNEY_SANCTUARY, Common_Movement_WalkDown5)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	msgbox(format("TALK"))
	closemessage
	applymovement(LOCALID_TABITHA_SANCTUARY, ZoneSanctuary_Movement_Left_WalkLeft)
	applymovement(LOCALID_COURTNEY_SANCTUARY, ZoneSanctuary_Movement_Right_WalkLeft)
	waitmovement(0)
	setflag(FLAG_HIDE_SANCTUARY_MAGMA)
	removeobject(LOCALID_TABITHA_SANCTUARY)
	removeobject(LOCALID_COURTNEY_SANCTUARY)

	clearflag(FLAG_HIDE_SANCTUARY_AQUA)
	addobject(LOCALID_SHELLY_SANCTUARY)
	addobject(LOCALID_MATT_SANCTUARY)
	applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
	applymovement(LOCALID_SHELLY_SANCTUARY, Common_Movement_WalkDown5)
	applymovement(LOCALID_MATT_SANCTUARY, Common_Movement_WalkDown5)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	msgbox(format("TALK"))
	closemessage
	applymovement(LOCALID_SHELLY_SANCTUARY, ZoneSanctuary_Movement_Left_WalkRight)
	applymovement(LOCALID_MATT_SANCTUARY, ZoneSanctuary_Movement_Right_WalkRight)
	waitmovement(0)
	setflag(FLAG_HIDE_SANCTUARY_AQUA)
	removeobject(LOCALID_SHELLY_SANCTUARY)
	removeobject(LOCALID_MATT_SANCTUARY)

	clearflag(FLAG_HIDE_SANCTUARY_GALACTIC)
	addobject(LOCALID_MARS_SANCTUARY)
	addobject(LOCALID_JUPITER_SANCTUARY)
	applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
	applymovement(LOCALID_MARS_SANCTUARY, Common_Movement_WalkDown5)
	applymovement(LOCALID_JUPITER_SANCTUARY, Common_Movement_WalkDown5)
	playse(SE_PIN)
	waitmovement(0)
	waitse
	msgbox(format("TALK"))
	closemessage
	applymovement(LOCALID_MARS_SANCTUARY, ZoneSanctuary_Movement_Left_WalkLeft)
	applymovement(LOCALID_JUPITER_SANCTUARY, ZoneSanctuary_Movement_Right_WalkLeft)
	waitmovement(0)
	setflag(FLAG_HIDE_SANCTUARY_GALACTIC)
	removeobject(LOCALID_MARS_SANCTUARY)
	removeobject(LOCALID_JUPITER_SANCTUARY)

	clearflag(FLAG_HIDE_SANCTUARY_SERENA)
	addobject(LOCALID_SERENA_SANCTUARY)
	applymovement(LOCALID_SERENA_SANCTUARY, ZoneSanctuary_Movement_Rival_IntroRunUp)
	waitmovement(0)
	msgbox(format("{PLAYER}! The villainous teams! They're invading! We need to retreat to the Pokemon Center, come on!"))
	closemessage
	applymovement(LOCALID_SERENA_SANCTUARY, ZoneSanctuary_Movement_Rival_IntroRunAway)
	applymovement(LOCALID_PLAYER, ZoneSanctuary_Movement_Player_IntroRunAway)
	fadescreenspeed(FADE_TO_BLACK, 12)
	setvar(VAR_SANCTUARY_STATE, 1)
	warp(MAP_ZONE_SANCTUARY_POKEMON_CENTER_1F, 0)
	waitstate

	release
	end
}

movement ZoneSanctuary_Movement_ProtonGrunt1_DragAway {
	walk_down * 3
	walk_left
	walk_diag_southwest * 4
	walk_left * 2
}

movement ZoneSanctuary_Movement_ProtonGrunt2_DragAway {
	walk_left * 2
	walk_down * 3
	walk_left
	walk_diag_southwest * 4
	walk_left * 2
}

movement ZoneSanctuary_Movement_Colress_DragAway {
	walk_left
	walk_down * 3
	walk_left
	walk_diag_southwest * 4
	walk_left * 2
}

movement ZoneSanctuary_Movement_Proton_RunAway {
	walk_fast_down
	walk_fast_left * 2
	walk_diag_southwest * 4
	walk_left * 2
}

movement ZoneSanctuary_Movement_Left_WalkLeft {
	delay_16
	walk_down
	walk_left
	walk_diag_southwest * 4
	walk_left * 2
}

movement ZoneSanctuary_Movement_Right_WalkLeft {
	walk_left * 2
	walk_down
	walk_left
	walk_diag_southwest * 4
	walk_left * 2
}

movement ZoneSanctuary_Movement_Left_WalkRight {
	walk_right * 2
	walk_down
	walk_right
	walk_diag_southeast * 4
	walk_right * 2
}

movement ZoneSanctuary_Movement_Right_WalkRight {
	delay_16
	walk_down
	walk_right
	walk_diag_southeast * 4
	walk_right * 2
}

movement ZoneSanctuary_Movement_Rival_IntroRunUp {
	walk_left * 2
	walk_diag_northwest * 4
	walk_left
}

movement ZoneSanctuary_Movement_Player_IntroRunAway {
	walk_right * 2
	walk_diag_southeast * 4
	walk_right * 10
}

movement ZoneSanctuary_Movement_Rival_IntroRunAway {
	walk_right
	walk_diag_southeast * 4
	walk_right * 10
}
