mapscripts Zone22A_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE22A_LIGHT_CLAY)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
	}
}

script Zone22A_EventScript_CallForHelp {
	lockall
	setspeaker("???")
	msgbox(format("Help! Someone!"))
	setspeaker(SP_NAME_NONE)
	msgbox(format("It sounds like someone is calling for help to the south of here!"), MSGBOX_AUTOCLOSE)
	setvar(VAR_ZONE_22_STATE, 1)
	releaseall
	end
}

script Zone22A_EventScript_DontLeave {
	lockall
	msgbox(format("You can't just leave that person to fend for help by themselves!"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_PLAYER, Common_Movement_WalkDown)
	waitmovement(0)
	releaseall
	end
}

script Zone22A_EventScript_KimonoGirl {
	lock
	faceplayer
	playbgm(MUS_HG_KIMONO_GIRL, 0)
	getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
	if (var(VAR_TEMP_0) == 56) {
		msgbox(format("{PLAYER} gave the {COLOR BLUE}Kimono Girl{COLOR DARK_GRAY} a gentle shove!"))
		setspeaker("Kimono Girl")
		msgbox(format("I THINK I'M GOOD! THANK U! HERE'S AN HM!"))
		setspeaker(SP_NAME_NONE)
		giveitem(ITEM_HM_WATERFALL)
		setspeaker("Kimono Girl")
		msgbox(format("BYE!"), MSGBOX_AUTOCLOSE)
		applymovement(LOCALID_KIMONO_GIRL_22A, Zone22A_Movement_KimonoGirlExit)
		waitmovement(0)
		removeobject(LOCALID_KIMONO_GIRL_22A)
		setflag(FLAG_HIDE_ZONE22A_KIMONO_GIRL)
		setvar(VAR_ZONE_22_STATE, 2)
		fadedefaultbgm
		release
		end
	}
	setspeaker("Kimono Girl")
	msgbox(format("HELP! PUSH ME FROM THE RIGHT SIDE PLEASE!"))
	if (var(VAR_ZONE_22_STATE) == 0) {
		setvar(VAR_ZONE_22_STATE, 1)
	}
	fadedefaultbgm
	release
	end
}

movement Zone22A_Movement_KimonoGirlExit {
	walk_left
	slide_left * 4
	walk_left
	face_right
	delay_16 * 5
	walk_left
}

script Zone22A_EventScript_Maylene {
	lock
	faceplayer
	if (flag(FLAG_BEAT_BOSS_22)) {
		setspeaker("Maylene")
		msgbox(format("I see your potential. You can do anything you set your heart to!\pThere are other Gym Leaders, stronger than I am. Perhaps defeating them will prove a worthy challenge!"))
		release
		end
	}
	setspeaker("Maylene")
	msgbox(format("I've been waiting in eager anticipation!\pWhat have I been waiting for?\pFor a worthy challenger to appear!\pAre you that worthy challenger?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		msgbox(format("Don't keep me waiting any longer than needed!\pTake a deep breath, and prepare yourself for the climb!"), MSGBOX_AUTOCLOSE)
		releaseall
		end
	}
	msgbox(format("I have a feeling that our battle will turn out to be worth the wait!\pI hope you'll show me that your skill as a Trainer surpasses even mine."))
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_MAYLENE_BOSS_22, format("You have proven to be a wall that I am unable to surmount!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Maylene")
	msgbox(format("There are some things that seem out of reach no matter how hard you try.\pHowever, it's important that you never give up - no matter the opponent or the odds.\pI could tell from our battle that you and your Pokémon understand that.\pTo commemorate such an impressive show of teamwork, please accept the Cliff Badge!"))
	setspeaker(SP_NAME_NONE)
	playfanfare(MUS_OBTAIN_BADGE)
	msgbox(format("{PLAYER} received the Cliff Badge from {COLOR BLUE}Maylene{COLOR DARK_GRAY}!"))
	waitfanfare
	setspeaker("Maylene")
	msgbox(format("With the Cliff Badge in your grasp, you should have no issues using the HM {COLOR GREEN}Rock Smash{COLOR DARK_GRAY} outside battle!\pYour Pokémon don't need to know the move to use it, just having the HM and the requisite Gym Badge is enough!\pAh, finally, I'd like you to take these as well."))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_TM_DRAIN_PUNCH)
	// giveitem(ITEM_HARD_STONE, 1)
	msgbox(format("With {COLOR GREEN}Rock Tomb{COLOR DARK_GRAY}, a Pokémon can hurl rocks at its target, not only inflicting damage but also lowering the target's Speed.\pAnd the {COLOR GREEN}Hard Stone{COLOR DARK_GRAY} increases the damage of your Pokémon's Rock-type moves by 20%. Forms a nifty combo, huh?\pYou're just starting on your journey, so enjoy the ride and feel the breeze in your face!"))
	setflag(FLAG_BEAT_BOSS_22)
	setflag(FLAG_BADGE07_GET)
	release
	end
}

script Zone22A_EventScript_LightClay {
	lock
	if (flag(FLAG_ITEM_ZONE22A_LIGHT_CLAY)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE22A_LIGHT_CLAY)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_LIGHT_CLAY)
	release
	end
}

raw `
Zone22A_EventScript_Cody::
	trainerbattle_single TRAINER_PBL_CODY, Zone22A_Text_CodyIntro, Zone22A_Text_CodyDefeat
	msgbox Zone22A_Text_CodyPostBattle, MSGBOX_AUTOCLOSE
	end

Zone22A_Text_CodyIntro:
	.string "Running through the snow makes my\n"
	.string "workout that much more intense!$"

Zone22A_Text_CodyDefeat:
	.string "But brr! It's so cold!$"

Zone22A_Text_CodyPostBattle:
	.string "Maybe I'll stick to the treadmill\n"
	.string "next time.$"

Zone22A_EventScript_Lewis::
	trainerbattle_single TRAINER_PBL_LEWIS, Zone22A_Text_LewisIntro, Zone22A_Text_LewisDefeat
	msgbox Zone22A_Text_LewisPostBattle, MSGBOX_AUTOCLOSE
	end

Zone22A_Text_LewisIntro:
	.string "Did you know you can cancel a\n"
	.string "Pokémon's evolution?$"

Zone22A_Text_LewisDefeat:
	.string "Yeah, I just like the challenge!$"

Zone22A_Text_LewisPostBattle:
	.string "I love all Bug Pokémon, even if\n"
	.string "they're not fully evolved!$"

Zone22A_EventScript_Cornelius::
	trainerbattle_single TRAINER_PBL_CORNELIUS, Zone22A_Text_CorneliusIntro, Zone22A_Text_CorneliusDefeat
	msgbox Zone22A_Text_CorneliusPostBattle, MSGBOX_AUTOCLOSE
	end

Zone22A_Text_CorneliusIntro:
	.string "To protect all Pokémon!\n"
	.string "That's the Pokémon Ranger motto!$"

Zone22A_Text_CorneliusDefeat:
	.string "You're strong!$"

Zone22A_Text_CorneliusPostBattle:
	.string "Being a Pokémon Ranger is a really\n"
	.string "rewarding career!\p"
	.string "You should consider it!$"

Zone22A_EventScript_Helen::
	trainerbattle_single TRAINER_PBL_HELEN, Zone22A_Text_HelenIntro, Zone22A_Text_HelenDefeat
	msgbox Zone22A_Text_HelenPostBattle, MSGBOX_AUTOCLOSE
	end

Zone22A_Text_HelenIntro:
	.string "You ever just decide that today is\n"
	.string "the day you're going to picnic in a\l"
	.string "snowy forest?$"

Zone22A_Text_HelenDefeat:
	.string "Okay, I know, I'm weird.$"

Zone22A_Text_HelenPostBattle:
	.string "In my defense, this place certainly\n"
	.string "has its charm.$"

Zone22A_EventScript_Wesley::
	trainerbattle_single TRAINER_PBL_WESLEY, Zone22A_Text_WesleyIntro, Zone22A_Text_WesleyDefeat
	msgbox Zone22A_Text_WesleyPostBattle, MSGBOX_AUTOCLOSE
	end

Zone22A_Text_WesleyIntro:
	.string "Imagine! Hiking a vast, snowy\n"
	.string "mountain! Oh, the challenge!$"

Zone22A_Text_WesleyDefeat:
	.string "Oh, disappointment!$"

Zone22A_Text_WesleyPostBattle:
	.string "I think I'll stick to hiking.$"

Zone22A_EventScript_Alfredo::
	trainerbattle_single TRAINER_PBL_ALFREDO, Zone22A_Text_AlfredoIntro, Zone22A_Text_AlfredoDefeat
	msgbox Zone22A_Text_AlfredoPostBattle, MSGBOX_AUTOCLOSE
	end

Zone22A_Text_AlfredoIntro:
	.string "TRAINING! BATTLE!$"

Zone22A_Text_AlfredoDefeat:
	.string "DEFEAT!$"

Zone22A_Text_AlfredoPostBattle:
	.string "TRAINING! ONCE MORE!$"

Zone22A_EventScript_Ian::
	trainerbattle_single TRAINER_PBL_IAN, Zone22A_Text_IanIntro, Zone22A_Text_IanDefeat
	msgbox Zone22A_Text_IanPostBattle, MSGBOX_AUTOCLOSE
	end

Zone22A_Text_IanIntro:
	.string "Chestnuts roasting on an open fire…$"

Zone22A_Text_IanDefeat:
	.string "It's from a song!$"

Zone22A_Text_IanPostBattle:
	.string "But what is a chestnut anyway?$"

Zone22A_EventScript_Audrey::
	trainerbattle_single TRAINER_PBL_AUDREY, Zone22A_Text_AudreyIntro, Zone22A_Text_AudreyDefeat
	msgbox Zone22A_Text_AudreyPostBattle, MSGBOX_AUTOCLOSE
	end

Zone22A_Text_AudreyIntro:
	.string "A rare Pokémon has been spotted!$"

Zone22A_Text_AudreyDefeat:
	.string "My bad. It was just you.$"

Zone22A_Text_AudreyPostBattle:
	.string "Am I disappointed?\n"
	.string "Maybe a little bit.$"
`
