mapscripts Zone22A_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE22A_LIGHT_CLAY)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE22A_RANDOM_1)) {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE22A_RANDOM_2)) {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST)
		}
	}
}

script Zone22A_EventScript_CallForHelp {
	lockall
	setspeaker("???")
	msgbox(format("Help! Someone!"))
	setspeaker(SP_NAME_NONE)
	msgbox(format("It sounds like someone is calling for help to the southeast of here!"))
	setvar(VAR_ZONE_22_STATE, 1)
	releaseall
	end
}

script Zone22A_EventScript_DontLeave {
	lockall
	msgbox(format("You can't just leave that person to fend for help by themselves!"))
	closemessage
	applymovement(LOCALID_PLAYER, Common_Movement_WalkDown)
	waitmovement(0)
	releaseall
	end
}

script Zone22A_EventScript_KimonoGirl {
	lock
	faceplayer
	playbgm(MUS_HG_KIMONO_GIRL, 0)
	getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
	if (var(VAR_TEMP_0) == 56) {
		setspeaker("Kimono Girl")
		msgbox(format("Ah, excellent! You've navigated the ice keenly.\pPerhaps this will be of good use to you?"))
		setspeaker(SP_NAME_NONE)
		giveitem(ITEM_HM_WATERFALL)
		setspeaker("Kimono Girl")
		msgbox(format("Now, if you wouldn't mind?"))
		setspeaker(SP_NAME_NONE)
		msgbox(format("{PLAYER} gave the {COLOR BLUE}Kimono Girl{COLOR DARK_GRAY} a gentle shove!"))
		closemessage
		applymovement(LOCALID_KIMONO_GIRL_22A, Zone22A_Movement_KimonoGirlExit)
		waitmovement(0)
		removeobject(LOCALID_KIMONO_GIRL_22A)
		setflag(FLAG_HIDE_ZONE22A_KIMONO_GIRL)
		setvar(VAR_ZONE_22_STATE, 2)
		fadedefaultbgm
		release
		end
	}
	setspeaker("Kimono Girl")
	msgbox(format("Ah, my sandals have been frozen to the ice.\pWould you possibly be able to give me a push from the {COLOR GREEN}right side{COLOR DARK_GRAY}?"))
	if (var(VAR_ZONE_22_STATE) == 0) {
		setvar(VAR_ZONE_22_STATE, 1)
	}
	fadedefaultbgm
	release
	end
}

movement Zone22A_Movement_KimonoGirlExit {
	walk_left
	slide_left * 4
	walk_left
	face_right
	delay_16 * 5
	walk_left
}

script Zone22A_EventScript_Maylene {
	lock
	faceplayer
	if (flag(FLAG_BEAT_BOSS_22)) {
		setspeaker("Maylene")
		msgbox(format("I have no problem with this snow.\pI'm used to the cold because I go barefoot and lightly dressed.\p…Achoo! Oh, that was nothing. Really, I'm not cold at all."))
		release
		end
	}
	setspeaker("Maylene")
	msgbox(format("Brrr…\pOh, hello. I'm pleased to meet you.\pI'm Maylene, and I'm a Gym Leader… Achoo!\pI don't really know what it means to be strong, or how I got to be Gym Leader.\pBut I will do the best I can as the Gym Leader.\pI take battling very seriously.\pAre you ready for our battle?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		msgbox(format("Sigh… I braced myself for a battle. This is a little deflating…"), MSGBOX_AUTOCLOSE)
		releaseall
		end
	}
	msgbox(format("OK! Rei! Oh, that's my bow before a match.\pI'm throwing everything I have at you!"))
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_MAYLENE_BOSS_22, format("I shall admit defeat… You are much too strong."))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Maylene")
	msgbox(format("…OK. You win. That was a tough loss. I learned a lot from it.\pPlease, accept this Gym Badge."))
	setspeaker(SP_NAME_NONE)
	playfanfare(MUS_OBTAIN_BADGE)
	msgbox(format("{PLAYER} received the Cobble Badge from {COLOR BLUE}Maylene{COLOR DARK_GRAY}!"))
	waitfanfare
	setspeaker("Maylene")
	msgbox(format("Um… I should explain about that Badge.\pIf you have that Badge, you can use the HM Rock Climb outside of battle, which lets you scale rocky cliff faces.\pOh, and please take this as well."))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_TM_DRAIN_PUNCH)
	setspeaker("Maylene")
	msgbox(format("That TM60 contains the move Drain Punch.\pUm… That move inflicts damage, and it robs the target's HP.\pFinally, I want you to also have this."))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_FOCUS_SASH, 1)
	msgbox(format("The {COLOR GREEN}Focus Sash{COLOR DARK_GRAY} lets your Pokémon endure an attack on 1 HP, as long as they are at full health.\pNow, only one Gym Badge remains to be earned on your journey.\pYou're almost there!"))
	setflag(FLAG_BEAT_BOSS_22)
	setflag(FLAG_BADGE07_GET)
	release
	end
}

script Zone22A_EventScript_SkyTrainer {
	lockall
	applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
	waitmovement(0)
	special(SpawnCameraObject)
	applymovement(LOCALID_CAMERA, Common_Movement_WalkUp2)
	waitmovement(0)
	special(RemoveCameraObject)
	if (!defeated(TRAINER_PBL_AMELIA_OPTIONAL_22)) {
		setspeaker("Amelia")
		msgbox(format("Hello down there! Are you interested in a {COLOR GREEN}Sky Battle{COLOR DARK_GRAY}?\pIn {COLOR GREEN}Sky Battles{COLOR DARK_GRAY}, the only Pokémon allowed are most Flying-type Pokémon, as well as Pokémon with the Levitate ability.\pEven some moves aren't eligible to be used because we'd be battling in the sky.\pDo you want to have a Sky Battle with me?"), MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			special(TrySkyBattle)
			if (var(VAR_RESULT) == NO) {
				setspeaker("Amelia")
				msgbox(format("It looks like you have no eligible Pokémon for a Sky Battle!"))
			} else {
				setspeaker("Amelia")
				msgbox(format("Excellent! Show how your Pokémon soar free!"))
				trainerbattle_no_intro(TRAINER_PBL_AMELIA_OPTIONAL_22, "Crash landing!")
				setspeaker("Amelia")
				msgbox(format("You've proven yourself an expert on {COLOR GREEN}Sky Battles{COLOR DARK_GRAY}!\pHere, take this as a reward!"))
				setspeaker(SP_NAME_NONE)
				giveitem(ITEM_AIR_BALLOON)
				setspeaker("Amelia")
				msgbox(format("That {COLOR GREEN}Air Balloon{COLOR DARK_GRAY} can help Pokémon with avoiding Ground-type attacks, just like in a {COLOR GREEN}Sky Battle{COLOR DARK_GRAY}!"))
			}
		} else {
			setspeaker("Amelia")
			msgbox(format("Don't be disappointed, my Pokémon!\pI'm sure someone will want to have a {COLOR GREEN}Sky Battle{COLOR DARK_GRAY} with us!"))
		}
	} else {
		setspeaker("Amelia")
		msgbox(format("You've proven yourself an expert on {COLOR GREEN}Sky Battles{COLOR DARK_GRAY}!"))
	}
	closemessage
	special(SpawnCameraObject)
	applymovement(LOCALID_CAMERA, Common_Movement_WalkDown2)
	waitmovement(0)
	special(RemoveCameraObject)
	releaseall
	end
}

script Zone22A_EventScript_LightClay {
	lock
	if (flag(FLAG_ITEM_ZONE22A_LIGHT_CLAY)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE22A_LIGHT_CLAY)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_LIGHT_CLAY)
	release
	end
}

script Zone22A_EventScript_Random1 {
	lock
	if (flag(FLAG_ITEM_ZONE22A_RANDOM_1)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE22A_RANDOM_1)
	addobject(VAR_LAST_TALKED)
	specialvar(VAR_TEMP_1, RandomItemChest)
	finditem(VAR_TEMP_1, VAR_TEMP_0)
	release
	end
}

