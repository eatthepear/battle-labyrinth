mapscripts Zone4D_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE4D_RANDOM_1)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE4D_TM_SNARL)) {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_TM_CHEST)
		}
	}
}

script Zone4D_EventScript_Random1 {
	lock
	if (flag(FLAG_ITEM_ZONE4D_RANDOM_1)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE4D_RANDOM_1)
	addobject(VAR_LAST_TALKED)
	specialvar(VAR_TEMP_1, RandomItemChest)
	finditem(VAR_TEMP_1, VAR_TEMP_0)
	release
	end
}

script Zone4D_EventScript_TMSnarl {
	lock
	if (flag(FLAG_ITEM_ZONE4D_TM_SNARL)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_TM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE4D_TM_SNARL)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_TM_SNARL)
	release
	end
}

script Zone4D_EventScript_RocketGrunt_1 {
	trainerbattle_single(TRAINER_PBL_ROCKET_GRUNT_4D_1, format("We're {COLOR GREEN}Team Rainbow Rocket{COLOR DARK_GRAY}! You'd better stay out of our way!"), format("The R stands for both Rainbow and Rocket!"))
	msgbox(format("I may just be a grunt, but there are more of me to stop your way!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone4D_EventScript_RocketGrunt_2 {
	trainerbattle_single(TRAINER_PBL_ROCKET_GRUNT_4D_2, format("{COLOR GREEN}Team Rainbow Rocket{COLOR DARK_GRAY} exists for the good of all! Now hand over all your Pokémon!"), format("A Rainbow Rocket Grunt engages in all sorts of crime!"))
	msgbox(format("Crime is good, for the perpetrator! Haha!"), MSGBOX_AUTOCLOSE)
	end
}
