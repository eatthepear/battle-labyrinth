mapscripts Zone24A_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ZONE_24_STATE, 0: Zone24A_EventScript_Intro
	]
}

script Zone24A_EventScript_Intro {
	lockall
	setvar(VAR_ZONE_24_STATE, 1)
	goto(Zone24A_EventScript_LookDown)
}

script Zone24A_EventScript_LookDown {
	lockall
	special(SpawnCameraObject)
	applymovement(LOCALID_CAMERA, Zone24A_Movement_Camera_MoveCameraDown)
	waitmovement(0)
	delay(96)
	applymovement(LOCALID_CAMERA, Zone24A_Movement_Camera_MoveCameraUp)
	waitmovement(0)
	special(RemoveCameraObject)
	applymovement(LOCALID_PLAYER, Common_Movement_WalkUp)
	waitmovement(0)
	releaseall
	end
}

movement Zone24A_Movement_Camera_MoveCameraDown {
	walk_faster_down * 40
}

movement Zone24A_Movement_Camera_MoveCameraUp {
	walk_faster_up * 40
}

script Zone24A_EventScript_TriggerRocketAmbush {
	lockall
	msgbox(format("This is the Rocket ambush!"))
	setvar(VAR_ZONE_24_STATE, 2)
	releaseall
}


script Zone24A_EventScript_Douglas {
	trainerbattle_single(TRAINER_PBL_DOUGLAS, format("BATTLE!"), format("DEFEAT!"))
	msgbox(format("DEFEATED!"), MSGBOX_AUTOCLOSE)
	end
}

