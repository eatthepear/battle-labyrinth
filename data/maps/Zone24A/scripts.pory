mapscripts Zone24A_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_ZONE_24_STATE, 0: Zone24A_EventScript_Intro
	]
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE24A_RANDOM_1)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE24A_RANDOM_2)) {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE24A_RANDOM_3)) {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_2, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE24A_RANDOM_4)) {
			setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_3, OBJ_EVENT_GFX_ITEM_CHEST)
		}
		if (flag(FLAG_ITEM_ZONE24A_RANDOM_5)) {
			setvar(VAR_OBJ_GFX_ID_4, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_4, OBJ_EVENT_GFX_ITEM_CHEST)
		}
	}
}

script Zone24A_EventScript_Intro {
	lockall
	setvar(VAR_ZONE_24_STATE, 1)
	goto(Zone24A_EventScript_LookDown)
}

script Zone24A_EventScript_LookDown {
	lockall
	setvar(VAR_TEMP_0, 0)
	if (flag(FLAG_BEAT_BOSS_24) == FALSE) {
		removeobject(LOCALID_BLUE_24A)
		setflag(FLAG_BEAT_BOSS_24)
		setvar(VAR_TEMP_0, 1)
	}
	special(SpawnCameraObject)
	applymovement(LOCALID_CAMERA, Zone24A_Movement_Camera_MoveCameraDown)
	waitmovement(0)
	delay(96)
	applymovement(LOCALID_CAMERA, Zone24A_Movement_Camera_MoveCameraUp)
	waitmovement(0)
	special(RemoveCameraObject)
	if (var(VAR_TEMP_0) == 1) {
		clearflag(FLAG_BEAT_BOSS_24)
	}
	applymovement(LOCALID_PLAYER, Common_Movement_WalkUp)
	waitmovement(0)
	releaseall
	end
}

movement Zone24A_Movement_Camera_MoveCameraDown {
	walk_faster_down * 40
}

movement Zone24A_Movement_Camera_MoveCameraUp {
	walk_faster_up * 40
}

script Zone24A_EventScript_Blue {
	lock
	faceplayer
	setspeaker("Blue")
	msgbox(format("Bonjour! What kept you, {PLAYER}?\pHahaha! I thought you'd turn up if I waited here!\pHey, how about a battle to determine who's the stronger between us?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		setspeaker("Blue")
		msgbox(format("Are you scared? Hahaha!"))
		release
		end
	}
	msgbox(format("Let's see if you got any better since our last battle!"))
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_BLUE_BOSS_24, format("What!? I was just careless!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Blue")
	msgbox(format("That loosened me up. I'm ready to tackle this tower!\p{PLAYER}, you need more practice! But hey, you know that!\pHere, this will help you out!"))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_COVERT_CLOAK)
	setspeaker("Blue")
	msgbox(format("Well, {PLAYER}! I'm moving on up and ahead!\pBy checking my Pokédex, I'm starting to see what's strong and how they evolve! Am I a genius or what?\pAnyways, I'm out of here. Smell ya!"))
	closemessage
	applymovement(LOCALID_BLUE_24A, Zone24A_Movement_BlueWalkUp)
	waitmovement(0)
	removeobject(LOCALID_BLUE_24A)
	setflag(FLAG_BEAT_BOSS_24)
	release
	end
}

movement Zone24A_Movement_BlueWalkUp {
	face_up
	walk_up
	set_invisible
}

script Zone24A_EventScript_Douglas {
	trainerbattle_single(TRAINER_PBL_DOUGLAS, format("You can hear my music echo throughout this canyon!\pEcho! Echo! Echo!"), format("You can hear this sad song of defeat echo!"))
	msgbox(format("This song of mine, reverberating for all to hear… What a tragic story!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone24A_EventScript_Haywood {
	trainerbattle_single(TRAINER_PBL_HAYWOOD, format("There's a tower somewhere in this valley, and I'm determined to find it!"), format("You must be an ancient spirit from that tower!"))
	msgbox(format("I've heard the tower is beyond ancient, and thus is inhabitated by some fossil Pokémon!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone24A_EventScript_Spencer {
	trainerbattle_single(TRAINER_PBL_SPENCER, format("I will strike a blow for my brethren in the name of love!\pHiyaaa, love!"), format("Love will never be defeated! …Err, I'm out of Pokémon."))
	msgbox(format("In the dojo, we say that respect and love for yourself is key to success!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone24A_EventScript_Christi {
	trainerbattle_single(TRAINER_PBL_CHRISTI, format("Pokémon Trainer! Heed my call! Protect Pokémon and natural spaces!"), format("Your skill as a trainer is great!"))
	msgbox(format("We need more people like you to help protect Pokémon and natural spaces!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone24A_EventScript_David {
	trainerbattle_single(TRAINER_PBL_DAVID, format("These badlands are home to some unique Pokémon species.\pHave you see any interesting ones?"), format("All Pokémon are interesting, and all Pokémon deserve to be protected!"))
	msgbox(format("Protect Pokémon! Biodiversity is important!"), MSGBOX_AUTOCLOSE)
	end
}

script Zone24A_EventScript_SellLemonade {
	lock
	faceplayer
	if (var(VAR_DIFFICULTY) == DIFFICULTY_BRUTAL) {
		msgbox(format("Lemonade can quench the thirst, but today I'm out of stock, sorry!"))
		release
		end
	}
	message(format("Lemonade can quench the thirst, and is good for healing your Pokémon. Would you like some?"))
	waitmessage
	pokemart(Zone24A_Shop_Lemonade)
	msgbox(format("Lemonade is extra sweet. It'll top you right off!"))
	release
	end
}

mart Zone24A_Shop_Lemonade {
	ITEM_LEMONADE
}

script Zone24A_EventScript_Random1 {
	lock
	if (flag(FLAG_ITEM_ZONE24A_RANDOM_1)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ITEM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE24A_RANDOM_1)
	addobject(VAR_LAST_TALKED)
	specialvar(VAR_TEMP_1, RandomItemChest)
	finditem(VAR_TEMP_1, VAR_TEMP_0)
	release
	end
}

