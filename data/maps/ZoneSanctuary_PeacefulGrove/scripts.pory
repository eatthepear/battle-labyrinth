mapscripts ZoneSanctuary_PeacefulGrove_MapScripts {}

script ZoneSanctuary_PeacefulGrove_EventScript_Pokemaniac {
	lock
	faceplayer
	msgbox(format("You're telling me I can't grind items or money? What's the point then?\pI guess I could switch to {COLOR GREEN}Easy{COLOR DARK_GRAY} difficulty…"))
	release
}

script ZoneSanctuary_EventScript_PeacefulGrove_BirdKeeperFlyingTaxi {
    lock
    faceplayer
	if ((checkitem(ITEM_HM_FLASH) == FALSE) || (flag(FLAG_BADGE03_GET) == FALSE)) {
		msgbox(format("Flying Taxi at your service! Express flight to Rainy Bog!\pThough you need {COLOR GREEN}HM05 - Flash{COLOR DARK_GRAY} and the corresponding Gym Badge to be allowed to ride this one.\pIt looks like you're missing one of those, so please come back!"))
		release
		end
	}
    msgbox(format("Flying Taxi at your service! Express flight to Rainy Bog! All aboard?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("Alrighty, we'll be here, awaiting our next passenger!"))
        release
        end
    }
    applymovement(LOCALID_BIRD_KEEPER_PEACEFUL_GROVE, Common_Movement_FaceRight)
    waitmovement(0)
    msgbox(format("Rufflet! Use Fly!"))
	setspeaker("Rufflet")
	playmoncry(SPECIES_RUFFLET, CRY_MODE_NORMAL)
	msgbox(format("Flet!"))
    warp(MAP_RAINY_BOG, 255, 10, 33)
    waitstate
    end
}

script EventScript_Rufflet {
	lock
	faceplayer
	setspeaker("Rufflet")
	playmoncry(SPECIES_RUFFLET, CRY_MODE_NORMAL)
	msgbox(format("Flet!"))
	waitmoncry
	release
	end
}
