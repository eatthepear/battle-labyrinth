mapscripts Zone9E_MapScripts {}

script Zone9E_EventScript_Jackie {
	lock
	faceplayer
	if (defeated(TRAINER_PBL_JACKIE_OPTIONAL_9)) {
		call(Zone9E_EventScript_Jackie_End)
	}
	setspeaker("Jackie")
	msgbox(format("My darling Pokémon are roaring for a battle!\pThey may not be strong, but they're fully evolved!\pIf you battle me, I'll give you a {COLOR GREEN}Scope Lens{COLOR DARK_GRAY}!"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		msgbox(format("That's rather disappointing."))
		release
		end
	}
	msgbox(format("Excellent! Go, my darling Pokémon!"))
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_JACKIE_OPTIONAL_9, format("My darling Pokémon!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Jackie")
	msgbox(format("Oh, my darling Pokémon, rest up!\pAnd for you, dear trainer, your reward."))
	setspeaker("Jackie")
	bufferspeciesname(0, SPECIES_TYROGUE)
	msgbox("Here's your {STR_VAR_1}.")
	setspeaker(SP_NAME_NONE)
	playfanfare(MUS_OBTAIN_ITEM)
	message(format("{PLAYER} received the {STR_VAR_1}!"))
	waitmessage
	waitfanfare
	specialvar(VAR_TEMP_2, CalculatePlayerPartyCount)
	if (var(VAR_TEMP_2) == PARTY_SIZE) {
		msgbox(format("Your party is full. Would you like to send a party Pokémon to the PC and add {STR_VAR_1} to your party?"), MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			call(EventScript_ChoosePartyMonToSend)
		}
	}
	givemon(SPECIES_TYROGUE, 15, metLocation=METLOC_ZONE9E_GIFT)
	if (var(VAR_RESULT) == MON_GIVEN_TO_PARTY) {
		bufferspeciesname(0, SPECIES_TYROGUE)
		msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			call(Common_EventScript_GetGiftMonPartySlot)
			call(Common_EventScript_NameReceivedPartyMon)
		}
	} else {
		bufferspeciesname(0, SPECIES_TYROGUE)
		setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_TYROGUE)
		msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			call(Common_EventScript_NameReceivedBoxMon)
		}
		call(Common_EventScript_TransferredToPC)
	}
	call(Zone9E_EventScript_Jackie_End)
}

script Zone9E_EventScript_Jackie_End {
	setspeaker("Jackie")
	msgbox(format("My darling Pokémon are my favorites!"))
	release
	end
}

script Zone9E_EventScript_BlackBelt {
	lock
	faceplayer
	if (flag(FLAG_ZONE9E_RECEIVED_PUNCHING_GLOVE) == false) {
		msgbox(format("PUNCH WITH ALL YOUR POWER!"), MSGBOX_DEFAULT)
		giveitem(ITEM_PUNCHING_GLOVE)
		setflag(FLAG_ZONE9E_RECEIVED_PUNCHING_GLOVE)
	}
	msgbox(format("PUNCH WITH ALL YOUR POWER!"))
	release
	end
}
