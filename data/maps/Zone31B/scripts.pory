mapscripts Zone31B_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE31B_TM_EARTHQUAKE)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST)
		}
	}
}

script Zone31B_EventScript_Grotto {
	lock
	call(EventScript_FoundGrotto)
	warp(MAP_HIDDEN_GROTTO_ZONE31B, 0)
	waitstate
	release
	end
}

script Zone31B_EventScript_Blue {
	lock
	faceplayer
	playbgm(MUS_BW_FRIEND, TRUE)
	setspeaker("Blue")
	msgbox(format("Hi! My name's {COLOR BLUE}Blue{COLOR DARK_GRAY}.\pIf you want to go forward, you'll have to beat me!\pSo, are you ready for our battle?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
	    setspeaker("Blue")
		msgbox(format("Okay. You just let me know when you're ready!"))
		closemessage
		fadedefaultbgm
		release
		end
	}
    setspeaker("Blue")
	msgbox(format("Good luck!"))
	call(EventScript_HealPreBoss)
	setflag(FLAG_FORCE_BATTLE_ANIM_ON)
	trainerbattle_no_intro(TRAINER_PBL_BLUE_BOSS_31, format("Defeat!"))
	clearflag(FLAG_FORCE_BATTLE_ANIM_ON)
	setspeaker("Blue")
	msgbox(format("I thought if I had a variety of types, I would be able to win.\pI guess there's more to battling than just having different Pokémon!\pAs a reward for beating me, take this TM!\pIt's useful for catching new Pokémon."))
	setspeaker(SP_NAME_NONE)
	giveitem(ITEM_HM_ROCK_SMASH)
	setspeaker("Blue")
	msgbox(format("Good job! That was a great battle. I think I'll wait here for more challengers to pass through, you should go on ahead! I want to battle them all."))
	closemessage
	fadescreenswapbuffers(FADE_TO_BLACK)
	removeobject(LOCALID_BLUE_31B)
	setflag(FLAG_BEAT_BOSS_31)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	fadedefaultbgm
	releaseall
	end
}

script Zone31B_EventScript_TMEarthquake {
	lock
	if (flag(FLAG_ITEM_ZONE31B_TM_EARTHQUAKE)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE31B_TM_EARTHQUAKE)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_TM_EARTHQUAKE, 1)
	release
	end
}
