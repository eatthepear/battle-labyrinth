mapscripts Zone24B_MapScripts {
	MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_ITEM_ZONE24B_TM_FLASH_CANNON)) {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
		} else {
			setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST)
		}
	}
}

script Zone24B_EventScript_TMFlashCannon {
	lock
	if (flag(FLAG_ITEM_ZONE24B_TM_FLASH_CANNON)) {
		msgbox(gText_ItemChestIsEmpty)
		release
		end
	}
	waitse
	removeobject(VAR_LAST_TALKED)
	setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_TM_CHEST_OPEN)
	setflag(FLAG_ITEM_ZONE24B_TM_FLASH_CANNON)
	addobject(VAR_LAST_TALKED)
	finditem(ITEM_TM_FLASH_CANNON)
	release
	end
}
