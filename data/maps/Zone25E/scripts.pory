mapscripts Zone25E_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_ICE_STEP_COUNT, 0: EventScript_FallDownHole
	]
    MAP_SCRIPT_ON_TRANSITION {
		call(CaveHole_FixCrackedGround)
    }
	MAP_SCRIPT_ON_RESUME {
        setstepcallback(STEP_CB_CRACKED_FLOOR)
	    setholewarp(MAP_ZONE25F)
	}
}

raw `
Zone25E_EventScript_FullHeal::
	finditem ITEM_FULL_HEAL
	end
`

script Zone25E_EventScript_RocketGrunt_1 {
	trainerbattle_single(TRAINER_PBL_ROCKET_GRUNT_25E_1, format("BATTLE!"), format("DEFEAT!"))
	msgbox(format("DEFEATED!"), MSGBOX_AUTOCLOSE)
	end
}
